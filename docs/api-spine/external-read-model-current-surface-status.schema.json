{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/api-spine/external-read-model-current-surface-status.v1.json",
  "title": "EMR4 external read-model current surface status",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "date",
    "historical_inventory",
    "current_status_authority",
    "surfaces",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "api_spine.external_read_model_current_surface_status.v1"
    },
    "date": { "type": "string", "format": "date" },
    "historical_inventory": { "type": "string", "minLength": 1 },
    "current_status_authority": { "type": "string", "minLength": 1 },
    "surfaces": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": { "$ref": "#/$defs/surface" }
    },
    "claim_boundary": { "type": "string", "minLength": 1 }
  },
  "$defs": {
    "surfaceState": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "mounted", "evidence"],
      "properties": {
        "status": {
          "enum": ["implemented", "reserved_contract_only", "absent"]
        },
        "mounted": { "type": "boolean" },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "surface": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "surface",
        "authority_kind",
        "implementation_status",
        "rest",
        "graphql",
        "deployment_ready",
        "production_ready",
        "supersedes"
      ],
      "properties": {
        "surface": { "type": "string", "minLength": 1 },
        "authority_kind": { "const": "read_only" },
        "implementation_status": {
          "enum": [
            "implemented_mounted",
            "route_and_shape_gap",
            "source_and_licensing_gap"
          ]
        },
        "rest": { "$ref": "#/$defs/surfaceState" },
        "graphql": { "$ref": "#/$defs/surfaceState" },
        "deployment_ready": { "const": false },
        "production_ready": { "const": false },
        "supersedes": {
          "type": "object",
          "additionalProperties": false,
          "required": ["historical_posture", "current_posture", "evidence"],
          "properties": {
            "historical_posture": { "type": "string", "minLength": 1 },
            "current_posture": { "type": "string", "minLength": 1 },
            "evidence": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}
