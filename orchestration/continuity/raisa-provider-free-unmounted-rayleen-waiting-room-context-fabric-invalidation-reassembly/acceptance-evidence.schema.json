    "claim_boundary": {
      "const": "Provider-free authored-synthetic unmounted adapter-to-temporal invalidation and inert reassembly-handoff evidence only; no real data, live watcher, source read, persistence, provider, runtime, command, deployment or production claim."
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
