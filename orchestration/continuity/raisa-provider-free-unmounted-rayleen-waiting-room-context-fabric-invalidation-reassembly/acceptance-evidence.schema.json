    "case_count",
    "passed_case_count",
    "adapter_result_digest",
    "adapter_binding_digest",
    "adapted_parent_frame_set_digest",
    "adapted_parent_proofreader_trace_digest",
    "manifest_digest",
    "lease_digest",
    "signal_digest",
    "decision_digest",
    "checkpoint_digest",
    "state_digest",
    "requirement_digest",
    "instruction_digest",
    "stale_reassembly_decision_digest",
    "temporal_trace_digest",
