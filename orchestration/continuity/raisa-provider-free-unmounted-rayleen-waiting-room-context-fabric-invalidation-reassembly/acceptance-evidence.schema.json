    "case_count": {"type": "integer", "minimum": 20},
    "passed_case_count": {"type": "integer", "minimum": 20},
    "adapter_result_digest": {"$ref": "#/$defs/digest"},
    "adapter_binding_digest": {"$ref": "#/$defs/digest"},
    "adapted_parent_frame_set_digest": {"$ref": "#/$defs/digest"},
    "adapted_parent_proofreader_trace_digest": {"$ref": "#/$defs/digest"},
    "manifest_digest": {"$ref": "#/$defs/digest"},
    "lease_digest": {"$ref": "#/$defs/digest"},
    "signal_digest": {"$ref": "#/$defs/digest"},
    "decision_digest": {"$ref": "#/$defs/digest"},
    "checkpoint_digest": {"$ref": "#/$defs/digest"},
    "state_digest": {"$ref": "#/$defs/digest"},
    "requirement_digest": {"$ref": "#/$defs/digest"},
    "instruction_digest": {"$ref": "#/$defs/digest"},
    "stale_reassembly_decision_digest": {"$ref": "#/$defs/digest"},
    "temporal_trace_digest": {"$ref": "#/$defs/digest"},
    "seam_proofreader_trace_digest": {"$ref": "#/$defs/digest"},
    "seam_proofreader_decision": {"const": "RELEASE"},
    "positive_invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "parent_current_proofreader_released",
        "adapter_source_frame_dependency_chain_exact",
        "signal_payload_free",
        "old_frame_set_byte_immutable",
        "old_frame_set_retired",
        "exactly_one_requirement",
        "waiting_dependency_required",
        "instruction_inert",
        "stale_request_rejected"
      ],
      "properties": {
        "parent_current_proofreader_released": {"const": true},
        "adapter_source_frame_dependency_chain_exact": {"const": true},
        "signal_payload_free": {"const": true},
        "old_frame_set_byte_immutable": {"const": true},
        "old_frame_set_retired": {"const": true},
        "exactly_one_requirement": {"const": true},
        "waiting_dependency_required": {"const": true},
        "instruction_inert": {"const": true},
        "stale_request_rejected": {"const": true}
      }
    },
    "negative_reason_codes": {
      "type": "array",
      "minItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "zero_action_posture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider_calls",
        "network_calls",
        "database_calls",
        "product_api_calls",
        "source_reads",
        "commands_or_writes",
        "watcher_or_event_subscriptions",
        "deployments_or_releases",
        "protected_actions"
