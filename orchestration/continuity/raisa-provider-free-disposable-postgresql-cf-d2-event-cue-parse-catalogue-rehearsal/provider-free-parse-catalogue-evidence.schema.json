{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.dev/schemas/raisa-cf-d2-event-cue-parse-catalogue-evidence.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "evidence_label",
    "planning_baseline",
    "accepted_inert_ddl_source",
    "contract_sha256",
    "source_hashes",
    "hostile_mutations_rejected",
    "environment",
    "artifact",
    "catalogue",
    "row_counts",
    "lifecycle",
    "cleanup",
    "effects",
    "failure",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "raisa.context_fabric.cf_d2_event_cue_parse_catalogue_evidence.v1"},
    "result": {"enum": ["raisa_provider_free_disposable_postgresql_cf_d2_event_cue_parse_catalogue_pass", "rehearsal_failed"]},
    "evidence_label": {"const": "authored_synthetic_provider_free_disposable_postgresql_16_parse_catalogue"},
    "planning_baseline": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "accepted_inert_ddl_source": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_hashes": {"type": "object", "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}},
    "hostile_mutations_rejected": {"type": "integer", "minimum": 64},
    "environment": {"type": "object"},
    "artifact": {"type": "object"},
    "catalogue": {"type": "object"},
    "row_counts": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "lifecycle": {"type": "array", "items": {"type": "string"}},
    "cleanup": {"type": "object", "required": ["status"], "properties": {"status": {"type": "string"}}, "additionalProperties": true},
    "effects": {"type": "object"},
    "failure": {"type": ["object", "null"]},
    "claim_boundary": {"type": "string", "minLength": 40}
  }
}
