{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.example/schemas/native-harness-rebound-stock-headless-hmr-boot-contract.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_id", "planning_source", "accepted_sources",
    "predecessor_bytes", "implementation_bytes", "execution_attempt", "bundle_identity", "source_bindings",
    "target_binding", "package", "required_installed_packages", "materialisation", "launch", "readiness",
    "expected_terminal", "required_zero_counts"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.native_harness_rebound_stock_headless_hmr_boot_contract.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-rebound-future-runner-stock-headless-hmr-boot-proof"},
    "planning_source": {"$ref": "#/$defs/oid"},
    "accepted_sources": {"$ref": "#/$defs/oidMap"},
    "predecessor_bytes": {"$ref": "#/$defs/digestMap"},
    "implementation_bytes": {"$ref": "#/$defs/digestMap"},
    "execution_attempt": {
      "type": "object", "additionalProperties": false,
      "required": ["attempt_id", "native_process_count", "automatic_retry", "manual_retry", "resume"],
      "properties": {
        "attempt_id": {"const": "rebound-stock-headless-hmr-boot-attempt-001"},
        "native_process_count": {"const": 1},
        "automatic_retry": {"const": false},
        "manual_retry": {"const": false},
        "resume": {"const": false}
      }
    },
    "bundle_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_id", "attempt_id", "candidate_source"],
      "properties": {
        "operation_id": {"type": "string", "minLength": 1},
        "attempt_id": {"type": "string", "minLength": 1},
        "candidate_source": {"$ref": "#/$defs/oid"}
      }
    },
    "source_bindings": {"$ref": "#/$defs/digestMap"},
    "target_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["classification", "relative_path", "coordinate_sha256", "occupied_target_use_authorized"],
      "properties": {
        "classification": {"const": "inert_authored_synthetic_relative_python_fixture"},
        "relative_path": {"const": "workspace/authored_synthetic_control_probe.py"},
        "coordinate_sha256": {"$ref": "#/$defs/digest"},
        "occupied_target_use_authorized": {"const": false}
      }
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "version", "bin", "tarball_sha1", "tarball_integrity", "tarball_sha256"],
      "properties": {
        "name": {"const": "@deepseek-ai/dsh"},
        "version": {"const": "0.1.0-rc.7"},
        "bin": {"const": "lib/bin.js"},
        "tarball_sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "tarball_integrity": {"type": "string", "minLength": 1},
        "tarball_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "required_installed_packages": {"type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "materialisation": {
      "type": "object", "additionalProperties": false,
      "required": ["generation", "process_count", "retry_count", "direct_node_npm_cli", "timeout_seconds", "node_executable_sha256", "npm_cli_sha256"],
      "properties": {
        "generation": {"const": 2},
        "process_count": {"const": 1},
        "retry_count": {"const": 0},
        "direct_node_npm_cli": {"const": true},
        "timeout_seconds": {"type": "integer", "minimum": 300, "maximum": 900},
        "node_executable_sha256": {"$ref": "#/$defs/digest"},
        "npm_cli_sha256": {"$ref": "#/$defs/digest"}
      }
    },
    "launch": {
      "type": "object", "additionalProperties": false,
      "required": ["node_flag", "profile_args", "online_package_fallback", "package_lifecycle_scripts", "timeout_seconds"],
      "properties": {
        "node_flag": {"const": "--expose-internals"},
        "profile_args": {"const": ["--profile", "headless"]},
        "online_package_fallback": {"const": false},
        "package_lifecycle_scripts": {"const": false},
        "timeout_seconds": {"type": "integer", "minimum": 10, "maximum": 60}
      }
    },
    "readiness": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "writer", "events"],
      "properties": {
        "schema_version": {"const": "ariadne.deepseek_native_harness_effective_tool_native_boot_event.v1"},
        "writer": {"const": "provider-free-effective-tool-hmr-sentinel"},
        "events": {"const": ["sentinel_activated", "stock_headless_hmr_ready"]}
      }
    },
    "expected_terminal": {
      "type": "object", "additionalProperties": false,
      "required": ["coordinate", "diagnostic_accepted", "broker_zero", "pre_request_supported", "stage", "cause_coordinate", "error_kind"],
      "properties": {
        "coordinate": {"const": "post_hmr_pre_request_failure"},
        "diagnostic_accepted": {"const": true},
        "broker_zero": {"const": true},
        "pre_request_supported": {"const": true},
        "stage": {"const": "preset_root_roster_admission"},
        "cause_coordinate": {"const": "preset_root_roster_mismatch"},
        "error_kind": {"const": "error"}
      }
    },
    "required_zero_counts": {"type": "array", "minItems": 13, "maxItems": 13, "uniqueItems": true, "items": {"type": "string"}}
  },
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "digestMap": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/digest"}},
    "oidMap": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/oid"}}
  }
}
