{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/deepseek-native-harness-required-service-injection-recovery-evidence.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "planning_source",
    "result",
    "root_cause",
    "package_checks",
    "source_semantics",
    "future_declaration",
    "immutable_attempts",
    "provider_boundary",
    "claim_boundary"
