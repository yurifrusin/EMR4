{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/deepseek-native-harness-required-service-injection-recovery-contract.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "planning_source",
    "accepted_failed_source",
    "root_cause",
    "packages",
    "future_declaration",
    "immutable_attempts",
    "implementation_bytes",
    "required_zero_counts"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.deepseek_native_harness_required_service_injection_recovery_contract.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-required-service-injection-recovery"},
    "planning_source": {"pattern": "^[0-9a-f]{40}$"},
    "accepted_failed_source": {"pattern": "^[0-9a-f]{40}$"},
    "root_cause": {"const": "headless_agent_presets_row_absent_and_runner_dependencies_underdeclared"},
    "packages": {"type": "array", "minItems": 8, "maxItems": 8},
    "future_declaration": {"type": "object"},
    "immutable_attempts": {"type": "array", "minItems": 2, "maxItems": 2},
    "implementation_bytes": {"type": "object"},
    "required_zero_counts": {"type": "array", "minItems": 11, "maxItems": 11, "uniqueItems": true}
  }
}
