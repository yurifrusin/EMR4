{
  "schema_version": "ariadne.governance_command_manifest.v1",
  "commands": [
    {
      "command_id": "profile-call-site-repair-transition-focused-tests",
      "executable": ".venv/Scripts/python.exe",
      "arguments": [
        "-m",
        "pytest",
        "-q",
        "tests/test_ariadne_governance_clockwork_tick.py",
        "tests/test_ariadne_active_operation_latch.py",
        "tests/test_ariadne_orchestrator_preflight.py",
        "tests/test_current_baton_consistency.py"
      ],
      "completion_contract": "final_exit_code_zero_required"
    },
    {
      "command_id": "profile-call-site-repair-transition-ruff",
      "executable": ".venv/Scripts/python.exe",
      "arguments": [
        "-m",
        "ruff",
        "check",
        "orchestration_harness/governance_clockwork_tick.py",
        "scripts/ariadne_governance_clockwork_tick.py",
        "tests/test_ariadne_governance_clockwork_tick.py",
        "tests/test_current_baton_consistency.py"
      ],
      "completion_contract": "final_exit_code_zero_required"
    },
    {
      "command_id": "profile-call-site-repair-transition-compile",
      "executable": ".venv/Scripts/python.exe",
      "arguments": [
        "-m",
        "py_compile",
        "orchestration_harness/governance_clockwork_tick.py",
        "scripts/ariadne_governance_clockwork_tick.py"
      ],
      "completion_contract": "final_exit_code_zero_required"
    }
  ]
}
