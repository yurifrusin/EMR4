{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emr4:raisa:check-in-relay-free-recovery-attempt-007:execution-envelope:v1",
  "title": "Check-in relay-free recovery attempt 007 execution envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result", "attempt_id", "source_head", "plan_source",
    "attempt_006_execution_source", "attempt_006_closeout_source",
    "start_option_repair_implementation_source",
    "start_option_repair_reviewed_source", "start_option_repair_closeout_source",
    "protected_source", "repaired_harness_sha256", "contract_sha256",
    "transaction_attestation_schema_sha256", "attempt_006_failure_sha256",
    "attempt_006_envelope_sha256", "start_option_repair_attestation_sha256",
    "start_option_repair_contract_sha256", "start_option_repair_report_sha256",
    "occupied_execution_count", "automatic_retry_count",
    "ambiguous_success_released", "ordinary_admission_release_count",
    "product_record_count", "terminal_artifact_kind",
    "terminal_artifact_sha256", "transaction_attestation_sha256",
    "base_result", "cleanup_status", "terminal_binding_restored"
  ],
  "properties": {
    "schema_version": {"const": "emr4.check-in-relay-free-recovery-attempt-007.execution-envelope.v1"},
    "result": {"enum": ["raisa_provider_free_check_in_relay_free_recovery_attempt_007_pass", "failed_closed"]},
    "attempt_id": {"const": "attempt-007"},
    "source_head": {"$ref": "#/$defs/git_commit"},
    "plan_source": {"$ref": "#/$defs/git_commit"},
    "attempt_006_execution_source": {"$ref": "#/$defs/git_commit"},
    "attempt_006_closeout_source": {"$ref": "#/$defs/git_commit"},
    "start_option_repair_implementation_source": {"$ref": "#/$defs/git_commit"},
    "start_option_repair_reviewed_source": {"$ref": "#/$defs/git_commit"},
    "start_option_repair_closeout_source": {"$ref": "#/$defs/git_commit"},
    "protected_source": {"$ref": "#/$defs/git_commit"},
    "repaired_harness_sha256": {"$ref": "#/$defs/sha256"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "transaction_attestation_schema_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_006_failure_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_006_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "start_option_repair_attestation_sha256": {"$ref": "#/$defs/sha256"},
    "start_option_repair_contract_sha256": {"$ref": "#/$defs/sha256"},
    "start_option_repair_report_sha256": {"$ref": "#/$defs/sha256"},
    "occupied_execution_count": {"const": 1},
    "automatic_retry_count": {"const": 0},
    "ambiguous_success_released": {"const": false},
    "ordinary_admission_release_count": {"const": 0},
    "product_record_count": {"const": 0},
    "terminal_artifact_kind": {"enum": ["rehearsal_evidence", "rehearsal_failure_evidence"]},
    "terminal_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "transaction_attestation_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "base_result": {"enum": ["raisa_provider_free_disposable_postgresql_default_off_check_in_relay_free_rollback_unknown_commit_recovery_rehearsal_pass", "failed_closed"]},
    "cleanup_status": {"enum": ["cleanup_verified", "cleanup_incomplete", "not_started"]},
    "terminal_binding_restored": {"const": true}
  },
  "$defs": {
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
