{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/ariadne-active-operation-latch-v1.json",
  "title": "Ariadne active operation latch v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "active_tranche",
    "objective",
    "status",
    "source_head",
    "authority_source",
    "checkpoint",
    "interruption_policy",
    "resume_after_compaction",
    "user_attention",
    "terminal_response",
    "protected_boundaries"
  ],
  "properties": {
    "schema_version": {
      "const": "ariadne.active_operation_latch.v1"
    },
    "operation_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "active_tranche": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "objective": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "status": {
      "enum": ["in_progress", "complete", "blocked", "paused", "replaced"]
    },
    "source_head": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authority_source": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "checkpoint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "completed_stage",
        "next_executable_stage",
        "retry_counters",
        "settings_fingerprint"
      ],
      "properties": {
        "completed_stage": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "next_executable_stage": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 500
        },
        "retry_counters": {
          "type": "object",
          "maxProperties": 32,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9._-]{0,127}$"
          },
          "additionalProperties": {
            "type": "integer",
            "minimum": 0
          }
        },
        "settings_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      }
    },
    "interruption_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "chronological_last_prompt_is_controlling_authority",
        "side_question_behavior",
        "status_request_behavior",
        "scope_addition_behavior",
        "replacement_requires_explicit_pause_or_redirect"
      ],
      "properties": {
        "chronological_last_prompt_is_controlling_authority": {
          "const": false
        },
        "side_question_behavior": {
          "const": "answer_then_resume"
        },
        "status_request_behavior": {
          "const": "answer_then_resume"
        },
        "scope_addition_behavior": {
          "const": "merge_then_resume"
        },
        "replacement_requires_explicit_pause_or_redirect": {
          "const": true
        }
      }
    },
    "resume_after_compaction": {
      "type": "boolean"
    },
    "user_attention": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required", "reason"],
      "properties": {
        "required": {
          "type": "boolean"
        },
        "reason": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "terminal_response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["permitted", "reason"],
      "properties": {
        "permitted": {
          "type": "boolean"
        },
        "reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        }
      }
    },
    "protected_boundaries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200
      }
    }
  }
}
