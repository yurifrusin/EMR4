    "refresh_trace_digest": {"$ref": "#/$defs/digest"},
    "carry_forward_trace_digest": {"$ref": "#/$defs/digest"},
    "adapter_result_digest": {"$ref": "#/$defs/digest"},
    "new_frame_set_digest": {"$ref": "#/$defs/digest"},
    "new_source_trace_digest": {"$ref": "#/$defs/digest"},
    "new_current_proofreader_trace_digest": {"$ref": "#/$defs/digest"},
    "new_manifest_digest": {"$ref": "#/$defs/digest"},
    "new_lease_digest": {"$ref": "#/$defs/digest"},
