        "product_api_calls": {"const": 0},
        "source_reads": {"const": 0},
        "commands_or_writes": {"const": 0},
        "watcher_or_event_subscriptions": {"const": 0},
        "deployments_or_releases": {"const": 0},
        "protected_actions": {"const": 0}
