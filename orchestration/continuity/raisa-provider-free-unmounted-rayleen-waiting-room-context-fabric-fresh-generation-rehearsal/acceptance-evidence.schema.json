        "adapter_extractor_chain_exact",
        "unaffected_carry_forward_exact",
        "current_proofreader_released",
        "new_frame_set_distinct",
        "new_temporal_objects_rederived",
        "new_generation_admitted",
        "older_result_rejected",
        "both_orders_converge",
        "old_generation_immutable_and_retired"
      ],
      "properties": {
        "predecessor_reconstructed": {"const": true},
        "predecessor_requirement_and_instruction_current": {"const": true},
        "requirement_refresh_coverage_exact": {"const": true},
        "event_metadata_not_used_as_truth": {"const": true},
        "authority_no_wider": {"const": true},
        "diary_and_waiting_sources_new": {"const": true},
        "adapter_extractor_chain_exact": {"const": true},
        "unaffected_carry_forward_exact": {"const": true},
        "current_proofreader_released": {"const": true},
        "new_frame_set_distinct": {"const": true},
        "new_temporal_objects_rederived": {"const": true},
        "new_generation_admitted": {"const": true},
        "older_result_rejected": {"const": true},
        "both_orders_converge": {"const": true},
        "old_generation_immutable_and_retired": {"const": true}
