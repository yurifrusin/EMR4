{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.example/orchestration/deepseek-native-harness-effective-tool-guard-contract.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "planning_source",
    "packages",
    "profile",
    "semantic_checks",
    "guard",
    "required_zero_counts"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.deepseek_native_harness_effective_tool_guard_contract.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-effective-tool-composition-and-terminal-coordinate-guard"},
    "planning_source": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "packages": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/package"}
    },
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "selected_profile", "selected_tools"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "selected_profile": {"const": "emr4-bounded-worker"},
        "selected_tools": {"const": ["edit", "glob", "read"]}
      }
    },
    "semantic_checks": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}
    },
    "guard": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "preset_id",
        "selected_tools",
        "success_coordinate",
        "failure_coordinates",
        "safe_tool_name_pattern",
        "forbidden_terminal_coordinate",
        "restriction_call_count",
        "provider_dispatch_count"
      ],
      "properties": {
        "preset_id": {"const": "emr4-bounded-worker"},
        "selected_tools": {"const": ["edit", "glob", "read"]},
        "success_coordinate": {"const": "EFFECTIVE_TOOL_COMPOSITION_PASSED"},
        "failure_coordinates": {
          "type": "array",
          "minItems": 9,
          "maxItems": 9,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^EFFECTIVE_TOOL_COMPOSITION_[A-Z_]+$"}
        },
        "safe_tool_name_pattern": {"const": "^[a-z_]+$"},
        "forbidden_terminal_coordinate": {"const": "CUSTOM_RUNNER_FAILURE"},
        "restriction_call_count": {"const": 1},
        "provider_dispatch_count": {"const": 0}
      }
    },
    "required_zero_counts": {
      "type": "array",
      "minItems": 10,
      "maxItems": 10,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z_]+$"}
    }
  },
  "$defs": {
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "registry_shasum", "registry_integrity", "members"],
      "properties": {
        "name": {"type": "string", "pattern": "^@deepseek-ai/dsh"},
        "version": {"const": "0.1.0-rc.7"},
        "registry_shasum": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "registry_integrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"},
        "members": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": {"type": "string", "minLength": 1},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
