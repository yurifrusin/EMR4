{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://emr4.local/schemas/technical-diagnosis-candidate.v1.json","type":"object","additionalProperties":false,
  "required":["schema_version","candidate_id","anatomy_frame_id","anatomy_version","context_sha256","candidate_integrity","hypotheses","missing_evidence","likely_impact","urgency","candidate_runbook_id","operator_explanation","authority_ceiling"],
  "properties":{
    "schema_version":{"const":"emr4.technical_diagnosis_candidate.v1"},"candidate_id":{"type":"string","format":"uuid"},"anatomy_frame_id":{"type":"string","format":"uuid"},"anatomy_version":{"type":"string","pattern":"^[a-z0-9.-]+$"},"context_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"candidate_integrity":{"const":"untrusted_model_fixture"},
    "hypotheses":{"type":"array","minItems":1,"maxItems":5,"items":{"type":"object","additionalProperties":false,"required":["hypothesis_id","statement","evidence_links","support_state"],"properties":{"hypothesis_id":{"type":"string","pattern":"^[a-z0-9.-]+$"},"statement":{"type":"string","minLength":3,"maxLength":240},"evidence_links":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string","pattern":"^[a-z0-9.-]+$"}},"support_state":{"enum":["supported","partially_supported"]}}}},
    "missing_evidence":{"type":"array","maxItems":8,"items":{"type":"string","minLength":3,"maxLength":160}},"likely_impact":{"enum":["none_known","degraded_service","availability_loss","integrity_risk","recovery_unknown"]},"urgency":{"enum":["observe","soon","urgent","critical"]},"candidate_runbook_id":{"type":["string","null"],"pattern":"^[a-z0-9.-]+$"},"operator_explanation":{"type":"string","minLength":3,"maxLength":500},"authority_ceiling":{"const":"diagnosis_candidate"}
  }
}
