{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"https://emr4.local/schemas/update-provenance-delta.v1.json","type":"object","additionalProperties":false,
  "required":["schema_version","update_class","future_command_family","source","semantic_delta","compatibility_decision","rollback_candidate","activation_authorized"],
  "properties":{
    "schema_version":{"const":"emr4.update_provenance_delta.v1"},"update_class":{"enum":["application_dependency_build","database_schema_migration","reference_dataset","operational_clinical_policy"]},"future_command_family":{"enum":["application_build_promotion","database_migration_promotion","reference_dataset_activation","policy_content_activation"]},
    "source":{"type":"object","additionalProperties":false,"required":["source_identity","licence_id","content_sha256","schema_version","jurisdiction","issued_at","effective_at","expires_at","supersedes_id","withdrawal_state"],"properties":{"source_identity":{"type":"string","pattern":"^synthetic:[a-z0-9.-]+$"},"licence_id":{"type":"string","pattern":"^synthetic-[a-z0-9.-]+$"},"content_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"schema_version":{"type":"string"},"jurisdiction":{"const":"AU-SYNTHETIC"},"issued_at":{"type":"string","format":"date-time"},"effective_at":{"type":"string","format":"date-time"},"expires_at":{"type":["string","null"],"format":"date-time"},"supersedes_id":{"type":["string","null"]},"withdrawal_state":{"enum":["active","withdrawn","superseded"]}}},
    "semantic_delta":{"type":"array","minItems":1,"maxItems":32,"items":{"type":"object","additionalProperties":false,"required":["path","change_kind","before_sha256","after_sha256"],"properties":{"path":{"type":"string","pattern":"^[a-z0-9_.-]+$"},"change_kind":{"enum":["add","change","remove"]},"before_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"},"after_sha256":{"type":["string","null"],"pattern":"^[a-f0-9]{64}$"}}}},
    "compatibility_decision":{"enum":["compatible","incompatible","review_required"]},"rollback_candidate":{"type":"object","additionalProperties":false,"required":["kind","target_sha256"],"properties":{"kind":{"enum":["restore_previous_artifact","down_migration_candidate","restore_previous_dataset","restore_previous_policy"]},"target_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}},"activation_authorized":{"const":false}
  },
  "allOf":[
    {"if":{"properties":{"update_class":{"const":"application_dependency_build"}}},"then":{"properties":{"future_command_family":{"const":"application_build_promotion"}}}},
    {"if":{"properties":{"update_class":{"const":"database_schema_migration"}}},"then":{"properties":{"future_command_family":{"const":"database_migration_promotion"}}}},
    {"if":{"properties":{"update_class":{"const":"reference_dataset"}}},"then":{"properties":{"future_command_family":{"const":"reference_dataset_activation"}}}},
    {"if":{"properties":{"update_class":{"const":"operational_clinical_policy"}}},"then":{"properties":{"future_command_family":{"const":"policy_content_activation"}}}}
  ]
}
