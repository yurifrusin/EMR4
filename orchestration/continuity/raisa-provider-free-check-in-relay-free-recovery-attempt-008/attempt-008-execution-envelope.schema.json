{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:emr4:raisa:check-in-relay-free-recovery-attempt-008:execution-envelope:v1",
  "title": "Check-in relay-free recovery attempt 008 execution envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result", "attempt_id", "source_head", "plan_source",
    "attempt_007_terminal_source", "diagnosis_closeout_source",
    "repair_implementation_source", "repair_closeout_source",
    "verification_closeout_source", "plan_admissibility_source",
    "protected_source", "repaired_base_harness_sha256",
    "base_contract_sha256", "transaction_attestation_schema_sha256",
    "attempt_007_failure_sha256", "attempt_007_envelope_sha256",
    "repair_contract_sha256", "repair_evidence_sha256",
    "verification_envelope_evidence_sha256",
    "plan_admissibility_evidence_sha256", "hard_condition_ids",
    "prospective_projection_path_count",
    "prospective_projection_hostile_rejection_count",
    "occupied_execution_count", "automatic_retry_count", "resume_count",
    "fallback_count", "ambiguous_success_released",
    "ordinary_admission_release_count", "product_record_count",
    "terminal_artifact_kind", "terminal_artifact_sha256",
    "transaction_attestation_sha256", "base_result", "cleanup_status",
    "finalized_cleanup_projection_preserved", "terminal_binding_restored"
  ],
  "properties": {
    "schema_version": {"const": "emr4.check-in-relay-free-recovery-attempt-008.execution-envelope.v1"},
    "result": {"enum": ["raisa_provider_free_check_in_relay_free_recovery_attempt_008_pass", "failed_closed"]},
    "attempt_id": {"const": "attempt-008"},
    "source_head": {"$ref": "#/$defs/git_commit"},
    "plan_source": {"$ref": "#/$defs/git_commit"},
    "attempt_007_terminal_source": {"$ref": "#/$defs/git_commit"},
    "diagnosis_closeout_source": {"$ref": "#/$defs/git_commit"},
    "repair_implementation_source": {"$ref": "#/$defs/git_commit"},
    "repair_closeout_source": {"$ref": "#/$defs/git_commit"},
    "verification_closeout_source": {"$ref": "#/$defs/git_commit"},
    "plan_admissibility_source": {"$ref": "#/$defs/git_commit"},
    "protected_source": {"$ref": "#/$defs/git_commit"},
    "repaired_base_harness_sha256": {"$ref": "#/$defs/sha256"},
    "base_contract_sha256": {"$ref": "#/$defs/sha256"},
    "transaction_attestation_schema_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_007_failure_sha256": {"$ref": "#/$defs/sha256"},
    "attempt_007_envelope_sha256": {"$ref": "#/$defs/sha256"},
    "repair_contract_sha256": {"$ref": "#/$defs/sha256"},
    "repair_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "verification_envelope_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "plan_admissibility_evidence_sha256": {"$ref": "#/$defs/sha256"},
    "hard_condition_ids": {
      "const": ["P06", "P07", "P08", "P09", "P10", "P11", "P12", "P13", "P14"]
    },
    "prospective_projection_path_count": {"const": 67},
    "prospective_projection_hostile_rejection_count": {"const": 66},
    "occupied_execution_count": {"const": 1},
    "automatic_retry_count": {"const": 0},
    "resume_count": {"const": 0},
    "fallback_count": {"const": 0},
    "ambiguous_success_released": {"const": false},
    "ordinary_admission_release_count": {"const": 0},
    "product_record_count": {"const": 0},
    "terminal_artifact_kind": {"enum": ["rehearsal_evidence", "rehearsal_failure_evidence"]},
    "terminal_artifact_sha256": {"$ref": "#/$defs/sha256"},
    "transaction_attestation_sha256": {"anyOf": [{"$ref": "#/$defs/sha256"}, {"type": "null"}]},
    "base_result": {"enum": ["raisa_provider_free_disposable_postgresql_default_off_check_in_relay_free_rollback_unknown_commit_recovery_rehearsal_pass", "failed_closed"]},
    "cleanup_status": {"enum": ["cleanup_verified", "cleanup_incomplete", "not_started"]},
    "finalized_cleanup_projection_preserved": {"type": "boolean"},
    "terminal_binding_restored": {"const": true}
  },
  "allOf": [
    {
      "if": {"properties": {"cleanup_status": {"enum": ["cleanup_verified", "cleanup_incomplete"]}}},
      "then": {"properties": {"finalized_cleanup_projection_preserved": {"const": true}}}
    }
  ],
  "$defs": {
    "git_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
