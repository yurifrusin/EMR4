        "guard_sha256": {"const": "6678ed31bdcd30a5018689b72ad509c182854bf5d63862f59b397acc8de40894"},
        "runner_argument_count": {"const": 4},
        "guard_parameter_count": {"const": 3}
      }
    },
    "accepted_inventory": {"$ref": "#/$defs/inventory"},
