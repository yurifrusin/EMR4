  "$id": "https://emr4.local/schemas/aes-c2/broker-simulator-contract.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "adapter_invocation_contract": {
      "additionalProperties": false,
      "properties": {
        "candidate_content_selects_no_identity": {
          "const": true
        },
        "fields": {
          "const": [
            "schema_version",
            "invocation_id",
            "operation_id",
            "candidate_digest",
            "synthetic_input_alpha",
            "synthetic_input_beta"
          ]
        },
        "operation_identity_broker_resolved": {
          "const": true
        },
        "schema_version": {
          "const": "emr4.aes_c2.broker_invocation.v1"
        }
      },
      "required": [
        "candidate_content_selects_no_identity",
        "fields",
        "operation_identity_broker_resolved",
        "schema_version"
      ],
      "type": "object"
    },
    "adapter_result_contract": {
      "additionalProperties": false,
      "properties": {
        "command_authority": {
          "const": false
        },
        "contains_sensitive_values": {
          "const": false
        },
        "effect_class": {
          "const": "none"
        },
        "fields": {
          "const": [
            "schema_version",
            "result_id",
            "result_code",
            "invocation_digest",
            "result_digest",
            "command_authority",
            "effect_class",
            "contains_sensitive_values"
          ]
        },
        "schema_version": {
          "const": "emr4.aes_c2.adapter_result.v1"
        }
      },
      "required": [
        "command_authority",
        "contains_sensitive_values",
        "effect_class",
        "fields",
        "schema_version"
      ],
      "type": "object"
    },
    "broker_registry": {
      "$ref": "#/$defs/BrokerRegistry"
    },
    "contract_id": {
      "const": "raisa-agent-execution-surface-containment-gate-aes-c2"
    },
    "digest_rules": {
      "additionalProperties": false,
      "properties": {
        "adapter_artifact_identity_rule": {
          "const": {
            "algorithm": "sha256",
            "canonicalization": "inherited_c1_manifest_and_current_generation_identity",
            "compared_with": "broker_registry.entries[0].adapter_artifact_digest",
            "expected": "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff",
            "no_equality_or_preimage_with_implementation_definition_digest": true
          }
        },
        "adapter_result_digest_rule": {
          "const": {
            "algorithm": "sha256",
            "canonicalization": "json_utf8_sorted_keys_compact_separators",
            "digested_object": "adapter_result_payload"
          }
        },
        "implementation_definition_digest_rule": {
          "const": {
            "algorithm": "sha256",
            "canonicalization": "json_utf8_sorted_keys_compact_separators",
            "compared_with": "broker_registry.entries[0].implementation_definition_digest",
            "digested_object": "implementation_definition"
          }
        },
        "invocation_digest_rule": {
          "const": {
            "algorithm": "sha256",
            "canonicalization": "json_utf8_sorted_keys_compact_separators",
            "digested_object": "broker_invocation"
          }
        }
      },
      "required": [
        "adapter_artifact_identity_rule",
        "adapter_result_digest_rule",
        "implementation_definition_digest_rule",
        "invocation_digest_rule"
      ],
      "type": "object"
    },
    "dispatch_precedence": {
      "const": [
        "1_reject_malformed_or_open_contract_attempt_registry_result_or_evidence",
        "2_stop_on_inherited_aes_c1_artifact_or_simulator_contract_digest_mismatch",
