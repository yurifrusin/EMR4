{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "evidence_label",
    "git_binding_policy",
    "accepted_inputs",
    "occupied_composition",
    "expected_fixture",
    "accepted_correction",
    "process_limits"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.native_harness_integrated_runner_factory_subcoordinate_contract.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-integrated-runner-factory-subcoordinate-diagnostic-recovery"},
    "evidence_label": {"const": "provider_free_installed_agent_registry_setup_fixture"},
    "git_binding_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "caller_authored_object_id_count"],
      "properties": {
        "mode": {"const": "machine_resolved_only"},
        "caller_authored_object_id_count": {"const": 0}
      }
    },
    "accepted_inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "threat_model", "occupied_preparation", "occupied_terminal", "accepted_correction_evidence"],
      "properties": {
        "plan": {"$ref": "#/$defs/fileBinding"},
        "threat_model": {"$ref": "#/$defs/fileBinding"},
        "occupied_preparation": {"$ref": "#/$defs/fileBinding"},
        "occupied_terminal": {"$ref": "#/$defs/fileBinding"},
        "accepted_correction_evidence": {"$ref": "#/$defs/fileBinding"}
      }
    },
    "occupied_composition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_bytes", "runner_sha256", "guard_bytes", "guard_sha256", "runner_argument_count", "guard_parameter_count"],
      "properties": {
        "runner_bytes": {"const": 14210},
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "guard_bytes": {"const": 4009},
        "guard_sha256": {"$ref": "#/$defs/sha256"},
        "runner_argument_count": {"const": 4},
        "guard_parameter_count": {"const": 3}
      }
    },
    "expected_fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["result", "structured_guard_coordinate", "runner_status", "runner_failure_stage", "node_process_count", "agent_registry_create_transits", "setup_invocations", "preset_mount_reads", "request_count", "tool_result_count"],
      "properties": {
        "result": {"const": "occupied_guard_graph_signature_mismatch_reproduced"},
        "structured_guard_coordinate": {"const": "EFFECTIVE_TOOL_COMPOSITION_INPUT_INVALID"},
        "runner_status": {"const": "failed"},
        "runner_failure_stage": {"const": "factory"},
        "node_process_count": {"const": 1},
        "agent_registry_create_transits": {"const": 1},
        "setup_invocations": {"const": 1},
        "preset_mount_reads": {"const": 0},
        "request_count": {"const": 0},
        "tool_result_count": {"const": 0}
      }
    },
    "accepted_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "derived_guard_sha256", "derived_bridge_sha256", "sanitizer_sha256"],
      "properties": {
        "decision": {"const": "materialize_accepted_root_service_forwarding_graph"},
        "derived_guard_sha256": {"$ref": "#/$defs/sha256"},
        "derived_bridge_sha256": {"$ref": "#/$defs/sha256"},
        "sanitizer_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "process_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_process_count", "native_harness_process_count", "broker_process_count", "worker_process_count", "model_request_count", "provider_request_count", "network_attempt_count", "database_attempt_count", "docker_attempt_count", "retry_count", "resume_count", "fallback_count"],
      "properties": {
        "node_process_count": {"const": 1},
        "native_harness_process_count": {"const": 0},
        "broker_process_count": {"const": 0},
        "worker_process_count": {"const": 0},
        "model_request_count": {"const": 0},
        "provider_request_count": {"const": 0},
        "network_attempt_count": {"const": 0},
        "database_attempt_count": {"const": 0},
        "docker_attempt_count": {"const": 0},
        "retry_count": {"const": 0},
        "resume_count": {"const": 0},
        "fallback_count": {"const": 0}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "bytes", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
