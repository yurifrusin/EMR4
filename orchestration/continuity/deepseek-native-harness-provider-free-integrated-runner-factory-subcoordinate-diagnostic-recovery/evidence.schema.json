{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "timestamp", "result", "contract_sha256", "source_diagnosis", "fixture", "process_boundary", "cleanup", "correction_decision", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "ariadne.native_harness_integrated_runner_factory_subcoordinate_evidence.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-integrated-runner-factory-subcoordinate-diagnostic-recovery"},
    "timestamp": {"type": "string", "minLength": 20},
    "result": {"const": "occupied_guard_graph_signature_mismatch_reproduced"},
    "contract_sha256": {"$ref": "#/$defs/sha256"},
    "source_diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runner_sha256", "guard_sha256", "runner_call", "guard_signature", "bound_preset_id_argument", "bound_selected_tools_argument", "predicted_coordinate", "accepted_lineage_reused"],
      "properties": {
        "runner_sha256": {"$ref": "#/$defs/sha256"},
        "guard_sha256": {"$ref": "#/$defs/sha256"},
        "runner_call": {"const": "assertEffectiveToolComposition(agentCtx, presets, \"emr4-bounded-worker\", TOOLS)"},
        "guard_signature": {"const": "assertEffectiveToolComposition(agentCtx, presetId, selectedTools)"},
        "bound_preset_id_argument": {"const": "preset_service_object"},
        "bound_selected_tools_argument": {"const": "emr4-bounded-worker"},
        "predicted_coordinate": {"const": "EFFECTIVE_TOOL_COMPOSITION_INPUT_INVALID"},
        "accepted_lineage_reused": {"const": true}
      }
    },
    "fixture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "result", "structured_guard_coordinate", "factory_create_agent_invocations", "setup_invocations", "setup_resolved", "runner_app_exit_code", "runner_status", "runner_failure_stage", "runner_request_count", "runner_tool_result_count", "runner_turn_kind", "runner_conclusion_marked", "preset_root_reads", "preset_mount_reads", "agent_context_property_reads", "live_agent_count", "raw_error_retained", "cordis_disposed"],
      "properties": {
        "schema_version": {"const": "ariadne.native_harness_integrated_runner_factory_fixture.v1"},
        "result": {"const": "occupied_guard_graph_signature_mismatch_reproduced"},
        "structured_guard_coordinate": {"const": "EFFECTIVE_TOOL_COMPOSITION_INPUT_INVALID"},
        "factory_create_agent_invocations": {"const": 1},
        "setup_invocations": {"const": 1},
        "setup_resolved": {"const": false},
        "runner_app_exit_code": {"const": 1},
        "runner_status": {"const": "failed"},
        "runner_failure_stage": {"const": "factory"},
        "runner_request_count": {"const": 0},
        "runner_tool_result_count": {"const": 0},
        "runner_turn_kind": {"type": "null"},
        "runner_conclusion_marked": {"const": false},
        "preset_root_reads": {"type": "integer", "minimum": 1},
        "preset_mount_reads": {"const": 0},
        "agent_context_property_reads": {"const": 0},
        "live_agent_count": {"const": 0},
        "raw_error_retained": {"const": false},
        "cordis_disposed": {"const": true}
      }
    },
    "process_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_process_count", "exit_code", "stdout_bytes", "stdout_sha256", "stderr_bytes", "stderr_sha256", "native_harness_process_count", "broker_process_count", "worker_process_count", "model_request_count", "provider_request_count", "network_attempt_count", "database_attempt_count", "docker_attempt_count", "retry_count", "resume_count", "fallback_count", "raw_stream_retained"],
      "properties": {
        "node_process_count": {"const": 1},
        "exit_code": {"const": 0},
        "stdout_bytes": {"type": "integer", "minimum": 1},
        "stdout_sha256": {"$ref": "#/$defs/sha256"},
        "stderr_bytes": {"const": 0},
        "stderr_sha256": {"const": "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855"},
        "native_harness_process_count": {"const": 0},
        "broker_process_count": {"const": 0},
        "worker_process_count": {"const": 0},
        "model_request_count": {"const": 0},
        "provider_request_count": {"const": 0},
        "network_attempt_count": {"const": 0},
        "database_attempt_count": {"const": 0},
        "docker_attempt_count": {"const": 0},
        "retry_count": {"const": 0},
        "resume_count": {"const": 0},
        "fallback_count": {"const": 0},
        "raw_stream_retained": {"const": false}
      }
    },
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_process_absent", "disposable_root_absent", "accepted_sources_unchanged"],
      "properties": {
        "node_process_absent": {"const": true},
        "disposable_root_absent": {"const": true},
        "accepted_sources_unchanged": {"const": true}
      }
    },
    "correction_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decision", "runner_change_required", "materializer_change_required", "derived_guard_sha256", "derived_bridge_sha256", "sanitizer_sha256"],
      "properties": {
        "decision": {"const": "materialize_accepted_root_service_forwarding_graph"},
        "runner_change_required": {"const": false},
        "materializer_change_required": {"const": true},
        "derived_guard_sha256": {"$ref": "#/$defs/sha256"},
        "derived_bridge_sha256": {"$ref": "#/$defs/sha256"},
        "sanitizer_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installed_agent_registry_setup_fixture_only", "native_harness_proved", "deepseek_turn_proved", "provider_reached", "product_authority"],
      "properties": {
        "installed_agent_registry_setup_fixture_only": {"const": true},
        "native_harness_proved": {"const": false},
        "deepseek_turn_proved": {"const": false},
        "provider_reached": {"const": false},
        "product_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
