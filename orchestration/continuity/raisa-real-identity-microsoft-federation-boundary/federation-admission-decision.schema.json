{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/federation-admission-decision-v1.json",
  "title": "EMR4 federation admission decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "case_id",
    "policy_version",
    "authority_source",
    "provider",
    "decision",
    "http_status",
    "external_error",
    "reason_codes",
    "evaluated_at",
    "audit_required",
    "audit_recorded",
    "principal_candidate_released",
    "session_created",
    "product_data_released",
    "email_or_office_identity_used",
    "provider_calls"
  ],
  "properties": {
    "schema_version": {"const": "emr4.federation-admission-decision.v1"},
    "case_id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "policy_version": {"const": "microsoft-entra-single-tenant-prebound.v1"},
    "authority_source": {"const": "emr4_backend"},
    "provider": {"const": "microsoft_entra"},
    "decision": {"enum": ["admit", "deny", "error"]},
    "http_status": {"enum": [200, 401, 503]},
    "external_error": {"enum": [null, "authentication_failed", "authentication_temporarily_unavailable"]},
    "reason_codes": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
    "evaluated_at": {"type": "string", "format": "date-time"},
    "audit_required": {"const": true},
    "audit_recorded": {"type": "boolean"},
    "principal_candidate_released": {"type": "boolean"},
    "session_created": {"const": false},
    "product_data_released": {"const": false},
    "email_or_office_identity_used": {"const": false},
    "provider_calls": {"const": 0}
  }
}
