{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/rayleen-a4-selector-model-body.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "intent",
    "projection_kind",
    "practitioner_ref",
    "waiting_area_ref",
    "focus_appointment_ref",
    "evidence_appointment_refs",
    "context_revision",
    "response_code",
    "authority_ceiling"
  ],
  "properties": {
    "intent": {"const": "select_projection"},
    "projection_kind": {"const": "longest_wait"},
    "practitioner_ref": {"type": "string", "pattern": "^practitioner_[0-9a-f]{24}$"},
    "waiting_area_ref": {"type": "string", "pattern": "^waiting_area_[0-9a-f]{24}$"},
    "focus_appointment_ref": {"type": "string", "pattern": "^appointment_[0-9a-f]{24}$"},
    "evidence_appointment_refs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^appointment_[0-9a-f]{24}$"}
    },
    "context_revision": {"const": 1836412047},
    "response_code": {"const": "LONGEST_WAIT_MODEL_SELECTED"},
    "authority_ceiling": {"$ref": "#/$defs/authority"}
  },
  "$defs": {
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["confirmation", "command", "database", "product_read", "tool", "write"],
      "properties": {
        "confirmation": {"const": false},
        "command": {"const": false},
        "database": {"const": false},
        "product_read": {"const": false},
        "tool": {"const": false},
        "write": {"const": false}
      }
    }
  }
}
