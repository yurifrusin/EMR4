      "additionalProperties": false,
      "required": ["network_cardinality", "network_key_relation", "network_mode_relation", "endpoint_network_id_relation"],
      "properties": {
        "network_cardinality": {"const": 1},
        "network_key_relation": {"const": "captured_network_name"},
        "network_mode_relation": {"enum": ["captured_network_name", "captured_network_id"]},
