{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/cleanup-receipt.v1.json",
  "title": "Idempotent owned-resource cleanup receipt",
  "description": "Closed cleanup receipt proving no owned process, listener, task directory, open ledger or reusable capability remains, with exact owned-path removal and truthful non-negative operation accounting. Provider-free fake-only acceptance remains exactly zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_label",
    "result",
    "no_process",
    "no_listener",
    "no_task_directory",
    "no_open_ledger",
    "no_reusable_capability",
    "removed_paths",
    "ledger_consumed",
    "operation_counters",
    "issued_at"
  ],
  "properties": {
    "schema_version": {"const": "emr4.cleanup_receipt.v1"},
    "evidence_label": {"const": "occupied_authored_synthetic_disposable_live_development_recovery"},
    "result": {"enum": ["cleanup_verified", "cleanup_inconclusive"]},
    "no_process": {"type": "boolean"},
    "no_listener": {"type": "boolean"},
    "no_task_directory": {"type": "boolean"},
    "no_open_ledger": {"type": "boolean"},
    "no_reusable_capability": {"type": "boolean"},
    "removed_paths": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "minLength": 1, "maxLength": 512}
    },
    "ledger_consumed": {"type": "boolean"},
    "operation_counters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "process_starts",
        "process_stops",
        "socket_binds",
        "socket_connects",
        "port_allocations",
        "directory_creates",
        "directory_removals",
        "provider_calls",
        "database_operations",
        "product_operations",
        "cloud_iam_operations",
        "deployment_operations",
        "external_event_operations",
        "protected_operations",
        "shell_operations",
        "sql_operations",
        "network_operations",
        "dynamic_import_operations",
        "eval_exec_operations",
        "reflection_operations"
      ],
      "properties": {
        "process_starts": {"type": "integer", "minimum": 0},
        "process_stops": {"type": "integer", "minimum": 0},
        "socket_binds": {"type": "integer", "minimum": 0},
        "socket_connects": {"type": "integer", "minimum": 0},
        "port_allocations": {"type": "integer", "minimum": 0},
        "directory_creates": {"type": "integer", "minimum": 0},
        "directory_removals": {"type": "integer", "minimum": 0},
        "provider_calls": {"type": "integer", "minimum": 0},
        "database_operations": {"type": "integer", "minimum": 0},
        "product_operations": {"type": "integer", "minimum": 0},
        "cloud_iam_operations": {"type": "integer", "minimum": 0},
        "deployment_operations": {"type": "integer", "minimum": 0},
        "external_event_operations": {"type": "integer", "minimum": 0},
        "protected_operations": {"type": "integer", "minimum": 0},
        "shell_operations": {"type": "integer", "minimum": 0},
        "sql_operations": {"type": "integer", "minimum": 0},
        "network_operations": {"type": "integer", "minimum": 0},
        "dynamic_import_operations": {"type": "integer", "minimum": 0},
        "eval_exec_operations": {"type": "integer", "minimum": 0},
        "reflection_operations": {"type": "integer", "minimum": 0}
      }
    },
    "issued_at": {"type": "string", "format": "date-time"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "cleanup_verified"}}, "required": ["result"]},
      "then": {
        "properties": {
          "no_process": {"const": true},
          "no_listener": {"const": true},
          "no_task_directory": {"const": true},
          "no_open_ledger": {"const": true},
          "no_reusable_capability": {"const": true},
          "ledger_consumed": {"const": true}
        }
      }
    }
  ]
}
