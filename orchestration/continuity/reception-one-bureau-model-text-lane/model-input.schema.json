{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/reception-one-bureau-model-input-v1.json",
  "title": "Reception One Bureau Model Input",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "data_class",
    "utterances",
    "effect_ceiling",
    "available_bindings",
    "operator_catalog"
  ],
  "properties": {
    "contract_version": {
      "const": "reception.one.bureau.model-input.v1"
    },
    "data_class": {
      "const": "authored_synthetic"
    },
    "utterances": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 512
      }
    },
    "effect_ceiling": {
      "const": "proposal_only"
    },
    "available_bindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 9,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "enum": [
          "binding:patient",
          "binding:practitioner",
          "binding:status",
          "binding:appointment_date",
          "binding:earliest_time",
          "binding:latest_time",
          "binding:duration_minutes",
          "binding:selected_appointment",
          "binding:squeeze_policy",
          "binding:default_duration_minutes"
        ]
      }
    },
    "operator_catalog": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/operator"
      }
    }
  },
  "$defs": {
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "type": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "effect",
        "inputs",
        "outputs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "effect": {
          "enum": [
            "pure",
            "authorised_read",
            "proposal_only"
          ]
        },
        "inputs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/field"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/output"
          }
        }
      }
    }
  }
}
