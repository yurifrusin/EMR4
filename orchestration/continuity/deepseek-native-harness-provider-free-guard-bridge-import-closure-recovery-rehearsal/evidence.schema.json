{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.dev/schemas/native-harness-guard-bridge-import-closure-recovery-evidence.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
