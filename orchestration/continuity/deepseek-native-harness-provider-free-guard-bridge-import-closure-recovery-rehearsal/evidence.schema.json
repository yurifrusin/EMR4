    "operation_id": {"const": "deepseek-native-harness-provider-free-guard-bridge-import-closure-recovery-rehearsal"},
    "result": {"const": "package_unloaded_guard_bridge_import_closure_recovery_pass"},
    "git_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["policy", "caller_authored_object_id_count", "planning_source_commit", "candidate_source_commit", "planning_source_is_ancestor_of_candidate", "branch", "branch_origin_aligned", "protected_refs_aligned", "tracked_worktree_clean", "docs_branding_preserved"],
      "properties": {
        "policy": {"const": "machine_resolved_only"},
        "caller_authored_object_id_count": {"const": 0},
        "planning_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "candidate_source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "planning_source_is_ancestor_of_candidate": {"const": true},
        "branch": {"const": "codex/ariadne-bernie-davida-parallel-seam"},
        "branch_origin_aligned": {"const": true},
        "protected_refs_aligned": {"const": true},
        "tracked_worktree_clean": {"const": true},
        "docs_branding_preserved": {"const": true}
      }
    },
    "accepted_source_inventory": {"type": "object"},
    "stub_source_inventory": {"type": "object"},
    "fixture_correction": {"type": "object"},
    "import_closure": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relative_edges", "bare_edges", "relative_edge_count", "bare_edge_count", "all_resolved_targets_materialized"],
      "properties": {
        "relative_edges": {"type": "array", "minItems": 3, "maxItems": 3},
        "bare_edges": {"type": "array", "minItems": 2, "maxItems": 2},
        "relative_edge_count": {"const": 3},
        "bare_edge_count": {"const": 2},
        "all_resolved_targets_materialized": {"const": true}
      }
    },
    "materialized_relative_paths": {"type": "array", "minItems": 8, "maxItems": 8, "uniqueItems": true},
    "process_envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "process_envelope_recorded_before_interpretation": {"const": true},
    "fixture_outcome": {"type": "object"},
    "environment": {"type": "object"},
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fixture_root_absent", "fixture_root_path_retained", "materialized_javascript_retained", "materialized_package_manifests_retained"],
      "properties": {
        "fixture_root_absent": {"const": true},
        "fixture_root_path_retained": {"const": false},
        "materialized_javascript_retained": {"const": false},
        "materialized_package_manifests_retained": {"const": false}
      }
    },
    "process_boundary": {
      "type": "object",
      "required": ["node_process_count", "guard_module_execution_count", "bridge_module_execution_count", "sanitizer_module_execution_count", "local_stub_package_count", "materialized_file_count"],
      "properties": {
        "node_process_count": {"const": 1},
        "guard_module_execution_count": {"const": 1},
        "bridge_module_execution_count": {"const": 1},
        "sanitizer_module_execution_count": {"const": 1},
        "local_stub_package_count": {"const": 2},
        "materialized_file_count": {"const": 8}
      },
      "additionalProperties": {"type": "integer", "minimum": 0, "maximum": 0}
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["static_import_closure_proved", "package_unloaded_guard_bridge_graph_proved", "predecessor_retry", "derived_runner_proved", "installed_package_loaded", "native_harness_proved", "worker_model_provider_executed", "retry_authorized", "product_authority"],
      "properties": {
        "static_import_closure_proved": {"const": true},
        "package_unloaded_guard_bridge_graph_proved": {"const": true},
        "predecessor_retry": {"const": false},
        "derived_runner_proved": {"const": false},
        "installed_package_loaded": {"const": false},
        "native_harness_proved": {"const": false},
        "worker_model_provider_executed": {"const": false},
        "retry_authorized": {"const": false},
        "product_authority": {"const": false}
      }
    }
