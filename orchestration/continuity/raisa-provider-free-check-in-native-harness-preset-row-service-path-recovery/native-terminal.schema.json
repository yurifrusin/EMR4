{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "attempt_id", "result", "terminal_coordinate", "markers", "package", "launch", "counts", "cleanup", "runner_terminal_valid", "network_ledger_valid", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "ariadne.check_in_preset_row_service_path_native_terminal.v1"},
    "operation_id": {"const": "raisa-provider-free-check-in-native-harness-preset-row-service-path-recovery"},
    "attempt_id": {"const": "check-in-preset-row-service-native-probe-001"},
    "result": {"enum": ["pass", "failed_closed"]},
    "terminal_coordinate": {"enum": ["EFFECTIVE_ROOTS_ENTERED", "EFFECTIVE_ROOTS_PASSED", "PRESET_ROW_DISCOVERY_ENTERED", "PRESET_ROW_FOUND", "PRESET_ROW_HEALTHY", "PRESET_BYTES_READ", "PRESET_LENGTH_BOUND_PASSED", "PRESET_DIGEST_BOUND_PASSED", "NATIVE_PROCESS_TIMEOUT", "NETWORK_ATTEMPT_OBSERVED", "NATIVE_SERVICE_EXECUTION_EXCEPTION"]},
    "markers": {
      "type": "array", "maxItems": 8, "uniqueItems": true,
      "items": {"enum": ["EFFECTIVE_ROOTS_ENTERED", "EFFECTIVE_ROOTS_PASSED", "PRESET_ROW_DISCOVERY_ENTERED", "PRESET_ROW_FOUND", "PRESET_ROW_HEALTHY", "PRESET_BYTES_READ", "PRESET_LENGTH_BOUND_PASSED", "PRESET_DIGEST_BOUND_PASSED"]}
    },
    "package": {
      "type": "object", "additionalProperties": false,
      "required": ["installation_id", "name", "version", "package_lock_sha256"],
      "properties": {
        "installation_id": {"const": "deepseek-check-in-attachment-observability-native-001"},
        "name": {"const": "@deepseek-ai/dsh"},
        "version": {"const": "0.1.0-rc.7"},
        "package_lock_sha256": {"const": "a89defcd8a2c5aae4a54c03bda98e2585711fce881b4b08c90ca4808d45555f4"}
      }
    },
    "launch": {
      "type": "object", "additionalProperties": false,
      "required": ["duration_ms", "exit_code", "stdout_bytes", "stdout_sha256", "stderr_bytes", "stderr_sha256", "raw_logs_retained", "credential_environment_names_removed_count"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0, "maximum": 60000},
        "exit_code": {"type": ["integer", "null"]},
        "stdout_bytes": {"type": "integer", "minimum": 0},
        "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "stderr_bytes": {"type": "integer", "minimum": 0},
        "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "raw_logs_retained": {"const": false},
        "credential_environment_names_removed_count": {"type": "integer", "minimum": 0}
      }
    },
    "counts": {
      "type": "object", "additionalProperties": false,
      "required": ["native_processes", "automatic_retries", "agent_sessions", "turns", "broker_requests", "model_requests", "provider_requests", "network_attempts", "docker_invocations", "database_invocations"],
      "properties": {
        "native_processes": {"type": "integer", "minimum": 0, "maximum": 1},
        "automatic_retries": {"const": 0}, "agent_sessions": {"const": 0}, "turns": {"const": 0},
        "broker_requests": {"const": 0}, "model_requests": {"const": 0}, "provider_requests": {"const": 0},
        "network_attempts": {"type": "integer", "minimum": 0}, "docker_invocations": {"const": 0}, "database_invocations": {"const": 0}
      }
    },
    "cleanup": {"const": {"process_absent": true, "disposable_root_absent": true}},
    "runner_terminal_valid": {"type": "boolean"},
    "network_ledger_valid": {"type": "boolean"},
    "claim_boundary": {"const": "provider_disabled_native_preset_row_service_confirmation_only_no_agent_mount_deepseek_database_or_product_claim"}
  },
  "allOf": [
    {
      "if": {"properties": {"result": {"const": "pass"}}},
      "then": {
        "properties": {
          "terminal_coordinate": {"const": "PRESET_DIGEST_BOUND_PASSED"},
          "markers": {"const": ["EFFECTIVE_ROOTS_ENTERED", "EFFECTIVE_ROOTS_PASSED", "PRESET_ROW_DISCOVERY_ENTERED", "PRESET_ROW_FOUND", "PRESET_ROW_HEALTHY", "PRESET_BYTES_READ", "PRESET_LENGTH_BOUND_PASSED", "PRESET_DIGEST_BOUND_PASSED"]},
          "launch": {"properties": {"exit_code": {"const": 0}}},
          "counts": {"properties": {"native_processes": {"const": 1}, "network_attempts": {"const": 0}}},
          "runner_terminal_valid": {"const": true},
          "network_ledger_valid": {"const": true}
        }
      }
    }
  ]
}
