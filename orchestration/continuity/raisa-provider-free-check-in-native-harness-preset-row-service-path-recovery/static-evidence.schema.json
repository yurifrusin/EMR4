{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "operation_id", "result", "claim_boundary", "source_files", "source_checks", "shipped_roster", "root_transformation", "provider_boundary"],
  "properties": {
    "schema_version": {"const": "ariadne.check_in_preset_row_service_path_static_evidence.v1"},
    "operation_id": {"const": "raisa-provider-free-check-in-native-harness-preset-row-service-path-recovery"},
    "result": {"const": "pass"},
    "claim_boundary": {"const": "pinned_rc7_source_and_role_labelled_effective_root_proof_only_no_native_harness_agent_mount_or_provider_claim"},
    "source_files": {
      "type": "array", "minItems": 6, "maxItems": 6,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["package", "role", "bytes", "sha256"],
        "properties": {
          "package": {"type": "string", "minLength": 1},
          "role": {"type": "string", "minLength": 1},
          "bytes": {"type": "integer", "minimum": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "source_checks": {
      "type": "object", "minProperties": 10, "maxProperties": 10,
      "additionalProperties": {"const": true}
    },
    "shipped_roster": {
      "type": "object", "additionalProperties": false,
      "required": ["ids", "emr4_present"],
      "properties": {
        "ids": {"const": ["code", "cordis", "minimal", "standard"]},
        "emr4_present": {"const": false}
      }
    },
    "root_transformation": {
      "type": "object", "additionalProperties": false,
      "required": ["configured_root_replaced_by_native_overlay", "predecessor_include_user_root", "predecessor_effective_roots", "corrected_include_user_root", "corrected_effective_roots", "direct_scan_explicit_user_root"],
      "properties": {
        "configured_root_replaced_by_native_overlay": {"const": true},
        "predecessor_include_user_root": {"const": false},
        "predecessor_effective_roots": {"const": [{"role": "shipped", "trust": "system"}]},
        "corrected_include_user_root": {"const": true},
        "corrected_effective_roots": {"const": [{"role": "shipped", "trust": "system"}, {"role": "derived_user", "trust": "user"}]},
        "direct_scan_explicit_user_root": {"const": true}
      }
    },
    "provider_boundary": {"$ref": "#/$defs/zeroBoundary"}
  },
  "$defs": {
    "zeroBoundary": {
      "type": "object", "additionalProperties": false,
      "required": ["package_only_node_processes", "native_harness_processes", "agent_sessions", "turns", "broker_requests", "model_requests", "provider_requests", "network_attempts", "docker_invocations", "database_invocations"],
      "properties": {
        "package_only_node_processes": {"const": 0}, "native_harness_processes": {"const": 0},
        "agent_sessions": {"const": 0}, "turns": {"const": 0}, "broker_requests": {"const": 0},
        "model_requests": {"const": 0}, "provider_requests": {"const": 0}, "network_attempts": {"const": 0},
        "docker_invocations": {"const": 0}, "database_invocations": {"const": 0}
      }
    }
  }
}
