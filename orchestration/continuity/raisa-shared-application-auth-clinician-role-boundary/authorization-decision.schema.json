{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/backend-authorization-decision-v1.json",
  "title": "EMR4 backend authorization decision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "decision_id",
    "correlation_id",
    "case_id",
    "authority_source",
    "policy_version",
    "surface",
    "action",
    "resource_type",
    "decision",
    "http_status",
    "reason_codes",
    "current_backend_role",
    "practice_scope",
    "evaluated_at",
    "validity",
    "audit_required",
    "audit_recorded",
    "office_identity_used",
    "client_claims_used",
    "evaluated_before_data_access",
    "product_data_released"
  ],
  "properties": {
    "schema_version": {
      "const": "emr4.backend-authorization-decision.v1"
    },
    "decision_id": {
      "type": "string",
      "pattern": "^decision-[a-z0-9-]+$"
    },
    "correlation_id": {
      "type": "string",
      "pattern": "^correlation-[a-z0-9-]+$"
    },
    "case_id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "authority_source": {
      "const": "emr4_backend"
    },
    "policy_version": {
      "const": "clinician-workspace-read.v1"
    },
    "surface": {
      "enum": [
        "word_desktop",
        "word_online",
        "native_diary",
        "unknown"
      ]
    },
    "action": {
      "const": "clinician_workspace.read"
    },
    "resource_type": {
      "const": "clinical_context"
    },
    "decision": {
      "enum": [
        "allow",
        "deny",
        "error"
      ]
    },
    "http_status": {
      "enum": [
        200,
        401,
        403,
        503
      ]
    },
    "reason_codes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9_]+$"
      }
    },
    "current_backend_role": {
      "type": [
        "string",
        "null"
      ]
    },
    "practice_scope": {
      "enum": [
        "same_practice",
        "mismatch",
        "unknown"
      ]
    },
    "evaluated_at": {
      "type": "string",
      "format": "date-time"
    },
    "validity": {
      "const": "current_request_only"
    },
    "audit_required": {
      "const": true
    },
    "audit_recorded": {
      "type": "boolean"
    },
    "office_identity_used": {
      "const": false
    },
    "client_claims_used": {
      "const": false
    },
    "evaluated_before_data_access": {
      "const": true
    },
    "product_data_released": {
      "const": false
    }
  }
}
