      "required": ["contract_attempted", "contract_rejected", "manifest_attempted", "manifest_rejected", "classifier_attempted", "classifier_rejected", "escapes"],
      "properties": {
        "contract_attempted": {"type": "integer", "minimum": 256},
        "contract_rejected": {"type": "integer", "minimum": 256},
        "manifest_attempted": {"type": "integer", "minimum": 96},
        "manifest_rejected": {"type": "integer", "minimum": 96},
        "classifier_attempted": {"type": "integer", "minimum": 24},
        "classifier_rejected": {"type": "integer", "minimum": 24},
        "escapes": {"const": 0}
      }
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["postgresql_major", "image_reference", "image_id_sha256", "network_internal", "published_ports", "storage", "host_transport", "provider_calls", "product_rows", "live_secrets", "automatic_retries"],
      "properties": {
        "postgresql_major": {"const": 16},
        "image_reference": {"const": "postgres:16-bookworm"},
        "image_id_sha256": {"$ref": "#/$defs/digest"},
        "network_internal": {"const": true},
        "published_ports": {"const": false},
        "storage": {"const": "container_local_tmpfs"},
        "host_transport": {"const": "fixed_in_process_ipv4_loopback_relay"},
        "provider_calls": {"const": 0},
        "product_rows": {"const": 0},
        "live_secrets": {"const": 0},
        "automatic_retries": {"const": 0}
      }
    },
    "lifecycle": {"type": "array", "minItems": 12, "items": {"type": "string", "minLength": 3}},
    "cleanup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "container", "network", "container_id_sha256", "network_id_sha256", "role_absent_before_teardown"],
      "properties": {
