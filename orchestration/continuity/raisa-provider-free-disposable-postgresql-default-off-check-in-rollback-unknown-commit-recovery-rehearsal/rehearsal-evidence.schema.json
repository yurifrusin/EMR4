    "contract_sha256": {"$ref": "#/$defs/digest"},
    "source_hashes": {"type": "object", "minProperties": 17, "maxProperties": 17, "additionalProperties": {"$ref": "#/$defs/digest"}},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "attestation_artifact": {"const": "orchestration/continuity/raisa-provider-free-disposable-postgresql-default-off-check-in-rollback-unknown-commit-recovery-rehearsal/transaction-attestation.json"},
    "attestation_sha256": {"$ref": "#/$defs/digest"},
    "hostile_mutations": {
