{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schema/check-in-rollback-unknown-response-transaction-attestation.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "evidence_reference",
    "evidence_label",
    "authority_git_object",
    "accepted_runtime_role_source",
    "environment_identifier",
    "practice_scope_reference",
    "manifest_sha256",
    "logical_role_id",
    "physical_role_identifier",
    "role_catalogue",
    "relation_catalogue",
    "transaction_outcomes",
    "hostile_classifier",
    "scenarios",
    "role_absent_before_teardown",
    "ordinary_admission_release_count",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "emr4.check-in-rollback-unknown-response-transaction-attestation.v1"},
    "evidence_reference": {"const": "evidence-ref:authored-synthetic/check-in-rollback-unknown-response-transaction-attestation"},
    "evidence_label": {"const": "authored_synthetic_provider_free_disposable_postgresql_check_in_rollback_unknown_terminal_response_recovery"},
    "authority_git_object": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "accepted_runtime_role_source": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "environment_identifier": {"const": "env:authored-synthetic-check-in-recovery"},
    "practice_scope_reference": {"const": "practice-ref:authored-synthetic/check-in-recovery"},
    "manifest_sha256": {"$ref": "#/$defs/digest"},
    "logical_role_id": {"const": "appointment_check_in_ordinary_runtime_v1"},
    "physical_role_identifier": {"type": "string", "pattern": "^emr4_checkin_ruc_[0-9a-f]{16}$"},
    "role_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["login", "superuser", "create_database", "create_role", "inherit", "replication", "bypass_rls", "memberships", "owned_objects", "product_relation_privileges", "probe_grants"],
      "properties": {
        "login": {"const": true},
        "superuser": {"const": false},
        "create_database": {"const": false},
        "create_role": {"const": false},
        "inherit": {"const": false},
        "replication": {"const": false},
        "bypass_rls": {"const": false},
        "memberships": {"const": 0},
        "owned_objects": {"const": 0},
        "product_relation_privileges": {"const": 0},
        "probe_grants": {"const": ["INSERT", "SELECT"]}
      }
    },
    "relation_catalogue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["relations", "admin_owned_count", "rls_enabled_count", "rls_forced_count", "policy_count", "policy_expression_match_count", "constraints_verified"],
      "properties": {
        "relations": {"const": ["command_audit", "command_effect", "command_receipt"]},
        "admin_owned_count": {"const": 3},
        "rls_enabled_count": {"const": 3},
        "rls_forced_count": {"const": 3},
        "policy_count": {"const": 3},
        "policy_expression_match_count": {"const": 3},
        "constraints_verified": {"const": true}
      }
    },
    "transaction_outcomes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["explicit_rollback", "ambiguous_response"],
      "properties": {
        "explicit_rollback": {
          "type": "object",
          "additionalProperties": false,
          "required": ["staged_counts", "readback_counts", "packet_sha256", "classification"],
          "properties": {
            "staged_counts": {"$ref": "#/$defs/one_counts"},
            "readback_counts": {"$ref": "#/$defs/zero_counts"},
            "packet_sha256": {"$ref": "#/$defs/digest"},
            "classification": {"const": "rolled_back_zero_effect"}
          }
        },
        "ambiguous_response": {
          "type": "object",
          "additionalProperties": false,
          "required": ["caller_outcome", "complete_terminal_response", "success_released", "retry_count", "post_commit_wait", "backend_termination", "readback_counts", "packet_sha256", "classification"],
          "properties": {
            "caller_outcome": {"const": "connection_lost_without_complete_terminal_response"},
            "complete_terminal_response": {"const": false},
            "success_released": {"const": false},
            "retry_count": {"const": 0},
            "post_commit_wait": {"const": "Timeout/PgSleep"},
            "backend_termination": {"const": "exact_observed_session_only"},
            "readback_counts": {"$ref": "#/$defs/one_counts"},
            "packet_sha256": {"$ref": "#/$defs/digest"},
            "classification": {"const": "committed_exactly_once"}
          }
        }
      }
    },
    "hostile_classifier": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempted", "rejected", "escapes"],
      "properties": {
        "attempted": {"type": "integer", "minimum": 24},
        "rejected": {"type": "integer", "minimum": 24},
        "escapes": {"const": 0}
      }
    },
    "scenarios": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status", "observed"],
        "properties": {
          "id": {"type": "string", "pattern": "^RUC-S(0[1-9]|1[0-2])$"},
          "status": {"const": "passed"},
          "observed": {"type": ["string", "integer", "boolean"]}
        }
      }
    },
    "role_absent_before_teardown": {"const": true},
    "ordinary_admission_release_count": {"const": 0},
    "claim_boundary": {"type": "string", "minLength": 80}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "zero_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "receipt", "audit"],
      "properties": {"effect": {"const": 0}, "receipt": {"const": 0}, "audit": {"const": 0}}
    },
    "one_counts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "receipt", "audit"],
      "properties": {"effect": {"const": 1}, "receipt": {"const": 1}, "audit": {"const": 1}}
    }
  }
}
