{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/native-harness-plugin-tree-source-diagnosis-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "mode",
    "package",
    "terminal",
    "allowed_owner_classifications",
    "allowed_verdicts",
    "unique_match_required",
    "repair_implementation_authorized",
    "occupied_retry_authorized",
    "forbidden_activity",
    "required_zero_counters"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.native_harness_plugin_tree_source_diagnosis_contract.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-plugin-tree-failed-to-load-source-coordinate-diagnosis"},
    "mode": {"const": "provider_free_read_only_static_source"},
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "local_only", "execution_forbidden"],
      "properties": {
        "name": {"const": "@deepseek-ai/dsh"},
        "version": {"const": "0.1.0-rc.7"},
        "local_only": {"const": true},
        "execution_forbidden": {"const": true}
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "schema_version", "cause", "top_message_coordinate", "cause_chain_length", "raw_fields_forbidden"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "schema_version": {"const": "ariadne.native_harness_pre_hmr_startup_terminal.v2"},
        "cause": {"const": "structured_entrypoint_import_rejected"},
        "top_message_coordinate": {"const": "plugin_tree_failed_to_load"},
        "cause_chain_length": {"const": 4},
        "raw_fields_forbidden": {"const": true}
      }
    },
    "allowed_owner_classifications": {"type": "array", "minItems": 5, "uniqueItems": true, "items": {"type": "string"}},
    "allowed_verdicts": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string"}},
    "unique_match_required": {"const": true},
    "repair_implementation_authorized": {"const": false},
    "occupied_retry_authorized": {"const": false},
    "forbidden_activity": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"type": "string"}},
    "required_zero_counters": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"type": "string"}}
  }
}
