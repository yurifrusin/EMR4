{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/raisa-context-fabric-disposable-postgresql-behavior-transaction-evidence.v1.json",
  "title": "Raisa Context Fabric disposable PostgreSQL behavior/transaction evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "result",
    "evidence_mode",
    "attempt_id",
    "parent",
    "environment",
    "lifecycle",
    "preconditions",
    "scenarios",
    "scenario_reconciliation",
    "cleanup",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {
      "const": "emr4.raisa-context-fabric-disposable-postgresql-behavior-transaction-evidence.v1"
    },
    "result": {
      "enum": [
        "raisa_provider_free_disposable_postgresql_durability_behavior_transaction_rehearsal_pass",
        "environment_unavailable",
        "cleanup_ownership_unverified",
        "rehearsal_failed"
      ]
    },
    "evidence_mode": {
      "const": "provider_free_disposable_postgresql_authored_synthetic_behavior_transaction"
    },
    "attempt_id": {"type": "string", "pattern": "^[0-9a-f]{24}$"},
    "parent": {
      "oneOf": [
        {"type": "object", "maxProperties": 0},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["behavior_contract_sha256", "artifact_sha256", "manifest_sha256", "prerequisite_sha256", "statement_count"],
          "properties": {
            "behavior_contract_sha256": {"$ref": "#/$defs/digest"},
            "artifact_sha256": {"$ref": "#/$defs/digest"},
            "manifest_sha256": {"$ref": "#/$defs/digest"},
            "prerequisite_sha256": {"$ref": "#/$defs/digest"},
            "statement_count": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["docker_client", "image", "elapsed_ms"],
      "properties": {
        "docker_client": {"type": "string", "minLength": 1},
        "image": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["reference", "id", "pull_attempted"],
              "properties": {
                "reference": {"const": "postgres:16-bookworm"},
                "id": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
                "pull_attempted": {"const": false}
              }
            }
          ]
        },
        "readiness": {"type": "object"},
        "failure": {
          "type": "object",
          "additionalProperties": false,
          "required": ["stage", "code", "detail_digest"],
          "properties": {
            "stage": {"type": "string", "minLength": 1},
            "code": {"type": "string", "minLength": 1},
            "detail_digest": {"$ref": "#/$defs/digest"},
            "query_id": {"const": "scenario_snapshot"},
            "scenario_id": {
              "enum": [
                "BTR-E01", "BTR-E02", "BTR-E03", "BTR-I01", "BTR-E04",
                "BTR-I03", "BTR-E05", "BTR-E06", "BTR-I02", "BTR-I04",
                "BTR-T01", "BTR-T02", "BTR-T03", "BTR-T04", "BTR-R01",
                "BTR-R02", "BTR-R03", "BTR-B01", "BTR-B02", "BTR-B03"
              ]
            },
            "sqlstate": {"type": "string", "pattern": "^[0-9A-Z]{5}$"},
            "coordinate_status": {
              "enum": [
                "missing",
                "ambiguous",
                "unlisted_relation",
                "unlisted_column",
                "released"
              ]
            },
            "relation": {
              "enum": [
                "public.appointments",
                "emr4_context_fabric.context_service_practice_binding",
                "emr4_context_fabric.context_generation_registry_barrier",
                "emr4_context_fabric.context_observer_generation",
                "emr4_context_fabric.context_durability_checkpoint",
                "emr4_context_fabric.context_frame_generation",
                "emr4_context_fabric.context_invalidation_watermark",
                "emr4_context_fabric.context_reassembly_obligation"
              ]
            },
            "column": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        },
        "elapsed_ms": {"type": "integer", "minimum": 0}
      }
    },
    "lifecycle": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "preconditions": {
      "type": "array",
      "maxItems": 2,
      "uniqueItems": true,
      "items": {"enum": ["position_two_projected", "rollback_primary_precommitted"]}
    },
    "scenarios": {
      "type": "array",
      "maxItems": 20,
      "prefixItems": [
        {"properties": {"scenario_id": {"const": "BTR-E01"}}},
        {"properties": {"scenario_id": {"const": "BTR-E02"}}},
        {"properties": {"scenario_id": {"const": "BTR-E03"}}},
        {"properties": {"scenario_id": {"const": "BTR-I01"}}},
        {"properties": {"scenario_id": {"const": "BTR-E04"}}},
        {"properties": {"scenario_id": {"const": "BTR-I03"}}},
        {"properties": {"scenario_id": {"const": "BTR-E05"}}},
        {"properties": {"scenario_id": {"const": "BTR-E06"}}},
        {"properties": {"scenario_id": {"const": "BTR-I02"}}},
        {"properties": {"scenario_id": {"const": "BTR-I04"}}},
        {"properties": {"scenario_id": {"const": "BTR-T01"}}},
        {"properties": {"scenario_id": {"const": "BTR-T02"}}},
        {"properties": {"scenario_id": {"const": "BTR-T03"}}},
        {"properties": {"scenario_id": {"const": "BTR-T04"}}},
        {"properties": {"scenario_id": {"const": "BTR-R01"}}},
        {"properties": {"scenario_id": {"const": "BTR-R02"}}},
        {"properties": {"scenario_id": {"const": "BTR-R03"}}},
        {"properties": {"scenario_id": {"const": "BTR-B01"}}},
        {"properties": {"scenario_id": {"const": "BTR-B02"}}},
        {"properties": {"scenario_id": {"const": "BTR-B03"}}}
      ],
      "allOf": [{"items": {"$ref": "#/$defs/scenario"}}],
      "items": {"$ref": "#/$defs/scenario"}
    },
    "scenario_reconciliation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["expected", "observed", "passed"],
      "properties": {
        "expected": {"const": 20},
        "observed": {"type": "integer", "minimum": 0, "maximum": 20},
        "passed": {"type": "integer", "minimum": 0, "maximum": 20}
      }
    },
    "cleanup": {
      "type": "object",
      "required": ["status", "removed", "absence_verified"],
      "properties": {
        "status": {"type": "string", "minLength": 1},
        "container_id": {"type": "string", "pattern": "^[0-9a-f]{12,64}$"},
        "removed": {"type": "boolean"},
        "absence_verified": {"type": "boolean"},
        "failure_stage": {"type": "string"},
        "failure_code": {"type": "string"}
      }
    },
    "claim_boundary": {
      "const": "selected_serial_entry_point_trigger_rls_idempotency_and_outer_rollback_behavior_only"
    }
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "snapshotFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "digest"],
      "properties": {
        "count": {"type": "integer", "minimum": 0},
        "digest": {"$ref": "#/$defs/digest"}
      }
    },
    "snapshot": {
      "type": "object",
      "minProperties": 22,
      "maxProperties": 22,
      "propertyNames": {"pattern": "^(public|emr4_context_fabric)\\.[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/snapshotFact"}
    },
    "booleanMap": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {"const": true},
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"}
    },
    "stderrDigest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["byte_count", "sha256"],
      "properties": {
        "byte_count": {"type": "integer", "minimum": 0},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "matrixEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation", "principal", "session_user", "current_user", "isolation", "read_only", "sqlstate", "stderr_digest"],
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "principal": {"type": "string", "minLength": 1},
        "session_user": {"type": "string", "minLength": 1},
        "current_user": {"type": "string", "minLength": 1},
        "isolation": {"const": "read committed"},
        "read_only": {"const": false},
        "sqlstate": {"const": "42501"},
        "stderr_digest": {"$ref": "#/$defs/stderrDigest"}
      }
    },
    "transport": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["psql_exit", "stderr_digest"],
          "properties": {
            "psql_exit": {"type": "integer", "minimum": 0},
            "stderr_digest": {"$ref": "#/$defs/stderrDigest"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["matrix", "psql_exit"],
          "properties": {
            "matrix": {
              "type": "array",
              "minItems": 5,
              "maxItems": 5,
              "items": {"$ref": "#/$defs/matrixEntry"}
            },
            "psql_exit": {"type": "integer", "minimum": 1}
          }
        }
      ]
    },
    "scenario": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenario_id", "category", "principal", "transaction_shape",
        "expected_outcome", "observed_outcome", "expected_sqlstate", "observed_sqlstate",
        "expected_failure_id", "observed_failure_id",
        "stable_reason", "session_user", "current_user", "isolation", "read_only", "before", "after",
        "readback_checks", "forbidden_effects_absent", "transport", "passed"
      ],
      "properties": {
        "scenario_id": {"type": "string", "pattern": "^BTR-[ETIRB][0-9]{2}$"},
        "category": {"enum": ["ENTRY_POINT", "TRIGGER", "RLS", "IDEMPOTENCY", "ROLLBACK"]},
        "principal": {"type": "string", "minLength": 1},
        "transaction_shape": {"type": "string", "minLength": 1},
        "expected_outcome": {"type": "string", "minLength": 1},
        "observed_outcome": {"type": "string", "minLength": 1},
        "expected_sqlstate": {"type": ["string", "null"], "pattern": "^[0-9A-Z]{5}$"},
        "observed_sqlstate": {"type": ["string", "null"], "pattern": "^[0-9A-Z]{5}$"},
        "expected_failure_id": {"type": ["string", "null"], "pattern": "^F_[A-Z_]+$"},
        "observed_failure_id": {"type": ["string", "null"], "pattern": "^F_[A-Z_]+$"},
        "stable_reason": {"type": "string", "minLength": 1},
        "session_user": {"type": "string", "minLength": 1},
        "current_user": {"type": "string", "minLength": 1},
        "isolation": {"const": "read committed"},
        "read_only": {"type": "boolean"},
        "before": {"$ref": "#/$defs/snapshot"},
        "after": {"$ref": "#/$defs/snapshot"},
        "readback_checks": {"$ref": "#/$defs/booleanMap"},
        "forbidden_effects_absent": {"$ref": "#/$defs/booleanMap"},
        "transport": {"$ref": "#/$defs/transport"},
        "passed": {"const": true}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "result": {"const": "raisa_provider_free_disposable_postgresql_durability_behavior_transaction_rehearsal_pass"}
        }
      },
      "then": {
        "properties": {
          "parent": {"minProperties": 5},
          "preconditions": {"minItems": 2, "maxItems": 2},
          "scenarios": {"minItems": 20, "maxItems": 20},
          "scenario_reconciliation": {
            "properties": {"observed": {"const": 20}, "passed": {"const": 20}}
          },
          "cleanup": {
            "properties": {"status": {"const": "cleanup_verified"}, "removed": {"const": true}, "absence_verified": {"const": true}}
          }
        }
      }
    }
  ]
}
