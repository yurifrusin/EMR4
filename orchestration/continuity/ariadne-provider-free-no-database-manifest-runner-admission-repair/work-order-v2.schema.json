{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.dev/schemas/ariadne-deepseek-work-order-v2.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "work_order_id",
    "transaction_id",
    "operation_id",
    "lease_id",
    "journal_id",
    "source_commit",
    "authority_sha256",
    "forbidden_surfaces_sha256",
    "command_manifest_sha256",
    "provider_free_no_database_admission_sha256",
    "branch",
    "worktree",
    "allowed_tool_names",
    "posture",
    "next_sequence",
    "previous_event_sha256"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.deepseek_work_order.v2"},
    "work_order_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "transaction_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "operation_id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "lease_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "journal_id": {"type": "string", "minLength": 1, "maxLength": 128},
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "authority_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "forbidden_surfaces_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "command_manifest_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "provider_free_no_database_admission_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "branch": {"type": "string", "minLength": 1, "maxLength": 300},
    "worktree": {"type": "string", "minLength": 1, "maxLength": 1000},
    "allowed_tool_names": {"const": ["edit", "glob", "read"]},
    "posture": {"const": "provider_free_shadow"},
    "next_sequence": {"type": "integer", "minimum": 1},
    "previous_event_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}
  }
}
