{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_id", "attempt_id", "candidate_source",
    "result", "terminal", "process_envelope_sha256",
    "raw_runtime_detail_retained", "further_process_authorized"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.native_harness_root_service_forwarding_isolated_node_failure_terminal.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-preset-mount-root-service-forwarding-isolated-node-fixture-rehearsal"},
    "attempt_id": {"const": "attempt-001"},
    "candidate_source": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "result": {"enum": ["fixture_process_terminal", "fixture_result_rejected"]},
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "detail"],
      "properties": {
        "stage": {"const": "isolated_node_fixture"},
        "code": {"enum": ["fixture_process_terminal", "fixture_result_rejected"]},
        "detail": {"type": "null"}
      }
    },
    "process_envelope_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "raw_runtime_detail_retained": {"const": false},
    "further_process_authorized": {"const": false}
  }
}
