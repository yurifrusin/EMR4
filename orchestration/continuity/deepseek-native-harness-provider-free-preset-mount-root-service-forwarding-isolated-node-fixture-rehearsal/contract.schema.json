{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "git_binding_policy",
    "documentation_bindings",
    "predecessor_bindings",
    "implementation_bindings",
    "accepted_source_inventory",
    "fixture_source_inventory",
    "case_ids",
    "expected_result",
    "windows_environment_keys",
    "closed_results",
    "required_zero_counters",
    "claim_boundary"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.native_harness_root_service_forwarding_isolated_node_fixture_contract.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-preset-mount-root-service-forwarding-isolated-node-fixture-rehearsal"},
    "git_binding_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "plan_path", "controller_path", "caller_authored_object_id_count"],
      "properties": {
        "mode": {"const": "machine_resolved_only"},
        "plan_path": {"const": "docs/deepseek-native-harness-provider-free-preset-mount-root-service-forwarding-isolated-node-fixture-rehearsal-plan.md"},
        "controller_path": {"const": "scripts/deepseek_native_harness_provider_free_preset_mount_root_service_forwarding_isolated_node_fixture_rehearsal.py"},
        "caller_authored_object_id_count": {"const": 0}
      }
    },
    "documentation_bindings": {"$ref": "#/$defs/hashMap"},
    "predecessor_bindings": {"$ref": "#/$defs/hashMap"},
    "implementation_bindings": {"$ref": "#/$defs/hashMap"},
    "accepted_source_inventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["derived_bridge", "accepted_sanitizer"],
      "properties": {
        "derived_bridge": {"$ref": "#/$defs/sourceEntry"},
        "accepted_sanitizer": {"$ref": "#/$defs/sourceEntry"}
      }
    },
    "fixture_source_inventory": {"$ref": "#/$defs/sourceEntry"},
    "case_ids": {
      "type": "array",
      "prefixItems": [
        {"const": "success"},
        {"const": "missing_service"},
        {"const": "missing_mount"}
      ],
      "items": false,
      "minItems": 3,
      "maxItems": 3
    },
    "expected_result": {"$ref": "#/$defs/fixtureResult"},
    "windows_environment_keys": {
      "type": "array",
      "prefixItems": [
        {"const": "SystemRoot"},
        {"const": "WINDIR"},
        {"const": "ComSpec"},
        {"const": "TEMP"},
        {"const": "TMP"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "closed_results": {
      "type": "array",
      "prefixItems": [
        {"const": "isolated_node_fixture_pass"},
        {"const": "fixture_preflight_rejected"},
        {"const": "fixture_process_terminal"},
        {"const": "fixture_result_rejected"}
      ],
      "items": false,
      "minItems": 4,
      "maxItems": 4
    },
    "required_zero_counters": {
      "type": "array",
      "items": {"type": "string", "minLength": 1},
      "minItems": 14,
      "maxItems": 14,
      "uniqueItems": true
    },
    "claim_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "isolated_bridge_behavior_only",
        "runner_guard_graph_proved",
        "native_harness_proved",
        "worker_model_provider_executed",
        "retry_authorized",
        "product_authority"
      ],
      "properties": {
        "isolated_bridge_behavior_only": {"const": true},
        "runner_guard_graph_proved": {"const": false},
        "native_harness_proved": {"const": false},
        "worker_model_provider_executed": {"const": false},
        "retry_authorized": {"const": false},
        "product_authority": {"const": false}
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "hashMap": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/hash"}
    },
    "sourceEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bytes", "sha256"],
      "properties": {
        "bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "terminal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage", "code", "detail"],
      "properties": {
        "stage": {"const": "preset_mount"},
        "code": {"const": "PRESET_MOUNT_UNCLASSIFIED"},
        "detail": {"type": "null"}
      }
    },
    "fixtureResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "result", "cases"],
      "properties": {
        "schema_version": {"const": "ariadne.native_harness_root_service_forwarding_isolated_fixture_result.v1"},
        "result": {"const": "pass"},
        "cases": {
          "type": "array",
          "prefixItems": [
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["case_id", "passed", "terminal", "mount_call_count", "receiver_bound", "context_forwarded", "preset_id_forwarded"],
              "properties": {
                "case_id": {"const": "success"},
                "passed": {"const": true},
                "terminal": {"type": "null"},
                "mount_call_count": {"const": 1},
                "receiver_bound": {"const": true},
                "context_forwarded": {"const": true},
                "preset_id_forwarded": {"const": true}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["case_id", "passed", "terminal"],
              "properties": {
                "case_id": {"const": "missing_service"},
                "passed": {"const": false},
                "terminal": {"$ref": "#/$defs/terminal"}
              }
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": ["case_id", "passed", "terminal"],
              "properties": {
                "case_id": {"const": "missing_mount"},
                "passed": {"const": false},
                "terminal": {"$ref": "#/$defs/terminal"}
              }
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        }
      }
    }
  }
}
