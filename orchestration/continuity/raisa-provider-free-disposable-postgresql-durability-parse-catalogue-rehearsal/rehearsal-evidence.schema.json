{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/disposable-postgresql-durability-rehearsal-evidence-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "result", "evidence_mode", "attempt_id", "parent", "environment", "lifecycle", "rollback", "catalogue", "cleanup", "claim_boundary"],
  "properties": {
    "schema_version": {"const": "emr4.disposable-postgresql-durability-rehearsal-evidence.v1"},
    "result": {"enum": ["raisa_provider_free_disposable_postgresql_durability_parse_catalogue_rehearsal_pass", "environment_unavailable", "rehearsal_failed", "cleanup_ownership_unverified"]},
    "evidence_mode": {"const": "provider_free_disposable_local_postgresql_authored_synthetic"},
    "attempt_id": {"type": "string"},
    "parent": {"type": "object"},
    "environment": {"type": "object"},
    "lifecycle": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
    "rollback": {"type": "object"},
    "catalogue": {"type": "object"},
    "cleanup": {"type": "object"},
    "claim_boundary": {"const": "postgresql_16_exact_artifact_parse_atomic_installation_and_catalogue_shape_only"}
  }
}
