{
  "title": "Ariadne Common Provider Draft Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": ["drafts"],
  "properties": {
    "drafts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "batch_id",
          "attempt_id",
          "output_port_id",
          "frame_type",
          "authority_class",
          "practice_id",
          "principal_id",
          "correlation_id",
          "context_revision",
          "source_frame_ids",
          "payload",
          "provenance",
          "freshness"
        ],
        "properties": {
          "id": {
            "type": "string",
            "enum": [
              "draft-ux-primary",
              "draft-human-primary",
              "draft-audit-primary",
              "draft-orchestrator-primary",
              "draft-advisory-primary"
            ]
          },
          "batch_id": {
            "type": "string",
            "enum": ["generated-batch-001"]
          },
          "attempt_id": {
            "type": "string",
            "enum": ["generated-attempt-001"]
          },
          "output_port_id": {
            "type": "string",
            "enum": [
              "port-ux",
              "port-human-review",
              "port-audit",
              "port-orchestrator",
              "port-advisory"
            ]
          },
          "frame_type": {
            "type": "string",
            "enum": [
              "booking-ux-projection-candidate.v1",
              "booking-human-review-candidate.v1",
              "work-cell-audit-evidence.v1",
              "work-cell-outcome.v1",
              "booking-explanation-advisory.v1"
            ]
          },
          "authority_class": {
            "type": "string",
            "enum": ["candidate", "evidence", "advisory"]
          },
          "practice_id": {
            "type": "string",
            "enum": ["practice-synth-a"]
          },
          "principal_id": {
            "type": "string",
            "enum": ["principal-reception"]
          },
          "correlation_id": {
            "type": "string",
            "enum": ["booking-request-001"]
          },
          "context_revision": {
            "type": "integer",
            "enum": [7]
          },
          "source_frame_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 5,
            "items": {
              "type": "string",
              "enum": [
                "input-request-scope",
                "input-principal-scope",
                "input-patient-candidates",
                "input-practitioner",
                "input-availability",
                "input-policy"
              ]
            }
          },
          "payload": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "patient_candidate_id",
                  "practitioner_id",
                  "candidate_slot_ids",
                  "selected_slot_id",
                  "duration_minutes",
                  "projection_code",
                  "context_revision"
                ],
                "properties": {
                  "patient_candidate_id": {
                    "type": "string",
                    "enum": ["patient-candidate-a", "patient-candidate-b"]
                  },
                  "practitioner_id": {
                    "type": "string",
                    "enum": ["practitioner-a"]
                  },
                  "candidate_slot_ids": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "enum": ["slot-1430", "slot-1500", "slot-1530"]
                    }
                  },
                  "selected_slot_id": {
                    "type": "string",
                    "enum": ["slot-1430", "slot-1500", "slot-1530"]
                  },
                  "duration_minutes": {
                    "type": "integer",
                    "enum": [30]
                  },
                  "projection_code": {
                    "type": "string",
                    "enum": ["show-ranked-slots"]
                  },
                  "context_revision": {
                    "type": "integer",
                    "enum": [7]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "patient_candidate_id",
                  "practitioner_id",
                  "candidate_slot_ids",
                  "selected_slot_id",
                  "duration_minutes",
                  "review_reason_codes",
                  "confirmation_required",
                  "context_revision"
                ],
                "properties": {
                  "patient_candidate_id": {
                    "type": "string",
                    "enum": ["patient-candidate-a", "patient-candidate-b"]
                  },
                  "practitioner_id": {
                    "type": "string",
                    "enum": ["practitioner-a"]
                  },
                  "candidate_slot_ids": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "enum": ["slot-1430", "slot-1500", "slot-1530"]
                    }
                  },
                  "selected_slot_id": {
                    "type": "string",
                    "enum": ["slot-1430", "slot-1500", "slot-1530"]
                  },
                  "duration_minutes": {
                    "type": "integer",
                    "enum": [30]
                  },
                  "review_reason_codes": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "enum": [
                        "identity-candidate-requires-staff-review",
                        "appointment-write-requires-separate-command"
                      ]
                    }
                  },
                  "confirmation_required": {
                    "type": "boolean"
                  },
                  "context_revision": {
                    "type": "integer",
                    "enum": [7]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "outcome_code",
                  "attempt_id",
                  "evidence_codes",
                  "context_revision"
                ],
                "properties": {
                  "outcome_code": {
                    "type": "string",
                    "enum": ["candidate-prepared"]
                  },
                  "attempt_id": {
                    "type": "string",
                    "enum": ["generated-attempt-001"]
                  },
                  "evidence_codes": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "enum": ["grounded-context", "human-authority-required"]
                    }
                  },
                  "context_revision": {
                    "type": "integer",
                    "enum": [7]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "status",
                  "completed_port_ids",
                  "context_revision"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "enum": ["candidate-prepared"]
                  },
                  "completed_port_ids": {
                    "type": "array",
                    "minItems": 5,
                    "maxItems": 5,
                    "items": {
                      "type": "string",
                      "enum": [
                        "port-ux",
                        "port-human-review",
                        "port-audit",
                        "port-orchestrator",
                        "port-advisory"
                      ]
                    }
                  },
                  "context_revision": {
                    "type": "integer",
                    "enum": [7]
                  }
                }
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "advisory_code",
                  "grounding_ids",
                  "context_revision"
                ],
                "properties": {
                  "advisory_code": {
                    "type": "string",
                    "enum": ["candidate-ranking-explanation-available"]
                  },
                  "grounding_ids": {
                    "type": "array",
                    "minItems": 2,
                    "maxItems": 2,
                    "items": {
                      "type": "string",
                      "enum": ["slot-1430", "practitioner-a"]
                    }
                  },
                  "context_revision": {
                    "type": "integer",
                    "enum": [7]
                  }
                }
              }
            ]
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "source"],
            "properties": {
              "kind": {
                "type": "string",
                "enum": ["model-generated-draft"]
              },
              "source": {
                "type": "string",
                "enum": ["generated-attempt-001"]
              }
            }
          },
          "freshness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["status", "observed_at", "maximum_age_seconds"],
            "properties": {
              "status": {
                "type": "string",
                "enum": ["current"]
              },
              "observed_at": {
                "type": "string",
                "enum": ["2026-07-23T09:00:10+10:00"]
              },
              "maximum_age_seconds": {
                "type": "integer",
                "enum": [300]
              }
            }
          }
        }
      }
    }
  }
}
