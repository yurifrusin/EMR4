{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/waiting-area-movement-command-family-readiness-review-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_head", "input_hash_mode", "inputs", "classifications", "verdict_rules", "dimensions", "non_overlap", "acceptance", "forbidden_surfaces"],
  "properties": {
    "schema_version": {"const": "raisa.waiting_area_movement_command_family_readiness_review_contract.v1"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_hash_mode": {"const": "strict_utf8_canonical_lf_reject_bare_cr_sha256"},
    "inputs": {
      "type": "array", "minItems": 16, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
        "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
      }
    },
    "classifications": {"const": ["satisfied", "blocking_gap"]},
    "verdict_rules": {"type": "object"},
    "dimensions": {
      "type": "array", "minItems": 12, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["order", "id", "expected_classification", "question"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 12},
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "expected_classification": {"enum": ["satisfied", "blocking_gap"]},
          "question": {"type": "string", "minLength": 1}
        }
      }
    },
    "non_overlap": {"type": "object"},
    "acceptance": {"type": "object"},
    "forbidden_surfaces": {"type": "array", "minItems": 6, "items": {"type": "string", "minLength": 1}}
  }
}
