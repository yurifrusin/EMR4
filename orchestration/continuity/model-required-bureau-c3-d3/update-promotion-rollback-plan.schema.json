{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/update-promotion-rollback-plan.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "promotion_plan_id", "update_class", "future_command_family", "provenance_delta_sha256", "source_artifact_sha256", "provenance_admission", "target_expected_revision", "expires_at", "shadow", "validation", "canary", "review", "activation", "audit", "readback", "last_known_good_rollback", "current_state", "activation_authorized", "rollback_authorized"],
  "properties": {
    "schema_version": {"const": "emr4.update_promotion_rollback_plan.v1"},
    "promotion_plan_id": {"type": "string", "format": "uuid"},
    "update_class": {"enum": ["application_dependency_build", "database_schema_migration", "reference_dataset", "operational_clinical_policy"]},
    "future_command_family": {"enum": ["application_build_promotion", "database_migration_promotion", "reference_dataset_activation", "policy_content_activation"]},
    "provenance_delta_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "source_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "provenance_admission": {
      "type": "object", "additionalProperties": false,
      "required": ["attestation_scheme", "signer_id", "trust_anchor_set_version", "verified_at", "licence_decision", "source_lifecycle", "admission_sha256"],
      "properties": {
        "attestation_scheme": {"enum": ["synthetic_signature_fixture", "synthetic_attestation_fixture"]},
        "signer_id": {"type": "string", "pattern": "^synthetic:[a-z0-9.-]+$"},
        "trust_anchor_set_version": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "verified_at": {"type": "string", "format": "date-time"},
        "licence_decision": {"const": "synthetic_admitted_for_schema_test"},
        "source_lifecycle": {"const": "active"},
        "admission_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "target_expected_revision": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "expires_at": {"type": "string", "format": "date-time"},
    "shadow": {
      "type": "object", "additionalProperties": false,
      "required": ["namespace", "quarantined", "authoritative_reads", "import_performed"],
      "properties": {
        "namespace": {"type": "string", "pattern": "^synthetic:[a-z0-9.-]+$"},
        "quarantined": {"const": true},
        "authoritative_reads": {"const": false},
        "import_performed": {"const": false}
      }
    },
    "validation": {
      "type": "object", "additionalProperties": false,
      "required": ["required_checks", "validation_performed"],
      "properties": {
        "required_checks": {"type": "array", "minItems": 7, "uniqueItems": true, "items": {"enum": ["source_identity", "licence", "checksum", "schema", "jurisdiction", "lifecycle", "semantic_delta", "compatibility", "withdrawal", "rollback_feasibility", "backup_restore_evidence"]}},
        "validation_performed": {"const": false}
      }
    },
    "canary": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "scope_id", "maximum_targets", "performed"],
      "properties": {
        "kind": {"enum": ["single_disposable_instance", "empty_schema_clone", "synthetic_dataset_namespace", "draft_policy_audience"]},
        "scope_id": {"type": "string", "pattern": "^synthetic:[a-z0-9.-]+$"},
        "maximum_targets": {"const": 1},
        "performed": {"const": false}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["required_authority", "minimum_reviewer_count", "required_roles", "authenticated_evidence_required", "distinct_reviewers_required", "candidate_generator_may_review", "provider_may_review", "pre_canary_review_required", "post_canary_pre_activation_review_required", "approvals_collected"],
      "properties": {
        "required_authority": {"enum": ["maintenance_release_authority", "dual_review"]},
        "minimum_reviewer_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "required_roles": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "authenticated_evidence_required": {"const": true},
        "distinct_reviewers_required": {"type": "boolean"},
        "candidate_generator_may_review": {"const": false},
        "provider_may_review": {"const": false},
        "pre_canary_review_required": {"const": true},
        "post_canary_pre_activation_review_required": {"const": true},
        "approvals_collected": {"const": 0}
      }
    },
    "activation": {
      "type": "object", "additionalProperties": false,
      "required": ["future_command_family", "class_specific_barrier", "atomicity", "expected_target_revision", "immediate_revalidation_required", "performed"],
      "properties": {
        "future_command_family": {"enum": ["application_build_promotion", "database_migration_promotion", "reference_dataset_activation", "policy_content_activation"]},
        "class_specific_barrier": {"enum": ["release_pointer_compare_and_swap", "migration_transaction_or_maintenance_barrier", "immutable_dataset_pointer_compare_and_swap", "versioned_policy_pointer_compare_and_swap"]},
        "atomicity": {"const": "single_class_specific_transaction_or_pointer_swap"},
        "expected_target_revision": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
        "immediate_revalidation_required": {"const": true},
        "performed": {"const": false}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["immutable", "required_fields", "append_performed"],
      "properties": {
        "immutable": {"const": true},
        "required_fields": {"type": "array", "minItems": 10, "uniqueItems": true, "items": {"enum": ["promotion_plan_id", "update_class", "source_artifact_sha256", "provenance_delta_sha256", "before_revision", "after_revision", "review_evidence", "actor", "correlation_id", "idempotency_key", "activation_receipt", "readback_receipt", "rollback_receipt"]}},
        "append_performed": {"const": false}
      }
    },
    "readback": {
      "type": "object", "additionalProperties": false,
      "required": ["source", "postconditions", "performed", "success_claimed"],
      "properties": {
        "source": {"const": "fresh_authoritative_read"},
        "postconditions": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "performed": {"const": false},
        "success_claimed": {"const": false}
      }
    },
    "last_known_good_rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target_sha256", "currently_eligible", "source_lifecycle", "compatibility_verified", "separate_authority_required", "atomic", "fresh_readback_required", "performed"],
      "properties": {
        "kind": {"enum": ["restore_previous_artifact", "down_migration_or_restore_candidate", "restore_previous_dataset", "restore_previous_policy"]},
        "target_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "currently_eligible": {"const": true},
        "source_lifecycle": {"enum": ["active", "not_applicable"]},
        "compatibility_verified": {"const": true},
        "separate_authority_required": {"const": true},
        "atomic": {"const": true},
        "fresh_readback_required": {"const": true},
        "performed": {"const": false}
      }
    },
    "current_state": {"const": "architecture_only_not_executable"},
    "activation_authorized": {"const": false},
    "rollback_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"update_class": {"const": "application_dependency_build"}}},
      "then": {"properties": {
        "future_command_family": {"const": "application_build_promotion"},
        "canary": {"properties": {"kind": {"const": "single_disposable_instance"}}},
        "review": {"properties": {"required_authority": {"const": "maintenance_release_authority"}, "minimum_reviewer_count": {"const": 1}, "required_roles": {"const": ["release_authority"]}, "distinct_reviewers_required": {"const": false}}},
        "activation": {"properties": {"future_command_family": {"const": "application_build_promotion"}, "class_specific_barrier": {"const": "release_pointer_compare_and_swap"}}},
        "last_known_good_rollback": {"properties": {"kind": {"const": "restore_previous_artifact"}, "source_lifecycle": {"const": "not_applicable"}}}
      }}
    },
    {
      "if": {"properties": {"update_class": {"const": "database_schema_migration"}}},
      "then": {"properties": {
        "future_command_family": {"const": "database_migration_promotion"},
        "canary": {"properties": {"kind": {"const": "empty_schema_clone"}}},
        "review": {"properties": {"required_authority": {"const": "dual_review"}, "minimum_reviewer_count": {"const": 2}, "required_roles": {"const": ["database_custodian", "release_authority"]}, "distinct_reviewers_required": {"const": true}}},
        "activation": {"properties": {"future_command_family": {"const": "database_migration_promotion"}, "class_specific_barrier": {"const": "migration_transaction_or_maintenance_barrier"}}},
        "last_known_good_rollback": {"properties": {"kind": {"const": "down_migration_or_restore_candidate"}, "source_lifecycle": {"const": "not_applicable"}}}
      }}
    },
    {
      "if": {"properties": {"update_class": {"const": "reference_dataset"}}},
      "then": {"properties": {
        "future_command_family": {"const": "reference_dataset_activation"},
        "canary": {"properties": {"kind": {"const": "synthetic_dataset_namespace"}}},
        "review": {"properties": {"required_authority": {"const": "dual_review"}, "minimum_reviewer_count": {"const": 2}, "required_roles": {"const": ["data_steward", "clinical_governance_reviewer"]}, "distinct_reviewers_required": {"const": true}}},
        "activation": {"properties": {"future_command_family": {"const": "reference_dataset_activation"}, "class_specific_barrier": {"const": "immutable_dataset_pointer_compare_and_swap"}}},
        "last_known_good_rollback": {"properties": {"kind": {"const": "restore_previous_dataset"}, "source_lifecycle": {"const": "active"}}}
      }}
    },
    {
      "if": {"properties": {"update_class": {"const": "operational_clinical_policy"}}},
      "then": {"properties": {
        "future_command_family": {"const": "policy_content_activation"},
        "canary": {"properties": {"kind": {"const": "draft_policy_audience"}}},
        "review": {"properties": {"required_authority": {"const": "dual_review"}, "minimum_reviewer_count": {"const": 2}, "required_roles": {"const": ["policy_owner", "clinical_governance_reviewer"]}, "distinct_reviewers_required": {"const": true}}},
        "activation": {"properties": {"future_command_family": {"const": "policy_content_activation"}, "class_specific_barrier": {"const": "versioned_policy_pointer_compare_and_swap"}}},
        "last_known_good_rollback": {"properties": {"kind": {"const": "restore_previous_policy"}, "source_lifecycle": {"const": "active"}}}
      }}
    }
  ]
}
