{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/model-required-bureau-c3-d3-contract.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "source_head", "result", "evidence_label", "provider_required_for_intelligent_runtime", "provider_free_end_to_end_claim", "c3", "d3", "api_spine", "authority_and_side_effects"],
  "properties": {
    "schema_version": {"const": "emr4.model_required_bureau_c3_d3_contract.v1"},
    "source_head": {"const": "3008cdb4d7b5801c45024f7361fb4294aa76fc48"},
    "result": {"const": "model_required_bureau_c3_d3_provider_free_architecture_pass"},
    "evidence_label": {"const": "provider_free_c3_d3_architecture_and_proof"},
    "provider_required_for_intelligent_runtime": {"const": true},
    "provider_free_end_to_end_claim": {"const": false},
    "c3": {
      "type": "object", "additionalProperties": false,
      "required": ["risk_policy_version", "candidate_may_set_final_risk", "risk_is_monotone", "tiers", "forbidden_operation_classes", "execution_authorized"],
      "properties": {
        "risk_policy_version": {"const": "emr4.recovery_risk_policy.v1"},
        "candidate_may_set_final_risk": {"const": false},
        "risk_is_monotone": {"const": true},
        "tiers": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"$ref": "#/$defs/riskTier"}},
        "forbidden_operation_classes": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "execution_authorized": {"const": false}
      }
    },
    "d3": {
      "type": "object", "additionalProperties": false,
      "required": ["generic_update_command", "stage_sequence", "fail_closed_states", "classes", "shadow_reads_authoritative", "activation_authorized", "rollback_authorized"],
      "properties": {
        "generic_update_command": {"const": false},
        "stage_sequence": {"type": "array", "minItems": 10, "maxItems": 10, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "fail_closed_states": {"type": "array", "minItems": 7, "maxItems": 7, "uniqueItems": true, "items": {"enum": ["rejected", "quarantined", "expired", "superseded", "activation_unverified", "rollback_unverified", "incident_locked"]}},
        "classes": {"type": "array", "minItems": 4, "maxItems": 4, "items": {"$ref": "#/$defs/updateClass"}},
        "shadow_reads_authoritative": {"const": false},
        "activation_authorized": {"const": false},
        "rollback_authorized": {"const": false}
      }
    },
    "api_spine": {
      "type": "object", "additionalProperties": false,
      "required": ["reads", "commands", "events", "manifests", "access_ai"],
      "properties": {
        "reads": {"const": "graphql_authorized_read_only_plan_status_and_readback"},
        "commands": {"const": "rest_openapi_class_specific_separately_closed"},
        "events": {"const": "committed_hints_require_fresh_authorized_read"},
        "manifests": {"const": "declarative_evidence_never_command_authority"},
        "access_ai": {"const": "closed"}
      }
    },
    "authority_and_side_effects": {
      "type": "object", "minProperties": 19, "maxProperties": 19,
      "additionalProperties": {"const": 0}
    }
  },
  "$defs": {
    "riskTier": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "required_authority", "minimum_reviewer_count", "required_roles", "separation_of_duties", "future_one_use_execution_evidence", "actuator_eligible"],
      "properties": {
        "id": {"enum": ["observe_explain_only", "reversible_scoped_service_recovery", "human_approved_rollback_or_failover", "dual_review_database_security_or_data_supply", "forbidden_autonomous_action"]},
        "required_authority": {"enum": ["observe_only", "ordinary_confirmation", "maintenance_release_authority", "dual_review", "forbidden"]},
        "minimum_reviewer_count": {"type": "integer", "minimum": 0, "maximum": 2},
        "required_roles": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "separation_of_duties": {"type": "boolean"},
        "future_one_use_execution_evidence": {"type": "boolean"},
        "actuator_eligible": {"type": "boolean"}
      }
    },
    "updateClass": {
      "type": "object", "additionalProperties": false,
      "required": ["update_class", "future_command_family", "canary_kind", "required_authority", "minimum_reviewer_count", "required_roles", "rollback_kind"],
      "properties": {
        "update_class": {"enum": ["application_dependency_build", "database_schema_migration", "reference_dataset", "operational_clinical_policy"]},
        "future_command_family": {"enum": ["application_build_promotion", "database_migration_promotion", "reference_dataset_activation", "policy_content_activation"]},
        "canary_kind": {"enum": ["single_disposable_instance", "empty_schema_clone", "synthetic_dataset_namespace", "draft_policy_audience"]},
        "required_authority": {"enum": ["maintenance_release_authority", "dual_review"]},
        "minimum_reviewer_count": {"type": "integer", "minimum": 1, "maximum": 2},
        "required_roles": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
        "rollback_kind": {"enum": ["restore_previous_artifact", "down_migration_or_restore_candidate", "restore_previous_dataset", "restore_previous_policy"]}
      }
    }
  }
}
