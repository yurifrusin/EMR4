{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/recovery-authority-decision.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "decision_id", "plan_id", "plan_revision", "plan_sha256", "policy_version", "computed_risk_tier", "required_authority", "minimum_reviewer_count", "required_roles", "separation_of_duties", "candidate_risk_overridden", "future_one_use_execution_evidence", "effective_expiry", "plan_change_invalidates_reviews", "current_state", "denial_codes", "command_envelope_issued", "actuator_gate", "execution_authorized"],
  "properties": {
    "schema_version": {"const": "emr4.recovery_authority_decision.v1"},
    "decision_id": {"type": "string", "format": "uuid"},
    "plan_id": {"type": "string", "format": "uuid"},
    "plan_revision": {"type": "integer", "minimum": 1},
    "plan_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "policy_version": {"const": "emr4.recovery_risk_policy.v1"},
    "computed_risk_tier": {"enum": ["observe_explain_only", "reversible_scoped_service_recovery", "human_approved_rollback_or_failover", "dual_review_database_security_or_data_supply", "forbidden_autonomous_action"]},
    "required_authority": {"enum": ["observe_only", "ordinary_confirmation", "maintenance_release_authority", "dual_review", "forbidden"]},
    "minimum_reviewer_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "required_roles": {"type": "array", "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}},
    "separation_of_duties": {"type": "boolean"},
    "candidate_risk_overridden": {"type": "boolean"},
    "future_one_use_execution_evidence": {"type": "boolean"},
    "effective_expiry": {"type": "string", "format": "date-time"},
    "plan_change_invalidates_reviews": {"const": true},
    "current_state": {"enum": ["observe_release", "review_required", "denied", "expired", "superseded"]},
    "denial_codes": {"type": "array", "maxItems": 8, "uniqueItems": true, "items": {"enum": ["SCHEMA_REJECTED", "STALE_OR_SUPERSEDED", "UNKNOWN_RUNBOOK", "UNKNOWN_EVIDENCE", "EXECUTABLE_CONTENT", "RISK_TIER_MISMATCH", "ROLLBACK_UNPROVEN", "BLAST_RADIUS_FORBIDDEN", "OPERATION_FORBIDDEN"]}},
    "command_envelope_issued": {"const": false},
    "actuator_gate": {"const": "closed"},
    "execution_authorized": {"const": false}
  }
}
