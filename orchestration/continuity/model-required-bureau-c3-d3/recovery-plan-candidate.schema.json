{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/recovery-plan-candidate.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "diagnosis_candidate_id", "anatomy_frame_id", "anatomy_version", "context_sha256", "runbook_id", "candidate_integrity", "proposed_risk_tier", "preconditions", "environment", "target", "operation_class", "expected_effect", "maximum_blast_radius", "reversibility", "rollback", "expires_at", "supersession_key", "idempotency", "audit", "postconditions", "authority_ceiling", "execution_authorized"],
  "properties": {
    "schema_version": {"const": "emr4.recovery_plan_candidate.v1"},
    "plan_id": {"type": "string", "format": "uuid"},
    "diagnosis_candidate_id": {"type": "string", "format": "uuid"},
    "anatomy_frame_id": {"type": "string", "format": "uuid"},
    "anatomy_version": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "context_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "runbook_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "candidate_integrity": {"const": "untrusted_model_fixture"},
    "proposed_risk_tier": {"enum": ["observe_explain_only", "reversible_scoped_service_recovery", "human_approved_rollback_or_failover", "dual_review_database_security_or_data_supply", "forbidden_autonomous_action"]},
    "preconditions": {
      "type": "array", "minItems": 1, "maxItems": 12,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["observation_id", "expected_sha256", "must_be_fresh"],
        "properties": {
          "observation_id": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
          "expected_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "must_be_fresh": {"const": true}
        }
      }
    },
    "environment": {"enum": ["isolated_authored_synthetic", "isolated_development", "staging", "production"]},
    "target": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "target_id", "expected_revision"],
      "properties": {
        "kind": {"enum": ["observation", "service", "component", "database", "security_control", "data_supply", "multi_environment", "unknown"]},
        "target_id": {"type": "string", "pattern": "^synthetic:[a-z0-9.-]+$"},
        "expected_revision": {"type": "string", "pattern": "^[a-z0-9.-]+$"}
      }
    },
    "operation_class": {"enum": ["observe", "scoped_service_recovery", "rollback", "failover", "database_operation", "security_operation", "data_supply_operation", "generic_shell", "generic_sql", "generic_cloud", "credential_change", "authority_policy_change", "unallowlisted_operation"]},
    "expected_effect": {"type": "string", "minLength": 3, "maxLength": 240},
    "maximum_blast_radius": {"enum": ["observation_only", "single_process", "single_service", "single_environment", "multi_environment_or_unknown"]},
    "reversibility": {"enum": ["not_applicable", "deterministic_rollback_proven", "conditional_or_unknown", "irreversible"]},
    "rollback": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "runbook_id", "target_sha256"],
      "properties": {
        "kind": {"enum": ["none", "signed_runbook", "last_known_good"]},
        "runbook_id": {"type": ["string", "null"], "pattern": "^[a-z0-9.-]+$"},
        "target_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "expires_at": {"type": "string", "format": "date-time"},
    "supersession_key": {"type": "string", "pattern": "^[a-z0-9.-]+$"},
    "idempotency": {
      "type": "object", "additionalProperties": false,
      "required": ["scope", "binding_fields", "effective_key_issued"],
      "properties": {
        "scope": {"const": "recovery_plan_candidate"},
        "binding_fields": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"enum": ["plan_sha256", "operation_class", "environment", "target_expected_revision", "runbook_id", "context_sha256", "authority_decision_id", "correlation_id"]}},
        "effective_key_issued": {"const": false}
      }
    },
    "audit": {
      "type": "object", "additionalProperties": false,
      "required": ["correlation_id", "immutable", "required_fields"],
      "properties": {
        "correlation_id": {"type": "string", "format": "uuid"},
        "immutable": {"const": true},
        "required_fields": {"type": "array", "minItems": 8, "uniqueItems": true, "items": {"enum": ["plan_id", "plan_sha256", "diagnosis_candidate_id", "anatomy_version", "context_sha256", "runbook_id", "computed_risk_tier", "authority_decision_id", "target_revision", "effective_idempotency_key", "postcondition_receipt"]}}
      }
    },
    "postconditions": {
      "type": "array", "minItems": 1, "maxItems": 8,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["observation_kind", "expected_state", "fresh_authoritative_read_required"],
        "properties": {
          "observation_kind": {"enum": ["service_version", "component_version", "deployment_manifest_reference", "database_schema_head", "dependency_state", "health_signal", "capacity_signal", "sanitized_error_class", "backup_verification", "configuration_drift", "signed_runbook_catalog_reference"]},
          "expected_state": {"type": "string", "minLength": 2, "maxLength": 120},
          "fresh_authoritative_read_required": {"const": true}
        }
      }
    },
    "authority_ceiling": {"const": "recovery_plan_candidate"},
    "execution_authorized": {"const": false}
  }
}
