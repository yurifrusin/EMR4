{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/ariadne-bounded-cognitive-work-cell.schema.json",
  "title": "Ariadne Bounded Cognitive Work Cell Protocol",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "workflow_id",
    "operational_graph_revision",
    "revision",
    "title",
    "as_of",
    "authority",
    "node_granularity_policy",
    "execution_classes",
    "nodes",
    "input_frames",
    "output_ports",
    "work_cell_attempts",
    "draft_frames",
    "verification_policy",
    "verification_cases",
    "fresh_read_grants",
    "retry_traces",
    "human_gate_policy",
    "atomic_output_groups",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.bounded_cognitive_work_cell.v1"},
    "protocol_id": {"$ref": "#/$defs/id"},
    "workflow_id": {"$ref": "#/$defs/id"},
    "operational_graph_revision": {"type": "integer", "minimum": 1},
    "revision": {"type": "integer", "minimum": 1},
    "title": {"type": "string", "minLength": 1},
    "as_of": {"$ref": "#/$defs/timestamp"},
    "authority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authored_synthetic_only", "advisory_only", "execution_enabled", "default_decision", "evidence_label", "closed_boundaries"],
      "properties": {
        "authored_synthetic_only": {"const": true},
        "advisory_only": {"const": true},
        "execution_enabled": {"const": false},
        "default_decision": {"const": "deny"},
        "evidence_label": {"const": "authored_synthetic_repository_local_non_executing"},
        "closed_boundaries": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "node_granularity_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["principle", "cognitive_unit", "topology_is_not_isolation", "agent_eligibility_does_not_start_container", "future_agentisation_requires_new_generation", "split_triggers"],
      "properties": {
        "principle": {"const": "coarse-cognition-fine-authority"},
        "cognitive_unit": {"const": "one-coherent-bounded-task"},
        "topology_is_not_isolation": {"const": true},
        "agent_eligibility_does_not_start_container": {"const": true},
        "future_agentisation_requires_new_generation": {"const": true},
        "split_triggers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "execution_classes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/executionClass"}},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}},
    "input_frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/inputFrame"}},
    "output_ports": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/outputPort"}},
    "work_cell_attempts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/attempt"}},
    "draft_frames": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/draftFrame"}},
    "verification_policy": {"$ref": "#/$defs/verificationPolicy"},
    "verification_cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/verificationCase"}},
    "fresh_read_grants": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/freshReadGrant"}},
    "retry_traces": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/retryTrace"}},
    "human_gate_policy": {"$ref": "#/$defs/humanGatePolicy"},
    "atomic_output_groups": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/atomicGroup"}},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "timestamp": {"type": "string", "format": "date-time"},
    "authorityClass": {"enum": ["evidence", "advisory", "candidate", "verified-fact", "command"]},
    "executionClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "agent_eligible", "container_required_if_executed", "authority_ceiling"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "agent_eligible": {"type": "boolean"},
        "container_required_if_executed": {"type": "boolean"},
        "authority_ceiling": {"type": "string", "minLength": 1}
      }
    },
    "containerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dry_run", "container_started", "generation", "policy_revision", "isolation_requirement"],
      "properties": {
        "dry_run": {"const": true},
        "container_started": {"const": false},
        "generation": {"type": "integer", "minimum": 1},
        "policy_revision": {"type": "integer", "minimum": 1},
        "isolation_requirement": {"type": "string", "minLength": 1}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "instance", "topological_role", "execution_class", "agent_eligible", "agent_attached", "container_policy", "state"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "role": {"$ref": "#/$defs/id"},
        "instance": {"$ref": "#/$defs/id"},
        "topological_role": {"enum": ["source", "interior", "leaf", "sink"]},
        "execution_class": {"$ref": "#/$defs/id"},
        "agent_eligible": {"type": "boolean"},
        "agent_attached": {"const": false},
        "container_policy": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/containerPolicy"}]},
        "state": {"type": "string", "minLength": 1}
      }
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "observed_at", "maximum_age_seconds"],
      "properties": {
        "status": {"enum": ["current", "stale"]},
        "observed_at": {"$ref": "#/$defs/timestamp"},
        "maximum_age_seconds": {"type": "integer", "minimum": 0}
      }
    },
    "inputFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frame_type", "authority_label", "practice_id", "principal_id", "correlation_id", "context_revision", "sensitivity", "payload", "freshness"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "frame_type": {"type": "string", "minLength": 1},
        "authority_label": {"type": "string", "minLength": 1},
        "practice_id": {"$ref": "#/$defs/id"},
        "principal_id": {"$ref": "#/$defs/id"},
        "correlation_id": {"$ref": "#/$defs/id"},
        "context_revision": {"type": "integer", "minimum": 1},
        "sensitivity": {"enum": ["public", "internal", "restricted"]},
        "payload": {"type": "object"},
        "freshness": {"$ref": "#/$defs/freshness"}
      }
    },
    "outputPort": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "frame_type", "recipient_node_id", "channel", "authority_ceiling", "human_gate_required", "required_payload_fields", "allowed_payload_fields", "atomic_group_id"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "frame_type": {"type": "string", "minLength": 1},
        "recipient_node_id": {"$ref": "#/$defs/id"},
        "channel": {"enum": ["data", "control", "evidence"]},
        "authority_ceiling": {"$ref": "#/$defs/authorityClass"},
        "human_gate_required": {"type": "boolean"},
        "required_payload_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_payload_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "atomic_group_id": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]}
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "instance", "attempt", "container_generation", "policy_revision", "checkpoint_id", "context_revision", "state", "retry_of", "superseded_from", "emitted_draft_ids"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "instance": {"$ref": "#/$defs/id"},
        "attempt": {"type": "integer", "minimum": 1},
        "container_generation": {"type": "integer", "minimum": 1},
        "policy_revision": {"type": "integer", "minimum": 1},
        "checkpoint_id": {"$ref": "#/$defs/id"},
        "context_revision": {"type": "integer", "minimum": 1},
        "state": {"type": "string", "minLength": 1},
        "retry_of": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "superseded_from": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/id"}]},
        "emitted_draft_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source"],
      "properties": {
        "kind": {"type": "string", "minLength": 1},
        "source": {"$ref": "#/$defs/id"}
      }
    },
    "draftFrame": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "batch_id", "attempt_id", "output_port_id", "frame_type", "authority_class", "practice_id", "principal_id", "correlation_id", "context_revision", "source_frame_ids", "payload", "provenance", "freshness"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "batch_id": {"$ref": "#/$defs/id"},
        "attempt_id": {"$ref": "#/$defs/id"},
        "output_port_id": {"$ref": "#/$defs/id"},
        "frame_type": {"type": "string", "minLength": 1},
        "authority_class": {"$ref": "#/$defs/authorityClass"},
        "practice_id": {"$ref": "#/$defs/id"},
        "principal_id": {"$ref": "#/$defs/id"},
        "correlation_id": {"$ref": "#/$defs/id"},
        "context_revision": {"type": "integer", "minimum": 1},
        "source_frame_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "payload": {"type": "object"},
        "provenance": {"$ref": "#/$defs/provenance"},
        "freshness": {"$ref": "#/$defs/freshness"}
      }
    },
    "verificationPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "proofreader_node_id", "current_context_revision", "default_decision", "checks_in_order", "authority_order", "repair_allowlist", "repair_forbidden", "retry_policy", "verdict_dispositions"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "proofreader_node_id": {"$ref": "#/$defs/id"},
        "current_context_revision": {"type": "integer", "minimum": 1},
        "default_decision": {"const": "deny"},
        "checks_in_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "authority_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/authorityClass"}},
        "repair_allowlist": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "repair_forbidden": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "retry_policy": {"type": "object"},
        "verdict_dispositions": {"type": "object"}
      }
    },
    "verificationCase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "draft_ids", "prior_same_failure_count", "expected"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "draft_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "prior_same_failure_count": {"type": "integer", "minimum": 0},
        "expected": {"type": "object"}
      }
    },
    "freshReadGrant": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "practice_id", "principal_id", "role", "action", "resource_selectors", "context_frame_type", "basis_case_id", "minimum_context_revision", "issued_at", "expires_at", "execution_enabled", "returns_data"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "practice_id": {"$ref": "#/$defs/id"},
        "principal_id": {"$ref": "#/$defs/id"},
        "role": {"$ref": "#/$defs/id"},
        "action": {"const": "read-scoped-context"},
        "resource_selectors": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "context_frame_type": {"type": "string", "minLength": 1},
        "basis_case_id": {"$ref": "#/$defs/id"},
        "minimum_context_revision": {"type": "integer", "minimum": 1},
        "issued_at": {"$ref": "#/$defs/timestamp"},
        "expires_at": {"$ref": "#/$defs/timestamp"},
        "execution_enabled": {"const": false},
        "returns_data": {"const": false}
      }
    },
    "retryTrace": {
      "type": "object",
      "required": ["id", "kind", "from_attempt_id", "to_attempt_id", "reason_code", "final_disposition"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["same-generation-bounded-retry", "same-generation-budget-exhaustion", "fresh-context-supersession"]},
        "from_attempt_id": {"$ref": "#/$defs/id"},
        "to_attempt_id": {"$ref": "#/$defs/id"},
        "reason_code": {"type": "string", "minLength": 1},
        "feedback_frame": {"type": "object"},
        "fresh_read_grant_id": {"$ref": "#/$defs/id"},
        "stale_completion_disposition": {"type": "string", "minLength": 1},
        "final_disposition": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "humanGatePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "node_id", "required_role", "accepted_frame_types", "accepted_verdicts", "allowed_actions", "execution_enabled", "command_authority", "confirmation_evidence_only", "backend_revalidation_required", "rejected_frame_can_be_rehabilitated"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "node_id": {"$ref": "#/$defs/id"},
        "required_role": {"$ref": "#/$defs/id"},
        "accepted_frame_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "accepted_verdicts": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "allowed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "execution_enabled": {"const": false},
        "command_authority": {"const": false},
        "confirmation_evidence_only": {"const": true},
        "backend_revalidation_required": {"const": true},
        "rejected_frame_can_be_rehabilitated": {"const": false}
      }
    },
    "atomicGroup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "member_port_ids", "consistency_fields", "release_mode"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "member_port_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"$ref": "#/$defs/id"}},
        "consistency_fields": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "release_mode": {"const": "all-or-none"}
      }
    }
  }
}
