ycle_revision + 1::pg_catalog.int8))::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || ((checkpoint.lifecycle_revision + 1::pg_catalog.int8))::pg_catalog.text) END), 'UTF8'::pg_catalog.name)), 'hex'))::emr4_context_fabric.digest_sha256, updated_at = pg_catalog.transaction_timestamp() WHERE ((emr4_context_fabric.context_durability_checkpoint.practice_id = ((admission_locator).generation_locator).practice_id) AND (emr4_context_fabric.context_durability_checkpoint.source_contract_id = ((admission_locator).generation_locator).source_contract_id) AND (emr4_context_fabric.context_durability_checkpoint.stream_id = ((admission_locator).generation_locator).stream_id) AND (emr4_context_fabric.context_durability_checkpoint.stream_epoch = ((admission_locator).generation_locator).stream_epoch) AND (emr4_context_fabric.context_durability_checkpoint.observer_id = ((admission_locator).generation_locator).observer_id) AND (emr4_context_fabric.context_durability_checkpoint.observer_generation = ((admission_locator).generation_locator).observer_generation)) RETURNING practice_id, source_contract_id, stream_id, stream_epoch, observer_id, observer_generation, checkpoint_state, last_contiguous_position, last_observation_digest, lifecycle_revision, audit_head_digest, checkpoint_integrity_digest, updated_at INTO STRICT rebased_checkpoint_missing_admission;
