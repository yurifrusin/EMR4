-- ==========================================================================
-- PHASE 2 -- the nine entry-point functions in accepted renderer order
-- ==========================================================================
CREATE FUNCTION emr4_context_fabric.project_update_confirm_reschedule_v1(command_id pg_catalog.uuid)
RETURNS emr4_context_fabric.diary_context_observation_outbox_v1
AS $durability_inert$
DECLARE
    binding emr4_context_fabric.context_service_practice_binding;
    binding_allowed pg_catalog.bool;
    claim record;
    appointment record;
    audit record;
    audit_ids public.appointment_audit_log[];
    aggregate_revision pg_catalog.int8;
    event record;
    candidate_alias pg_catalog.uuid;
    alias emr4_context_fabric.diary_context_aggregate_aliases_v1;
    locked_alias emr4_context_fabric.diary_context_aggregate_aliases_v1;
    head emr4_context_fabric.context_observation_stream_head;
    next_position pg_catalog.int8;
    source_contract_digest emr4_context_fabric.digest_sha256;
    inserted_outbox emr4_context_fabric.diary_context_observation_outbox_v1;
    updated_head emr4_context_fabric.context_observation_stream_head;
    outbox emr4_context_fabric.diary_context_observation_outbox_v1;
    cf_constraint_name pg_catalog.text;
BEGIN
    IF NOT (pg_catalog.current_setting('transaction_isolation') = 'read committed') THEN
        RAISE EXCEPTION USING ERRCODE = 'CF303', MESSAGE = 'durability_state_ambiguous';
    END IF;
    BEGIN
SELECT emr4_context_fabric.context_service_practice_binding.database_login, emr4_context_fabric.context_service_practice_binding.logical_capability, emr4_context_fabric.context_service_practice_binding.practice_id, emr4_context_fabric.context_service_practice_binding.source_contract_id, emr4_context_fabric.context_service_practice_binding.binding_revision, emr4_context_fabric.context_service_practice_binding.credential_epoch, emr4_context_fabric.context_service_practice_binding.active_from, emr4_context_fabric.context_service_practice_binding.active_until, emr4_context_fabric.context_service_practice_binding.stream_id INTO STRICT binding FROM emr4_context_fabric.context_service_practice_binding WHERE ((emr4_context_fabric.context_service_practice_binding.database_login = session_user) AND (emr4_context_fabric.context_service_practice_binding.logical_capability = 'PRODUCER'::emr4_context_fabric.logical_capability) AND (emr4_context_fabric.context_service_practice_binding.source_contract_id = 'diary.appointment_rescheduled.v1'::emr4_context_fabric.source_contract_code) AND (emr4_context_fabric.context_service_practice_binding.active_from <= pg_catalog.transaction_timestamp()) AND ((emr4_context_fabric.context_service_practice_binding.active_until IS NULL) OR (emr4_context_fabric.context_service_practice_binding.active_until > pg_catalog.transaction_timestamp()))) ORDER BY emr4_context_fabric.context_service_practice_binding.database_login ASC, emr4_context_fabric.context_service_practice_binding.logical_capability ASC, emr4_context_fabric.context_service_practice_binding.practice_id ASC;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    binding_allowed := emr4_context_fabric.session_binding_allows_v1(session_user, ARRAY['PRODUCER'::emr4_context_fabric.logical_capability]::emr4_context_fabric.logical_capability[], binding.practice_id, binding.source_contract_id, binding.stream_id, pg_catalog.transaction_timestamp());
    IF NOT (binding_allowed) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF001', MESSAGE = 'binding_denied';
    END IF;
    BEGIN
SELECT public.appointment_command_idempotency.id, public.appointment_command_idempotency.practice_id, public.appointment_command_idempotency.operation_id, public.appointment_command_idempotency.route_family, public.appointment_command_idempotency.request_body_hash, public.appointment_command_idempotency.state, public.appointment_command_idempotency.target_appointment_id, public.appointment_command_idempotency.audit_log_id, public.appointment_command_idempotency.created_at, public.appointment_command_idempotency.xmin INTO STRICT claim FROM public.appointment_command_idempotency WHERE ((public.appointment_command_idempotency.id = command_id) AND (public.appointment_command_idempotency.practice_id = binding.practice_id)) ORDER BY public.appointment_command_idempotency.practice_id ASC, public.appointment_command_idempotency.id ASC;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    IF NOT (((claim.operation_id = 'confirmAppointmentUpdateProposal'::pg_catalog.text) AND (claim.route_family = 'update-confirm'::pg_catalog.text) AND (claim.state = 'in_progress'::pg_catalog.text) AND (claim.request_body_hash IS NOT NULL) AND (claim.target_appointment_id IS NOT NULL) AND (claim.audit_log_id IS NOT NULL) AND (claim.created_at = pg_catalog.transaction_timestamp()) AND ((claim).xmin = ((((pg_catalog.pg_current_xact_id()::pg_catalog.text)::pg_catalog.int8 & 4294967295)::pg_catalog.text)::pg_catalog.xid)))) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF101', MESSAGE = 'producer_claim_ineligible';
    END IF;
    BEGIN
SELECT public.appointments.id, public.appointments.practice_id, public.appointments.practitioner_id, public.appointments.location_id, public.appointments.start_time, public.appointments.duration_minutes, public.appointments.xmin INTO STRICT appointment FROM public.appointments WHERE ((public.appointments.practice_id = binding.practice_id) AND (public.appointments.id = claim.target_appointment_id)) ORDER BY public.appointments.practice_id ASC, public.appointments.id ASC;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    IF NOT ((((appointment).xmin = ((((pg_catalog.pg_current_xact_id()::pg_catalog.text)::pg_catalog.int8 & 4294967295)::pg_catalog.text)::pg_catalog.xid)) AND (appointment.duration_minutes > 0::pg_catalog.int4))) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF102', MESSAGE = 'producer_provenance_mismatch';
    END IF;
    BEGIN
SELECT public.appointment_audit_log.id, public.appointment_audit_log.practice_id, public.appointment_audit_log.appointment_id, public.appointment_audit_log.action, public.appointment_audit_log.command_id, public.appointment_audit_log.created_at, public.appointment_audit_log.xmin INTO STRICT audit FROM public.appointment_audit_log WHERE ((public.appointment_audit_log.practice_id = binding.practice_id) AND (public.appointment_audit_log.id = claim.audit_log_id)) ORDER BY public.appointment_audit_log.practice_id ASC, public.appointment_audit_log.id ASC;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
