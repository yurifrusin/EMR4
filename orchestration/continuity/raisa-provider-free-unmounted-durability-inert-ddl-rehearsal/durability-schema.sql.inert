SELECT emr4_context_fabric.context_observation_stream_head.practice_id, emr4_context_fabric.context_observation_stream_head.source_contract_id, emr4_context_fabric.context_observation_stream_head.stream_id, emr4_context_fabric.context_observation_stream_head.stream_epoch, emr4_context_fabric.context_observation_stream_head.last_position, emr4_context_fabric.context_observation_stream_head.updated_at INTO STRICT head FROM emr4_context_fabric.context_observation_stream_head WHERE ((emr4_context_fabric.context_observation_stream_head.practice_id = NEW.practice_id) AND (emr4_context_fabric.context_observation_stream_head.source_contract_id = 'diary.appointment_rescheduled.v1'::emr4_context_fabric.source_contract_code) AND (emr4_context_fabric.context_observation_stream_head.stream_id = binding.stream_id)) ORDER BY emr4_context_fabric.context_observation_stream_head.practice_id ASC, emr4_context_fabric.context_observation_stream_head.source_contract_id ASC, emr4_context_fabric.context_observation_stream_head.stream_id ASC;
