SELECT emr4_context_fabric.diary_context_aggregate_aliases_v1.practice_id, emr4_context_fabric.diary_context_aggregate_aliases_v1.source_contract_id, emr4_context_fabric.diary_context_aggregate_aliases_v1.product_appointment_uuid, emr4_context_fabric.diary_context_aggregate_aliases_v1.opaque_aggregate_alias, emr4_context_fabric.diary_context_aggregate_aliases_v1.created_at, emr4_context_fabric.diary_context_aggregate_aliases_v1.stream_id INTO STRICT alias FROM emr4_context_fabric.diary_context_aggregate_aliases_v1 WHERE ((emr4_context_fabric.diary_context_aggregate_aliases_v1.practice_id = NEW.practice_id) AND (emr4_context_fabric.diary_context_aggregate_aliases_v1.source_contract_id = 'diary.appointment_rescheduled.v1'::emr4_context_fabric.source_contract_code) AND (emr4_context_fabric.diary_context_aggregate_aliases_v1.stream_id = binding.stream_id) AND (emr4_context_fabric.diary_context_aggregate_aliases_v1.product_appointment_uuid = appointment.id)) ORDER BY emr4_context_fabric.diary_context_aggregate_aliases_v1.practice_id ASC, emr4_context_fabric.diary_context_aggregate_aliases_v1.source_contract_id ASC, emr4_context_fabric.diary_context_aggregate_aliases_v1.stream_id ASC, emr4_context_fabric.diary_context_aggregate_aliases_v1.product_appointment_uuid ASC;
            EXCEPTION
