CREATE FUNCTION emr4_context_fabric.cf_guard_claim_v1()
RETURNS trigger
AS $durability_inert$
DECLARE
    reselected_old_claim record;
BEGIN
    IF NOT (((TG_TABLE_SCHEMA = 'public'::pg_catalog.name) AND (TG_TABLE_NAME = 'appointment_command_idempotency'::pg_catalog.name) AND (TG_WHEN = 'BEFORE'::pg_catalog.text) AND (TG_LEVEL = 'ROW'::pg_catalog.text))) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF002', MESSAGE = 'trigger_context_invalid';
    END IF;
    IF (TG_OP = 'UPDATE') THEN
        IF (((NOT ((OLD.operation_id = 'confirmAppointmentUpdateProposal'::pg_catalog.text) AND (OLD.route_family = 'update-confirm'::pg_catalog.text))) AND (NOT ((NEW.operation_id = 'confirmAppointmentUpdateProposal'::pg_catalog.text) AND (NEW.route_family = 'update-confirm'::pg_catalog.text))))) THEN
            RETURN NEW;
        ELSE
            IF ((((OLD.operation_id = 'confirmAppointmentUpdateProposal'::pg_catalog.text) AND (OLD.route_family = 'update-confirm'::pg_catalog.text)) AND ((NEW.operation_id = 'confirmAppointmentUpdateProposal'::pg_catalog.text) AND (NEW.route_family = 'update-confirm'::pg_catalog.text)))) THEN
                BEGIN
SELECT public.appointment_command_idempotency.xmin INTO STRICT reselected_old_claim FROM public.appointment_command_idempotency WHERE ((public.appointment_command_idempotency.practice_id = OLD.practice_id) AND (public.appointment_command_idempotency.id = OLD.id)) ORDER BY public.appointment_command_idempotency.practice_id ASC, public.appointment_command_idempotency.id ASC;
                EXCEPTION
                    WHEN NO_DATA_FOUND THEN
                        RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
                    WHEN TOO_MANY_ROWS THEN
                        RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
                END;
                IF NOT (((reselected_old_claim).xmin = ((((pg_catalog.pg_current_xact_id()::pg_catalog.text)::pg_catalog.int8 & 4294967295)::pg_catalog.text)::pg_catalog.xid))) THEN
                    RAISE EXCEPTION USING ERRCODE = 'CF102', MESSAGE = 'producer_provenance_mismatch';
                END IF;
                IF NOT (((NOT (OLD.id IS DISTINCT FROM NEW.id)) AND (NOT (OLD.practice_id IS DISTINCT FROM NEW.practice_id)) AND (NOT (OLD.actor_user_id IS DISTINCT FROM NEW.actor_user_id)) AND (NOT (OLD.operation_id IS DISTINCT FROM NEW.operation_id)) AND (NOT (OLD.route_family IS DISTINCT FROM NEW.route_family)) AND (NOT (OLD.request_body_hash IS DISTINCT FROM NEW.request_body_hash)) AND (NOT (OLD.created_at IS DISTINCT FROM NEW.created_at)))) THEN
                    RAISE EXCEPTION USING ERRCODE = 'CF601', MESSAGE = 'immutable_member_mutation';
                END IF;
                IF NOT (((OLD.state = 'in_progress'::pg_catalog.text) AND ((NEW.state = 'in_progress'::pg_catalog.text) OR (NEW.state = 'completed'::pg_catalog.text)) AND ((NOT (OLD.target_appointment_id IS DISTINCT FROM NEW.target_appointment_id)) OR ((OLD.target_appointment_id IS NULL) AND (NEW.target_appointment_id IS NOT NULL))) AND ((NOT (OLD.audit_log_id IS DISTINCT FROM NEW.audit_log_id)) OR ((OLD.audit_log_id IS NULL) AND (NEW.audit_log_id IS NOT NULL))))) THEN
                    RAISE EXCEPTION USING ERRCODE = 'CF602', MESSAGE = 'claim_transition_invalid';
                END IF;
                RETURN NEW;
            ELSE
                RAISE EXCEPTION USING ERRCODE = 'CF602', MESSAGE = 'claim_transition_invalid';
            END IF;
        END IF;
    ELSIF (TG_OP = 'DELETE') THEN
        IF (((OLD.operation_id = 'confirmAppointmentUpdateProposal'::pg_catalog.text) AND (OLD.route_family = 'update-confirm'::pg_catalog.text))) THEN
            RAISE EXCEPTION USING ERRCODE = 'CF601', MESSAGE = 'immutable_member_mutation';
        ELSE
            RETURN OLD;
        END IF;
    ELSE
        RAISE EXCEPTION USING ERRCODE = 'CF002', MESSAGE = 'trigger_context_invalid';
    END IF;
END;
$durability_inert$
LANGUAGE plpgsql VOLATILE SECURITY DEFINER PARALLEL UNSAFE SET search_path = pg_catalog, emr4_context_fabric;
