$durability_inert$
LANGUAGE plpgsql VOLATILE SECURITY DEFINER STRICT PARALLEL UNSAFE SET search_path = pg_catalog, emr4_context_fabric;
ALTER FUNCTION emr4_context_fabric.apply_durability_transition_v1(admission_locator emr4_context_fabric.admission_locator_v1) OWNER TO context_schema_owner;
CREATE FUNCTION emr4_context_fabric.register_observer_generation_v1(registration emr4_context_fabric.generation_registration_v1)
RETURNS emr4_context_fabric.context_observer_generation
AS $durability_inert$
DECLARE
    binding emr4_context_fabric.context_service_practice_binding;
    binding_allowed pg_catalog.bool;
    barrier emr4_context_fabric.context_generation_registry_barrier;
    head_set emr4_context_fabric.context_observation_stream_head[];
    head emr4_context_fabric.context_observation_stream_head;
    existing_set emr4_context_fabric.context_observer_generation[];
    existing_generation emr4_context_fabric.context_observer_generation;
    replay_checkpoint emr4_context_fabric.context_durability_checkpoint;
    replay_frame_set emr4_context_fabric.context_frame_generation[];
    replay_diary_frame emr4_context_fabric.context_frame_generation;
    replay_waiting_frame emr4_context_fabric.context_frame_generation;
    replay_watermark_set emr4_context_fabric.context_invalidation_watermark[];
    replay_diary_watermark emr4_context_fabric.context_invalidation_watermark;
    replay_waiting_watermark emr4_context_fabric.context_invalidation_watermark;
    replay_initial_key emr4_context_fabric.context_observation_key_interval;
    replay_baseline_anchor emr4_context_fabric.context_recovery_anchor;
    inserted_generation emr4_context_fabric.context_observer_generation;
    inserted_checkpoint emr4_context_fabric.context_durability_checkpoint;
    diary_frame_id pg_catalog.uuid;
    waiting_frame_id pg_catalog.uuid;
    diary_frame emr4_context_fabric.context_frame_generation;
    waiting_frame emr4_context_fabric.context_frame_generation;
    diary_watermark emr4_context_fabric.context_invalidation_watermark;
    waiting_watermark emr4_context_fabric.context_invalidation_watermark;
    initial_key emr4_context_fabric.context_observation_key_interval;
    baseline_anchor emr4_context_fabric.context_recovery_anchor;
    updated_barrier emr4_context_fabric.context_generation_registry_barrier;
    cf_constraint_name pg_catalog.text;
BEGIN
    IF NOT (pg_catalog.current_setting('transaction_isolation') = 'serializable') THEN
        RAISE EXCEPTION USING ERRCODE = 'CF303', MESSAGE = 'durability_state_ambiguous';
    END IF;
    BEGIN
SELECT emr4_context_fabric.context_service_practice_binding.database_login, emr4_context_fabric.context_service_practice_binding.logical_capability, emr4_context_fabric.context_service_practice_binding.practice_id, emr4_context_fabric.context_service_practice_binding.source_contract_id, emr4_context_fabric.context_service_practice_binding.binding_revision, emr4_context_fabric.context_service_practice_binding.credential_epoch, emr4_context_fabric.context_service_practice_binding.active_from, emr4_context_fabric.context_service_practice_binding.active_until, emr4_context_fabric.context_service_practice_binding.stream_id INTO STRICT binding FROM emr4_context_fabric.context_service_practice_binding WHERE ((emr4_context_fabric.context_service_practice_binding.database_login = session_user) AND (emr4_context_fabric.context_service_practice_binding.logical_capability = 'LIFECYCLE'::emr4_context_fabric.logical_capability) AND (emr4_context_fabric.context_service_practice_binding.source_contract_id = 'diary.appointment_rescheduled.v1'::emr4_context_fabric.source_contract_code) AND (emr4_context_fabric.context_service_practice_binding.active_from <= pg_catalog.transaction_timestamp()) AND ((emr4_context_fabric.context_service_practice_binding.active_until IS NULL) OR (emr4_context_fabric.context_service_practice_binding.active_until > pg_catalog.transaction_timestamp())) AND (emr4_context_fabric.context_service_practice_binding.practice_id = ((registration).generation_locator).practice_id) AND (emr4_context_fabric.context_service_practice_binding.stream_id = ((registration).generation_locator).stream_id)) ORDER BY emr4_context_fabric.context_service_practice_binding.database_login ASC, emr4_context_fabric.context_service_practice_binding.logical_capability ASC, emr4_context_fabric.context_service_practice_binding.practice_id ASC;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    binding_allowed := emr4_context_fabric.session_binding_allows_v1(session_user, ARRAY['LIFECYCLE'::emr4_context_fabric.logical_capability]::emr4_context_fabric.logical_capability[], binding.practice_id, binding.source_contract_id, binding.stream_id, pg_catalog.transaction_timestamp());
    IF NOT (binding_allowed) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF001', MESSAGE = 'binding_denied';
    END IF;
    BEGIN
SELECT emr4_context_fabric.context_generation_registry_barrier.practice_id, emr4_context_fabric.context_generation_registry_barrier.source_contract_id, emr4_context_fabric.context_generation_registry_barrier.stream_id, emr4_context_fabric.context_generation_registry_barrier.barrier_revision, emr4_context_fabric.context_generation_registry_barrier.updated_at INTO STRICT barrier FROM emr4_context_fabric.context_generation_registry_barrier WHERE ((emr4_context_fabric.context_generation_registry_barrier.practice_id = ((registration).generation_locator).practice_id) AND (emr4_context_fabric.context_generation_registry_barrier.source_contract_id = ((registration).generation_locator).source_contract_id) AND (emr4_context_fabric.context_generation_registry_barrier.stream_id = ((registration).generation_locator).stream_id)) FOR UPDATE;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
