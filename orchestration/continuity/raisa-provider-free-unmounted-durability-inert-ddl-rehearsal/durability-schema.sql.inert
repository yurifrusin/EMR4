                    INTO producer_bindings
                FROM emr4_context_fabric.context_service_practice_binding WHERE ((emr4_context_fabric.context_service_practice_binding.database_login = session_user) AND (emr4_context_fabric.context_service_practice_binding.logical_capability = 'PRODUCER'::emr4_context_fabric.logical_capability) AND (emr4_context_fabric.context_service_practice_binding.practice_id = NEW.practice_id) AND (emr4_context_fabric.context_service_practice_binding.source_contract_id = 'diary.appointment_rescheduled.v1'::emr4_context_fabric.source_contract_code) AND (emr4_context_fabric.context_service_practice_binding.active_from <= pg_catalog.transaction_timestamp()) AND ((emr4_context_fabric.context_service_practice_binding.active_until IS NULL) OR (emr4_context_fabric.context_service_practice_binding.active_until > pg_catalog.transaction_timestamp())));
