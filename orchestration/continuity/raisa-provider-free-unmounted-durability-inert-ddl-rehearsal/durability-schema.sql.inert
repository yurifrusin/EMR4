        BEGIN
UPDATE emr4_context_fabric.context_generation_registry_barrier SET barrier_revision = (barrier.barrier_revision + 1::pg_catalog.int8), updated_at = pg_catalog.transaction_timestamp() WHERE ((emr4_context_fabric.context_generation_registry_barrier.practice_id = ((registration).generation_locator).practice_id) AND (emr4_context_fabric.context_generation_registry_barrier.source_contract_id = ((registration).generation_locator).source_contract_id) AND (emr4_context_fabric.context_generation_registry_barrier.stream_id = ((registration).generation_locator).stream_id)) RETURNING practice_id, source_contract_id, stream_id, barrier_revision, updated_at INTO STRICT updated_barrier;
