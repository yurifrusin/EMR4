    rebased_generation_anchor_integrity emr4_context_fabric.context_observer_generation;
    rebased_checkpoint_anchor_integrity emr4_context_fabric.context_durability_checkpoint;
    rebase_result_anchor_integrity emr4_context_fabric.durability_transition_result_v1;
    rebase_lifecycle_key emr4_context_fabric.context_durability_lifecycle;
    rebase_audit_key emr4_context_fabric.context_durability_audit;
    rebased_generation_key emr4_context_fabric.context_observer_generation;
    rebased_checkpoint_key emr4_context_fabric.context_durability_checkpoint;
