CREATE FUNCTION emr4_context_fabric.session_binding_allows_v1(authenticated_login pg_catalog.name, allowed_capabilities emr4_context_fabric.logical_capability[], requested_practice_id pg_catalog.uuid, requested_source_contract_id emr4_context_fabric.source_contract_code, requested_stream_id pg_catalog.uuid, observed_at pg_catalog.timestamptz)
RETURNS pg_catalog.bool
AS $durability_inert$
    SELECT count(*) = 1 FROM emr4_context_fabric.context_service_practice_binding AS binding WHERE binding.database_login = authenticated_login AND binding.database_login = session_user AND binding.logical_capability = ANY (allowed_capabilities) AND binding.practice_id = requested_practice_id AND binding.source_contract_id = requested_source_contract_id AND binding.stream_id = requested_stream_id AND binding.active_from <= observed_at AND (binding.active_until IS NULL OR binding.active_until > observed_at);
$durability_inert$
LANGUAGE sql STABLE SECURITY DEFINER STRICT PARALLEL RESTRICTED SET search_path = pg_catalog, emr4_context_fabric;
