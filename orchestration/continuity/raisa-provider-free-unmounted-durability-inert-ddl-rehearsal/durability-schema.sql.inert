SELECT emr4_context_fabric.diary_context_observation_outbox_v1.practice_id, emr4_context_fabric.diary_context_observation_outbox_v1.source_contract_id, emr4_context_fabric.diary_context_observation_outbox_v1.stream_id, emr4_context_fabric.diary_context_observation_outbox_v1.stream_epoch, emr4_context_fabric.diary_context_observation_outbox_v1.transaction_position, emr4_context_fabric.diary_context_observation_outbox_v1.predecessor_position, emr4_context_fabric.diary_context_observation_outbox_v1.raw_event_uuid, emr4_context_fabric.diary_context_observation_outbox_v1.opaque_aggregate_alias, emr4_context_fabric.diary_context_observation_outbox_v1.aggregate_revision, emr4_context_fabric.diary_context_observation_outbox_v1.source_contract_digest, emr4_context_fabric.diary_context_observation_outbox_v1.transaction_authored_at INTO STRICT outbox FROM emr4_context_fabric.diary_context_observation_outbox_v1 WHERE ((emr4_context_fabric.diary_context_observation_outbox_v1.practice_id = NEW.practice_id) AND (emr4_context_fabric.diary_context_observation_outbox_v1.raw_event_uuid = event.id) AND (emr4_context_fabric.diary_context_observation_outbox_v1.stream_id = binding.stream_id)) ORDER BY emr4_context_fabric.diary_context_observation_outbox_v1.practice_id ASC, emr4_context_fabric.diary_context_observation_outbox_v1.source_contract_id ASC, emr4_context_fabric.diary_context_observation_outbox_v1.stream_id ASC, emr4_context_fabric.diary_context_observation_outbox_v1.stream_epoch ASC, emr4_context_fabric.diary_context_observation_outbox_v1.transaction_position ASC;
            EXCEPTION
                WHEN NO_DATA_FOUND THEN
                    RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
                WHEN TOO_MANY_ROWS THEN
                    RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
            END;
            IF NOT (((claim.state = 'completed'::pg_catalog.text) AND (claim.target_appointment_id = appointment.id) AND (claim.audit_log_id = audit.id) AND (audit.command_id = claim.id) AND (audit.appointment_id = appointment.id) AND (audit.action = 'update'::pg_catalog.text) AND (event.source_system = 'emr4-diary'::pg_catalog.text) AND (event.appointment_id = appointment.id) AND (event.audit_log_id = audit.id) AND (event.aggregate_revision = aggregate_revision) AND ((event.payload IS NOT NULL) AND (pg_catalog.coalesce((SELECT pg_catalog.array_agg(k.k ORDER BY k.k) FROM pg_catalog.jsonb_object_keys(event.payload) AS k(k)), ARRAY[]::pg_catalog.text[]) = ARRAY['appointment_id', 'practitioner_id', 'location_id', 'start_time', 'end_time', 'reason_codes']::pg_catalog.text[])) AND (((event.payload ->> 'appointment_id')::pg_catalog.uuid) = appointment.id) AND (((event.payload ->> 'practitioner_id')::pg_catalog.uuid) = appointment.practitioner_id) AND (NOT (((event.payload ->> 'location_id')::pg_catalog.uuid) IS DISTINCT FROM appointment.location_id)) AND (((event.payload ->> 'start_time')::pg_catalog.timestamptz) = appointment.start_time) AND (((event.payload ->> 'end_time')::pg_catalog.timestamptz) = (appointment.start_time + (appointment.duration_minutes * pg_catalog.make_interval(mins => 1)))) AND (((event.payload ->> 'reason_codes')::pg_catalog.text[]) = ARRAY['appointment_time_changed'::pg_catalog.text]::pg_catalog.text[]) AND (outbox.opaque_aggregate_alias = alias.opaque_aggregate_alias) AND (outbox.raw_event_uuid = event.id) AND (outbox.aggregate_revision = event.aggregate_revision) AND (outbox.stream_epoch = head.stream_epoch) AND (outbox.transaction_position = head.last_position) AND (outbox.predecessor_position = (outbox.transaction_position + -1::pg_catalog.int8)) AND ((claim).xmin = ((((pg_catalog.pg_current_xact_id()::pg_catalog.text)::pg_catalog.int8 & 4294967295)::pg_catalog.text)::pg_catalog.xid)) AND ((appointment).xmin = ((((pg_catalog.pg_current_xact_id()::pg_catalog.text)::pg_catalog.int8 & 4294967295)::pg_catalog.text)::pg_catalog.xid)) AND ((audit).xmin = ((((pg_catalog.pg_current_xact_id()::pg_catalog.text)::pg_catalog.int8 & 4294967295)::pg_catalog.text)::pg_catalog.xid)) AND ((event).xmin = ((((pg_catalog.pg_current_xact_id()::pg_catalog.text)::pg_catalog.int8 & 4294967295)::pg_catalog.text)::pg_catalog.xid)) AND ((head).xmin = ((((pg_catalog.pg_current_xact_id()::pg_catalog.text)::pg_catalog.int8 & 4294967295)::pg_catalog.text)::pg_catalog.xid)) AND ((outbox).xmin = ((((pg_catalog.pg_current_xact_id()::pg_catalog.text)::pg_catalog.int8 & 4294967295)::pg_catalog.text)::pg_catalog.xid)))) THEN
                RAISE EXCEPTION USING ERRCODE = 'CF603', MESSAGE = 'temporal_bijection_invalid';
            END IF;
