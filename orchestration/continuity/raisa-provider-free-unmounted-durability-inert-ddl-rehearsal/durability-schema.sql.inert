                            WHEN TOO_MANY_ROWS THEN
                                RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
                        END;
                        rebase_result_missing_admission := (ROW('REBASE_APPLIED'::emr4_context_fabric.durability_transition_result_kind, rebased_checkpoint_missing_admission.checkpoint_state, (admission_locator).source_position, 'REBASE_REQUIRED'::emr4_context_fabric.observation_decision, 'MISSING_ADMISSION'::emr4_context_fabric.observation_reason, 'HOLD_REBASE'::emr4_context_fabric.checkpoint_disposition, rebased_checkpoint_missing_admission.lifecycle_revision, rebased_checkpoint_missing_admission.checkpoint_integrity_digest))::emr4_context_fabric.durability_transition_result_v1;
                        RETURN rebase_result_missing_admission;
