$durability_inert$
LANGUAGE plpgsql VOLATILE SECURITY DEFINER STRICT PARALLEL UNSAFE SET search_path = pg_catalog, emr4_context_fabric;
ALTER FUNCTION emr4_context_fabric.admit_proofread_observation_v1(generation_locator emr4_context_fabric.generation_locator_v1, source_position pg_catalog.int8, proofread_packet emr4_context_fabric.proofread_packet_v1) OWNER TO context_admission_receiver;
CREATE FUNCTION emr4_context_fabric.apply_durability_transition_v1(admission_locator emr4_context_fabric.admission_locator_v1)
RETURNS emr4_context_fabric.durability_transition_result_v1
AS $durability_inert$
DECLARE
    binding emr4_context_fabric.context_service_practice_binding;
