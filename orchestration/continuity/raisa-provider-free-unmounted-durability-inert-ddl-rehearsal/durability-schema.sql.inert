    outbox emr4_context_fabric.diary_context_observation_outbox_v1;
BEGIN
    IF NOT (((TG_TABLE_SCHEMA = 'public'::pg_catalog.name) AND (TG_TABLE_NAME = 'appointment_command_idempotency'::pg_catalog.name) AND (TG_WHEN = 'AFTER'::pg_catalog.text) AND (TG_LEVEL = 'ROW'::pg_catalog.text))) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF002', MESSAGE = 'trigger_context_invalid';
    END IF;
