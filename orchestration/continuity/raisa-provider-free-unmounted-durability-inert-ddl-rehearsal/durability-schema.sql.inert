 || 'pg_catalog.bigint' || ':' || '-1') ELSE (17 || ':' || 'pg_catalog.bigint' || ':' || pg_catalog.octet_length(pg_catalog.convert_to((((admission_locator).generation_locator).stream_epoch)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || (((admission_locator).generation_locator).stream_epoch)::pg_catalog.text) END) || pg_catalog.chr(31) || (CASE WHEN (((admission_locator).generation_locator).observer_id IS NULL) THEN (15 || ':' || 'pg_catalog.uuid' || ':' || '-1') ELSE (15 || ':' || 'pg_catalog.uuid' || ':' || pg_catalog.octet_length(pg_catalog.convert_to(pg_catalog.lower((((admission_locator).generation_locator).observer_id)::pg_catalog.text), 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || pg_catalog.lower((((admission_locator).generation_locator).observer_id)::pg_catalog.text)) END) || pg_catalog.chr(31) || (CASE WHEN (((admission_locator).generation_locator).observer_generation IS NULL) THEN (17 || ':' || 'pg_catalog.bigint' || ':' || '-1') ELSE (17 || ':' || 'pg_catalog.bigint' || ':' || pg_catalog.octet_length(pg_catalog.convert_to((((admission_locator).generation_locator).observer_generation)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || (((admission_locator).generation_locator).observer_generation)::pg_catalog.text) END) || pg_catalog.chr(31) || (CASE WHEN ((admission_locator).source_position IS NULL) THEN (17 || ':' || 'pg_catalog.bigint' || ':' || '-1') ELSE (17 || ':' || 'pg_catalog.bigint' || ':' || pg_catalog.octet_length(pg_catalog.convert_to(((admission_locator).source_position)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || ((admission_locator).source_position)::pg_catalog.text) END) || pg_catalog.chr(31) || (CASE WHEN ((checkpoint.lifecycle_revision + 1::pg_catalog.int8) IS NULL) THEN (17 || ':' || 'pg_catalog.bigint' || ':' || '-1') ELSE (17 || ':' || 'pg_catalog.bigint' || ':' || pg_catalog.octet_length(pg_catalog.convert_to(((checkpoint.lifecycle_revision + 1::pg_catalo