    diary_both_retired_frame emr4_context_fabric.context_frame_generation;
    diary_both_advanced_watermark emr4_context_fabric.context_invalidation_watermark;
    waiting_both_obligation_set emr4_context_fabric.context_reassembly_obligation[];
    waiting_both_obligation emr4_context_fabric.context_reassembly_obligation;
    waiting_both_coalesced_obligation emr4_context_fabric.context_reassembly_obligation;
    waiting_both_inserted_obligation emr4_context_fabric.context_reassembly_obligation;
    waiting_both_retired_frame emr4_context_fabric.context_frame_generation;
    waiting_both_advanced_watermark emr4_context_fabric.context_invalidation_watermark;
    applied_lifecycle emr4_context_fabric.context_durability_lifecycle;
    applied_audit emr4_context_fabric.context_durability_audit;
    inserted_receipt emr4_context_fabric.context_classified_observation_receipt;
    applied_checkpoint emr4_context_fabric.context_durability_checkpoint;
    applied_result emr4_context_fabric.durability_transition_result_v1;
    cf_constraint_name pg_catalog.text;
BEGIN
    IF NOT (pg_catalog.current_setting('transaction_isolation') = 'serializable') THEN
        RAISE EXCEPTION USING ERRCODE = 'CF303', MESSAGE = 'durability_state_ambiguous';
    END IF;
    BEGIN
SELECT emr4_context_fabric.context_service_practice_binding.database_login, emr4_context_fabric.context_service_practice_binding.logical_capability, emr4_context_fabric.context_service_practice_binding.practice_id, emr4_context_fabric.context_service_practice_binding.source_contract_id, emr4_context_fabric.context_service_practice_binding.binding_revision, emr4_context_fabric.context_service_practice_binding.credential_epoch, emr4_context_fabric.context_service_practice_binding.active_from, emr4_context_fabric.context_service_practice_binding.active_until, emr4_context_fabric.context_service_practice_binding.stream_id INTO STRICT binding FROM emr4_context_fabric.context_service_practice_binding WHERE ((emr4_context_fabric.context_service_practice_binding.database_login = session_user) AND (emr4_context_fabric.context_service_practice_binding.logical_capability = 'COORDINATOR'::emr4_context_fabric.logical_capability) AND (emr4_context_fabric.context_service_practice_binding.source_contract_id = 'diary.appointment_rescheduled.v1'::emr4_context_fabric.source_contract_code) AND (emr4_context_fabric.context_service_practice_binding.active_from <= pg_catalog.transaction_timestamp()) AND ((emr4_context_fabric.context_service_practice_binding.active_until IS NULL) OR (emr4_context_fabric.context_service_practice_binding.active_until > pg_catalog.transaction_timestamp())) AND (emr4_context_fabric.context_service_practice_binding.practice_id = ((admission_locator).generation_locator).practice_id) AND (emr4_context_fabric.context_service_practice_binding.stream_id = ((admission_locator).generation_locator).stream_id)) ORDER BY emr4_context_fabric.context_service_practice_binding.database_login ASC, emr4_context_fabric.context_service_practice_binding.logical_capability ASC, emr4_context_fabric.context_service_practice_binding.practice_id ASC;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
