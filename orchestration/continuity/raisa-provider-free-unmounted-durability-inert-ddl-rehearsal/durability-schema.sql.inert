    rebased_generation_dependent_state emr4_context_fabric.context_observer_generation;
    rebased_checkpoint_dependent_state emr4_context_fabric.context_durability_checkpoint;
    rebase_result_dependent_state emr4_context_fabric.durability_transition_result_v1;
