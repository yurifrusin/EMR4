CREATE FUNCTION emr4_context_fabric.rotate_observation_key_v1(generation_locator emr4_context_fabric.generation_locator_v1, future_interval emr4_context_fabric.future_key_interval_v1)
RETURNS emr4_context_fabric.context_observation_key_interval
AS $durability_inert$
DECLARE
    binding emr4_context_fabric.context_service_practice_binding;
    binding_allowed pg_catalog.bool;
    barrier emr4_context_fabric.context_generation_registry_barrier;
    generation emr4_context_fabric.context_observer_generation;
    checkpoint emr4_context_fabric.context_durability_checkpoint;
