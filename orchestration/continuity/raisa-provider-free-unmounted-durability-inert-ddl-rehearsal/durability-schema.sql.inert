        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    binding_allowed := emr4_context_fabric.session_binding_allows_v1(session_user, ARRAY['LIFECYCLE'::emr4_context_fabric.logical_capability]::emr4_context_fabric.logical_capability[], binding.practice_id, binding.source_contract_id, binding.stream_id, pg_catalog.transaction_timestamp());
    IF NOT (binding_allowed) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF001', MESSAGE = 'binding_denied';
    END IF;
    BEGIN
SELECT emr4_context_fabric.context_generation_registry_barrier.practice_id, emr4_context_fabric.context_generation_registry_barrier.source_contract_id, emr4_context_fabric.context_generation_registry_barrier.stream_id, emr4_context_fabric.context_generation_registry_barrier.barrier_revision, emr4_context_fabric.context_generation_registry_barrier.updated_at INTO STRICT barrier FROM emr4_context_fabric.context_generation_registry_barrier WHERE ((emr4_context_fabric.context_generation_registry_barrier.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_generation_registry_barrier.source_contract_id = (generation_locator).source_contract_id) AND (emr4_context_fabric.context_generation_registry_barrier.stream_id = (generation_locator).stream_id)) FOR UPDATE;
