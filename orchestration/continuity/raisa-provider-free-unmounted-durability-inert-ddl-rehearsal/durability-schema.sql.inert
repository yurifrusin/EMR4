    END IF;
    BEGIN
SELECT emr4_context_fabric.context_service_practice_binding.database_login, emr4_context_fabric.context_service_practice_binding.logical_capability, emr4_context_fabric.context_service_practice_binding.practice_id, emr4_context_fabric.context_service_practice_binding.source_contract_id, emr4_context_fabric.context_service_practice_binding.binding_revision, emr4_context_fabric.context_service_practice_binding.credential_epoch, emr4_context_fabric.context_service_practice_binding.active_from, emr4_context_fabric.context_service_practice_binding.active_until, emr4_context_fabric.context_service_practice_binding.stream_id INTO STRICT binding FROM emr4_context_fabric.context_service_practice_binding WHERE ((emr4_context_fabric.context_service_practice_binding.database_login = session_user) AND (emr4_context_fabric.context_service_practice_binding.logical_capability = 'LIFECYCLE'::emr4_context_fabric.logical_capability) AND (emr4_context_fabric.context_service_practice_binding.source_contract_id = 'diary.appointment_rescheduled.v1'::emr4_context_fabric.source_contract_code) AND (emr4_context_fabric.context_service_practice_binding.active_from <= pg_catalog.transaction_timestamp()) AND ((emr4_context_fabric.context_service_practice_binding.active_until IS NULL) OR (emr4_context_fabric.context_service_practice_binding.active_until > pg_catalog.transaction_timestamp())) AND (emr4_context_fabric.context_service_practice_binding.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_service_practice_binding.stream_id = (generation_locator).stream_id)) ORDER BY emr4_context_fabric.context_service_practice_binding.database_login ASC, emr4_context_fabric.context_service_practice_binding.logical_capability ASC, emr4_context_fabric.context_service_practice_binding.practice_id ASC;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    binding_allowed := emr4_context_fabric.session_binding_allows_v1(session_user, ARRAY['LIFECYCLE'::emr4_context_fabric.logical_capability]::emr4_context_fabric.logical_capability[], binding.practice_id, binding.source_contract_id, binding.stream_id, pg_catalog.transaction_timestamp());
    IF NOT (binding_allowed) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF001', MESSAGE = 'binding_denied';
    END IF;
    BEGIN
SELECT emr4_context_fabric.context_generation_registry_barrier.practice_id, emr4_context_fabric.context_generation_registry_barrier.source_contract_id, emr4_context_fabric.context_generation_registry_barrier.stream_id, emr4_context_fabric.context_generation_registry_barrier.barrier_revision, emr4_context_fabric.context_generation_registry_barrier.updated_at INTO STRICT barrier FROM emr4_context_fabric.context_generation_registry_barrier WHERE ((emr4_context_fabric.context_generation_registry_barrier.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_generation_registry_barrier.source_contract_id = (generation_locator).source_contract_id) AND (emr4_context_fabric.context_generation_registry_barrier.stream_id = (generation_locator).stream_id)) FOR UPDATE;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    BEGIN
SELECT emr4_context_fabric.context_observer_generation.practice_id, emr4_context_fabric.context_observer_generation.source_contract_id, emr4_context_fabric.context_observer_generation.stream_id, emr4_context_fabric.context_observer_generation.stream_epoch, emr4_context_fabric.context_observer_generation.observer_id, emr4_context_fabric.context_observer_generation.observer_generation, emr4_context_fabric.context_observer_generation.lifecycle_state, emr4_context_fabric.context_observer_generation.policy_digest, emr4_context_fabric.context_observer_generation.principal_digest, emr4_context_fabric.context_observer_generation.binding_digest, emr4_context_fabric.context_observer_generation.source_digest, emr4_context_fabric.context_observer_generation.registry_digest, emr4_context_fabric.context_observer_generation.impact_digest, emr4_context_fabric.context_observer_generation.key_schedule_digest, emr4_context_fabric.context_observer_generation.created_at, emr4_context_fabric.context_observer_generation.consumed_at, emr4_context_fabric.context_observer_generation.terminal_reason INTO STRICT generation FROM emr4_context_fabric.context_observer_generation WHERE ((emr4_context_fabric.context_observer_generation.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_observer_generation.source_contract_id = (generation_locator).source_contract_id) AND (emr4_context_fabric.context_observer_generation.stream_id = (generation_locator).stream_id) AND (emr4_context_fabric.context_observer_generation.stream_epoch = (generation_locator).stream_epoch) AND (emr4_context_fabric.context_observer_generation.observer_id = (generation_locator).observer_id) AND (emr4_context_fabric.context_observer_generation.observer_generation = (generation_locator).observer_generation)) FOR UPDATE;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    IF ((generation.lifecycle_state <> 'ACTIVE'::emr4_context_fabric.generation_state)) THEN
        IF NOT ((generation.terminal_reason = closed_reason)) THEN
            RAISE EXCEPTION USING ERRCODE = 'CF403', MESSAGE = 'terminal_reason_conflict';
        END IF;
        RETURN generation;
    ELSE
        BEGIN
UPDATE emr4_context_fabric.context_observer_generation SET lifecycle_state = (CASE WHEN (closed_reason = 'REVOKED'::emr4_context_fabric.generation_terminal_reason) THEN 'REVOKED'::emr4_context_fabric.generation_state ELSE 'CONSUMED'::emr4_context_fabric.generation_state END), terminal_reason = closed_reason, consumed_at = (CASE WHEN (closed_reason = 'REVOKED'::emr4_context_fabric.generation_terminal_reason) THEN NULL::pg_catalog.timestamptz ELSE pg_catalog.transaction_timestamp() END) WHERE ((emr4_context_fabric.context_observer_generation.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_observer_generation.source_contract_id = (generation_locator).source_contract_id) AND (emr4_context_fabric.context_observer_generation.stream_id = (generation_locator).stream_id) AND (emr4_context_fabric.context_observer_generation.stream_epoch = (generation_locator).stream_epoch) AND (emr4_context_fabric.context_observer_generation.observer_id = (generation_locator).observer_id) AND (emr4_context_fabric.context_observer_generation.observer_generation = (generation_locator).observer_generation)) RETURNING practice_id, source_contract_id, stream_id, stream_epoch, observer_id, observer_generation, lifecycle_state, policy_digest, principal_digest, binding_digest, source_digest, registry_digest, impact_digest, key_schedule_digest, created_at, consumed_at, terminal_reason INTO STRICT consumed_generation;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
            WHEN TOO_MANY_ROWS THEN
                RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        END;
        BEGIN
UPDATE emr4_context_fabric.context_generation_registry_barrier SET barrier_revision = (barrier.barrier_revision + 1::pg_catalog.int8), updated_at = pg_catalog.transaction_timestamp() WHERE ((emr4_context_fabric.context_generation_registry_barrier.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_generation_registry_barrier.source_contract_id = (generation_locator).source_contract_id) AND (emr4_context_fabric.context_generation_registry_barrier.stream_id = (generation_locator).stream_id)) RETURNING practice_id, source_contract_id, stream_id, barrier_revision, updated_at INTO STRICT updated_barrier;
        EXCEPTION
            WHEN NO_DATA_FOUND THEN
                RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
            WHEN TOO_MANY_ROWS THEN
                RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        END;
        RETURN consumed_generation;
    END IF;
END;
$durability_inert$
LANGUAGE plpgsql VOLATILE SECURITY DEFINER STRICT PARALLEL UNSAFE SET search_path = pg_catalog, emr4_context_fabric;
ALTER FUNCTION emr4_context_fabric.consume_observer_generation_v1(generation_locator emr4_context_fabric.generation_locator_v1, closed_reason emr4_context_fabric.generation_terminal_reason) OWNER TO context_schema_owner;
CREATE FUNCTION emr4_context_fabric.evaluate_source_retention_v1(practice_source_stream emr4_context_fabric.practice_source_stream_v1)
RETURNS emr4_context_fabric.context_source_retention_eligibility_v1
AS $durability_inert$
DECLARE
    binding emr4_context_fabric.context_service_practice_binding;
    binding_allowed pg_catalog.bool;
    barrier emr4_context_fabric.context_generation_registry_barrier;
    retention_head emr4_context_fabric.context_observation_stream_head;
    policy_set emr4_context_fabric.context_retention_policy[];
    generation_set emr4_context_fabric.context_observer_generation[];
    checkpoint_set emr4_context_fabric.context_durability_checkpoint[];
    anchor_set emr4_context_fabric.context_recovery_anchor[];
    pin_set emr4_context_fabric.context_recovery_pin[];
    key_set emr4_context_fabric.context_observation_key_interval[];
    source_set emr4_context_fabric.diary_context_observation_outbox_v1[];
    retention_receipt_set emr4_context_fabric.context_classified_observation_receipt[];
    retention_audit_set emr4_context_fabric.context_durability_audit[];
    retention_policy emr4_context_fabric.context_retention_policy;
    census_digest emr4_context_fabric.digest_sha256;
    slowest_checkpoint_position pg_catalog.int8;
    required_source_set emr4_context_fabric.diary_context_observation_outbox_v1[];
    mature_source_set emr4_context_fabric.diary_context_observation_outbox_v1[];
    mature_checkpoint_set emr4_context_fabric.context_durability_checkpoint[];
    mature_receipt_set emr4_context_fabric.context_classified_observation_receipt[];
    mature_audit_set emr4_context_fabric.context_durability_audit[];
    overlapping_key_set emr4_context_fabric.context_observation_key_interval[];
    key_overlap_covered pg_catalog.bool;
    census_generation emr4_context_fabric.context_observer_generation;
    census_checkpoint emr4_context_fabric.context_durability_checkpoint;
    census_anchor emr4_context_fabric.context_recovery_anchor;
    census_generation_key_set emr4_context_fabric.context_observation_key_interval[];
    census_generation_pin_set emr4_context_fabric.context_recovery_pin[];
    retention_result emr4_context_fabric.context_source_retention_eligibility_v1;
    ambiguous_retention_result emr4_context_fabric.context_source_retention_eligibility_v1;
BEGIN
    IF NOT (pg_catalog.current_setting('transaction_isolation') = 'serializable') THEN
        RAISE EXCEPTION USING ERRCODE = 'CF303', MESSAGE = 'durability_state_ambiguous';
    END IF;
    BEGIN
SELECT emr4_context_fabric.context_service_practice_binding.database_login, emr4_context_fabric.context_service_practice_binding.logical_capability, emr4_context_fabric.context_service_practice_binding.practice_id, emr4_context_fabric.context_service_practice_binding.source_contract_id, emr4_context_fabric.context_service_practice_binding.binding_revision, emr4_context_fabric.context_service_practice_binding.credential_epoch, emr4_context_fabric.context_service_practice_binding.active_from, emr4_context_fabric.context_service_practice_binding.active_until, emr4_context_fabric.context_service_practice_binding.stream_id INTO STRICT binding FROM emr4_context_fabric.context_service_practice_binding WHERE ((emr4_context_fabric.context_service_practice_binding.database_login = session_user) AND (emr4_context_fabric.context_service_practice_binding.logical_capability = 'RETENTION'::emr4_context_fabric.logical_capability) AND (emr4_context_fabric.context_service_practice_binding.source_contract_id = 'diary.appointment_rescheduled.v1'::emr4_context_fabric.source_contract_code) AND (emr4_context_fabric.context_service_practice_binding.active_from <= pg_catalog.transaction_timestamp()) AND ((emr4_context_fabric.context_service_practice_binding.active_until IS NULL) OR (emr4_context_fabric.context_service_practice_binding.active_until > pg_catalog.transaction_timestamp())) AND (emr4_context_fabric.context_service_practice_binding.practice_id = (practice_source_stream).practice_id) AND (emr4_context_fabric.context_service_practice_binding.stream_id = (practice_source_stream).stream_id)) ORDER BY emr4_context_fabric.context_service_practice_binding.database_login ASC, emr4_context_fabric.context_service_practice_binding.logical_capability ASC, emr4_context_fabric.context_service_practice_binding.practice_id ASC;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    binding_allowed := emr4_context_fabric.session_binding_allows_v1(session_user, ARRAY['RETENTION'::emr4_context_fabric.logical_capability]::emr4_context_fabric.logical_capability[], binding.practice_id, binding.source_contract_id, binding.stream_id, pg_catalog.transaction_timestamp());
    IF NOT (binding_allowed) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF001', MESSAGE = 'binding_denied';
    END IF;
    BEGIN
SELECT emr4_context_fabric.context_generation_registry_barrier.practice_id, emr4_context_fabric.context_generation_registry_barrier.source_contract_id, emr4_context_fabric.context_generation_registry_barrier.stream_id, emr4_context_fabric.context_generation_registry_barrier.barrier_revision, emr4_context_fabric.context_generation_registry_barrier.updated_at INTO STRICT barrier FROM emr4_context_fabric.context_generation_registry_barrier WHERE ((emr4_context_fabric.context_generation_registry_barrier.practice_id = (practice_source_stream).practice_id) AND (emr4_context_fabric.context_generation_registry_barrier.source_contract_id = (practice_source_stream).source_contract_id) AND (emr4_context_fabric.context_generation_registry_barrier.stream_id = (practice_source_stream).stream_id)) FOR SHARE;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    BEGIN
SELECT emr4_context_fabric.context_observation_stream_head.practice_id, emr4_context_fabric.context_observation_stream_head.source_contract_id, emr4_context_fabric.context_observation_stream_head.stream_id, emr4_context_fabric.context_observation_stream_head.stream_epoch, emr4_context_fabric.context_observation_stream_head.last_position, emr4_context_fabric.context_observation_stream_head.updated_at INTO STRICT retention_head FROM emr4_context_fabric.context_observation_stream_head WHERE ((emr4_context_fabric.context_observation_stream_head.practice_id = (practice_source_stream).practice_id) AND (emr4_context_fabric.context_observation_stream_head.source_contract_id = (practice_source_stream).source_contract_id) AND (emr4_context_fabric.context_observation_stream_head.stream_id = (practice_source_stream).stream_id)) ORDER BY emr4_context_fabric.context_observation_stream_head.practice_id ASC, emr4_context_fabric.context_observation_stream_head.source_contract_id ASC, emr4_context_fabric.context_observation_stream_head.stream_id ASC;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    SELECT COALESCE(pg_catalog.array_agg((ROW(emr4_context_fabric.context_retention_policy.practice_id, emr4_context_fabric.context_retention_policy.source_contract_id, emr4_context_fabric.context_retention_policy.policy_revision, emr4_context_fabric.context_retention_policy.source_grace_seconds, emr4_context_fabric.context_retention_policy.receipt_checkpoint_grace_seconds, emr4_context_fabric.context_retention_policy.audit_grace_seconds, emr4_context_fabric.context_retention_policy.key_overlap_seconds, emr4_context_fabric.context_retention_policy.retention_execution_enabled, emr4_context_fabric.context_retention_policy.effective_at, emr4_context_fabric.context_retention_policy.stream_id))::emr4_context_fabric.context_retention_policy ORDER BY emr4_context_fabric.context_retention_policy.practice_id ASC, emr4_context_fabric.context_retention_policy.source_contract_id ASC, emr4_context_fabric.context_retention_policy.stream_id ASC, emr4_context_fabric.context_retention_policy.policy_revision ASC), ARRAY[]::emr4_context_fabric.context_retention_policy[])
                INTO policy_set
            FROM emr4_context_fabric.context_retention_policy WHERE (((emr4_context_fabric.context_retention_policy.practice_id = (practice_source_stream).practice_id) AND (emr4_context_fabric.context_retention_policy.source_contract_id = (practice_source_stream).source_contract_id) AND (emr4_context_fabric.context_retention_policy.stream_id = (practice_source_stream).stream_id)) AND (emr4_context_fabric.context_retention_policy.effective_at <= pg_catalog.transaction_timestamp()));
    SELECT COALESCE(pg_catalog.array_agg((ROW(emr4_context_fabric.context_observer_generation.practice_id, emr4_context_fabric.context_observer_generation.source_contract_id, emr4_context_fabric.context_observer_generation.stream_id, emr4_context_fabric.context_observer_generation.stream_epoch, emr4_context_fabric.context_observer_generation.observer_id, emr4_context_fabric.context_observer_generation.observer_generation, emr4_context_fabric.context_observer_generation.lifecycle_state, emr4_context_fabric.context_observer_generation.policy_digest, emr4_context_fabric.context_observer_generation.principal_digest, emr4_context_fabric.context_observer_generation.binding_digest, emr4_context_fabric.context_observer_generation.source_digest, emr4_context_fabric.context_observer_generation.registry_digest, emr4_context_fabric.context_observer_generation.impact_digest, emr4_context_fabric.context_observer_generation.key_schedule_digest, emr4_context_fabric.context_observer_generation.created_at, emr4_context_fabric.context_observer_generation.consumed_at, emr4_context_fabric.context_observer_generation.terminal_reason))::emr4_context_fabric.context_observer_generation ORDER BY emr4_context_fabric.context_observer_generation.practice_id ASC, emr4_context_fabric.context_observer_generation.source_contract_id ASC, emr4_context_fabric.context_observer_generation.stream_id ASC, emr4_context_fabric.context_observer_generation.stream_epoch ASC, emr4_context_fabric.context_observer_generation.observer_id ASC, emr4_context_fabric.context_observer_generation.observer_generation ASC), ARRAY[]::emr4_context_fabric.context_observer_generation[])
                INTO generation_set
            FROM emr4_context_fabric.context_observer_generation WHERE (((emr4_context_fabric.context_observer_generation.practice_id = (practice_source_stream).practice_id) AND (emr4_context_fabric.context_observer_generation.source_contract_id = (practice_source_stream).source_contract_id) AND (emr4_context_fabric.context_observer_generation.stream_id = (practice_source_stream).stream_id)) AND (emr4_context_fabric.context_observer_generation.lifecycle_state <> 'CONSUMED'::emr4_context_fabric.generation_state));
    SELECT COALESCE(pg_catalog.array_agg((ROW(emr4_context_fabric.context_durability_checkpoint.practice_id, emr4_context_fabric.context_durability_checkpoint.source_contract_id, emr4_context_fabric.context_durability_checkpoint.stream_id, emr4_context_fabric.context_durability_checkpoint.stream_epoch, emr4_context_fabric.context_durability_checkpoint.observer_id, emr4_context_fabric.context_durability_checkpoint.observer_generation, emr4_context_fabric.context_durability_checkpoint.checkpoint_state, emr4_context_fabric.context_durability_checkpoint.last_contiguous_position, emr4_context_fabric.context_durability_checkpoint.last_observation_digest, emr4_context_fabric.context_durability_checkpoint.lifecycle_revision, emr4_context_fabric.context_durability_checkpoint.audit_head_digest, emr4_context_fabric.context_durability_checkpoint.checkpoint_integrity_digest, emr4_context_fabric.context_durability_checkpoint.updated_at))::emr4_context_fabric.context_durability_checkpoint ORDER BY emr4_context_fabric.context_durability_checkpoint.practice_id ASC, emr4_context_fabric.context_durability_checkpoint.source_contract_id ASC, emr4_context_fabric.context_durability_checkpoint.stream_id ASC, emr4_context_fabric.context_durability_checkpoint.stream_epoch ASC, emr4_context_fabric.context_durability_checkpoint.observer_id ASC, emr4_context_fabric.context_durability_checkpoint.observer_generation ASC, emr4_context_fabric.context_durability_checkpoint.last_contiguous_position ASC), ARRAY[]::emr4_context_fabric.context_durability_checkpoint[])
                INTO checkpoint_set
            FROM emr4_context_fabric.context_durability_checkpoint WHERE (((emr4_context_fabric.context_durability_checkpoint.practice_id = (practice_source_stream).practice_id) AND (emr4_context_fabric.context_durability_checkpoint.source_contract_id = (practice_source_stream).source_contract_id) AND (emr4_context_fabric.context_durability_checkpoint.stream_id = (practice_source_stream).stream_id)) AND (EXISTS (SELECT 1 FROM pg_catalog.unnest(generation_set) AS s WHERE s.practice_id = emr4_context_fabric.context_durability_checkpoint.practice_id AND s.source_contract_id = emr4_context_fabric.context_durability_checkpoint.source_contract_id AND s.stream_id = emr4_context_fabric.context_durability_checkpoint.stream_id AND s.stream_epoch = emr4_context_fabric.context_durability_checkpoint.stream_epoch AND s.observer_id = emr4_context_fabric.context_durability_checkpoint.observer_id AND s.observer_generation = emr4_context_fabric.context_durability_checkpoint.observer_generation)));
    SELECT COALESCE(pg_catalog.array_agg((ROW(emr4_context_fabric.context_recovery_anchor.practice_id, emr4_context_fabric.context_recovery_anchor.source_contract_id, emr4_context_fabric.context_recovery_anchor.stream_id, emr4_context_fabric.context_recovery_anchor.stream_epoch, emr4_context_fabric.context_recovery_anchor.observer_id, emr4_context_fabric.context_recovery_anchor.observer_generation, emr4_context_fabric.context_recovery_anchor.lifecycle_revision, emr4_context_fabric.context_recovery_anchor.checkpoint_state, emr4_context_fabric.context_recovery_anchor.last_contiguous_position, emr4_context_fabric.context_recovery_anchor.last_observation_digest, emr4_context_fabric.context_recovery_anchor.policy_digest, emr4_context_fabric.context_recovery_anchor.principal_digest, emr4_context_fabric.context_recovery_anchor.binding_digest, emr4_context_fabric.context_recovery_anchor.source_digest, emr4_context_fabric.context_recovery_anchor.registry_digest, emr4_context_fabric.context_recovery_anchor.impact_digest, emr4_context_fabric.context_recovery_anchor.key_schedule_digest, emr4_context_fabric.context_recovery_anchor.checkpoint_integrity_digest, emr4_context_fabric.context_recovery_anchor.anchor_digest, emr4_context_fabric.context_recovery_anchor.created_at))::emr4_context_fabric.context_recovery_anchor ORDER BY emr4_context_fabric.context_recovery_anchor.practice_id ASC, emr4_context_fabric.context_recovery_anchor.source_contract_id ASC, emr4_context_fabric.context_recovery_anchor.stream_id ASC, emr4_context_fabric.context_recovery_anchor.stream_epoch ASC, emr4_context_fabric.context_recovery_anchor.observer_id ASC, emr4_context_fabric.context_recovery_anchor.observer_generation ASC, emr4_context_fabric.context_recovery_anchor.lifecycle_revision ASC), ARRAY[]::emr4_context_fabric.context_recovery_anchor[])
