                RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        END;
        RETURN inserted_generation;
    END IF;
END;
$durability_inert$
LANGUAGE plpgsql VOLATILE SECURITY DEFINER STRICT PARALLEL UNSAFE SET search_path = pg_catalog, emr4_context_fabric;
ALTER FUNCTION emr4_context_fabric.register_observer_generation_v1(registration emr4_context_fabric.generation_registration_v1) OWNER TO context_schema_owner;
CREATE FUNCTION emr4_context_fabric.append_recovery_anchor_v1(generation_locator emr4_context_fabric.generation_locator_v1, lifecycle_revision pg_catalog.int8)
RETURNS emr4_context_fabric.context_recovery_anchor
AS $durability_inert$
DECLARE
    binding emr4_context_fabric.context_service_practice_binding;
    binding_allowed pg_catalog.bool;
    barrier emr4_context_fabric.context_generation_registry_barrier;
    generation emr4_context_fabric.context_observer_generation;
    checkpoint emr4_context_fabric.context_durability_checkpoint;
    baseline_anchor_set emr4_context_fabric.context_recovery_anchor[];
    baseline_anchor emr4_context_fabric.context_recovery_anchor;
    anchor_lifecycle emr4_context_fabric.context_durability_lifecycle;
    decision_audit emr4_context_fabric.context_durability_audit;
    decision_receipt_set emr4_context_fabric.context_classified_observation_receipt[];
    decision_receipt emr4_context_fabric.context_classified_observation_receipt;
    anchor_primary_set emr4_context_fabric.context_proofread_observation_admission[];
    anchor_conflict_set emr4_context_fabric.context_proofread_observation_admission[];
    anchor_primary emr4_context_fabric.context_proofread_observation_admission;
    rederived_anchor_receipt_digest emr4_context_fabric.digest_sha256;
    rederived_rebase_integrity emr4_context_fabric.digest_sha256;
    rederived_apply_integrity emr4_context_fabric.digest_sha256;
    key_audit_set emr4_context_fabric.context_durability_audit[];
    key_receipt_set emr4_context_fabric.context_classified_observation_receipt[];
    decision_previous_anchor emr4_context_fabric.context_recovery_anchor;
    anchor_key emr4_context_fabric.context_observation_key_interval;
    key_previous_anchor emr4_context_fabric.context_recovery_anchor;
    rederived_rotation_integrity emr4_context_fabric.digest_sha256;
    trusted_integrity_digest emr4_context_fabric.digest_sha256;
    derived_anchor_digest emr4_context_fabric.digest_sha256;
    anchor_set emr4_context_fabric.context_recovery_anchor[];
    stored_anchor emr4_context_fabric.context_recovery_anchor;
    inserted_anchor emr4_context_fabric.context_recovery_anchor;
    decision_matching_audit_set emr4_context_fabric.context_durability_audit[];
    decision_earlier_audit_set emr4_context_fabric.context_durability_audit[];
    decision_prior_audit emr4_context_fabric.context_durability_audit;
    decision_later_audit_set emr4_context_fabric.context_durability_audit[];
    key_matching_audit_set emr4_context_fabric.context_durability_audit[];
    key_earlier_audit_set emr4_context_fabric.context_durability_audit[];
    key_prior_audit emr4_context_fabric.context_durability_audit;
    key_later_audit_set emr4_context_fabric.context_durability_audit[];
    cf_constraint_name pg_catalog.text;
BEGIN
    IF NOT (pg_catalog.current_setting('transaction_isolation') = 'serializable') THEN
        RAISE EXCEPTION USING ERRCODE = 'CF303', MESSAGE = 'durability_state_ambiguous';
    END IF;
    BEGIN
SELECT emr4_context_fabric.context_service_practice_binding.database_login, emr4_context_fabric.context_service_practice_binding.logical_capability, emr4_context_fabric.context_service_practice_binding.practice_id, emr4_context_fabric.context_service_practice_binding.source_contract_id, emr4_context_fabric.context_service_practice_binding.binding_revision, emr4_context_fabric.context_service_practice_binding.credential_epoch, emr4_context_fabric.context_service_practice_binding.active_from, emr4_context_fabric.context_service_practice_binding.active_until, emr4_context_fabric.context_service_practice_binding.stream_id INTO STRICT binding FROM emr4_context_fabric.context_service_practice_binding WHERE ((emr4_context_fabric.context_service_practice_binding.database_login = session_user) AND (emr4_context_fabric.context_service_practice_binding.logical_capability = 'LIFECYCLE'::emr4_context_fabric.logical_capability) AND (emr4_context_fabric.context_service_practice_binding.source_contract_id = 'diary.appointment_rescheduled.v1'::emr4_context_fabric.source_contract_code) AND (emr4_context_fabric.context_service_practice_binding.active_from <= pg_catalog.transaction_timestamp()) AND ((emr4_context_fabric.context_service_practice_binding.active_until IS NULL) OR (emr4_context_fabric.context_service_practice_binding.active_until > pg_catalog.transaction_timestamp())) AND (emr4_context_fabric.context_service_practice_binding.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_service_practice_binding.stream_id = (generation_locator).stream_id)) ORDER BY emr4_context_fabric.context_service_practice_binding.database_login ASC, emr4_context_fabric.context_service_practice_binding.logical_capability ASC, emr4_context_fabric.context_service_practice_binding.practice_id ASC;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    binding_allowed := emr4_context_fabric.session_binding_allows_v1(session_user, ARRAY['LIFECYCLE'::emr4_context_fabric.logical_capability]::emr4_context_fabric.logical_capability[], binding.practice_id, binding.source_contract_id, binding.stream_id, pg_catalog.transaction_timestamp());
    IF NOT (binding_allowed) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF001', MESSAGE = 'binding_denied';
    END IF;
    BEGIN
SELECT emr4_context_fabric.context_generation_registry_barrier.practice_id, emr4_context_fabric.context_generation_registry_barrier.source_contract_id, emr4_context_fabric.context_generation_registry_barrier.stream_id, emr4_context_fabric.context_generation_registry_barrier.barrier_revision, emr4_context_fabric.context_generation_registry_barrier.updated_at INTO STRICT barrier FROM emr4_context_fabric.context_generation_registry_barrier WHERE ((emr4_context_fabric.context_generation_registry_barrier.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_generation_registry_barrier.source_contract_id = (generation_locator).source_contract_id) AND (emr4_context_fabric.context_generation_registry_barrier.stream_id = (generation_locator).stream_id)) FOR UPDATE;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    BEGIN
SELECT emr4_context_fabric.context_observer_generation.practice_id, emr4_context_fabric.context_observer_generation.source_contract_id, emr4_context_fabric.context_observer_generation.stream_id, emr4_context_fabric.context_observer_generation.stream_epoch, emr4_context_fabric.context_observer_generation.observer_id, emr4_context_fabric.context_observer_generation.observer_generation, emr4_context_fabric.context_observer_generation.lifecycle_state, emr4_context_fabric.context_observer_generation.policy_digest, emr4_context_fabric.context_observer_generation.principal_digest, emr4_context_fabric.context_observer_generation.binding_digest, emr4_context_fabric.context_observer_generation.source_digest, emr4_context_fabric.context_observer_generation.registry_digest, emr4_context_fabric.context_observer_generation.impact_digest, emr4_context_fabric.context_observer_generation.key_schedule_digest, emr4_context_fabric.context_observer_generation.created_at, emr4_context_fabric.context_observer_generation.consumed_at, emr4_context_fabric.context_observer_generation.terminal_reason INTO STRICT generation FROM emr4_context_fabric.context_observer_generation WHERE ((emr4_context_fabric.context_observer_generation.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_observer_generation.source_contract_id = (generation_locator).source_contract_id) AND (emr4_context_fabric.context_observer_generation.stream_id = (generation_locator).stream_id) AND (emr4_context_fabric.context_observer_generation.stream_epoch = (generation_locator).stream_epoch) AND (emr4_context_fabric.context_observer_generation.observer_id = (generation_locator).observer_id) AND (emr4_context_fabric.context_observer_generation.observer_generation = (generation_locator).observer_generation)) FOR SHARE;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    BEGIN
SELECT emr4_context_fabric.context_durability_checkpoint.practice_id, emr4_context_fabric.context_durability_checkpoint.source_contract_id, emr4_context_fabric.context_durability_checkpoint.stream_id, emr4_context_fabric.context_durability_checkpoint.stream_epoch, emr4_context_fabric.context_durability_checkpoint.observer_id, emr4_context_fabric.context_durability_checkpoint.observer_generation, emr4_context_fabric.context_durability_checkpoint.checkpoint_state, emr4_context_fabric.context_durability_checkpoint.last_contiguous_position, emr4_context_fabric.context_durability_checkpoint.last_observation_digest, emr4_context_fabric.context_durability_checkpoint.lifecycle_revision, emr4_context_fabric.context_durability_checkpoint.audit_head_digest, emr4_context_fabric.context_durability_checkpoint.checkpoint_integrity_digest, emr4_context_fabric.context_durability_checkpoint.updated_at INTO STRICT checkpoint FROM emr4_context_fabric.context_durability_checkpoint WHERE ((emr4_context_fabric.context_durability_checkpoint.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_durability_checkpoint.source_contract_id = (generation_locator).source_contract_id) AND (emr4_context_fabric.context_durability_checkpoint.stream_id = (generation_locator).stream_id) AND (emr4_context_fabric.context_durability_checkpoint.stream_epoch = (generation_locator).stream_epoch) AND (emr4_context_fabric.context_durability_checkpoint.observer_id = (generation_locator).observer_id) AND (emr4_context_fabric.context_durability_checkpoint.observer_generation = (generation_locator).observer_generation)) FOR SHARE;
    EXCEPTION
        WHEN NO_DATA_FOUND THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
        WHEN TOO_MANY_ROWS THEN
            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
    END;
    IF NOT ((lifecycle_revision > 0::pg_catalog.int8)) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF301', MESSAGE = 'anchor_missing_or_mismatched';
    END IF;
    IF NOT ((lifecycle_revision = checkpoint.lifecycle_revision)) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF301', MESSAGE = 'anchor_missing_or_mismatched';
    END IF;
    IF NOT (((((generation.lifecycle_state = 'ACTIVE'::emr4_context_fabric.generation_state) AND (checkpoint.checkpoint_state = 'ACTIVE'::emr4_context_fabric.checkpoint_state)) OR ((generation.lifecycle_state = 'REBASE_REQUIRED'::emr4_context_fabric.generation_state) AND (checkpoint.checkpoint_state = 'REBASE_REQUIRED'::emr4_context_fabric.checkpoint_state)) OR ((generation.lifecycle_state = 'REVOKED'::emr4_context_fabric.generation_state) AND (checkpoint.checkpoint_state = 'REVOKED'::emr4_context_fabric.checkpoint_state)) OR ((generation.lifecycle_state = 'CONSUMED'::emr4_context_fabric.generation_state) AND (checkpoint.checkpoint_state = 'CONSUMED'::emr4_context_fabric.checkpoint_state))) AND (generation.policy_digest IS NOT NULL) AND (generation.principal_digest IS NOT NULL) AND (generation.binding_digest IS NOT NULL) AND (generation.source_digest IS NOT NULL) AND (generation.registry_digest IS NOT NULL) AND (generation.impact_digest IS NOT NULL) AND (generation.key_schedule_digest IS NOT NULL) AND (checkpoint.checkpoint_integrity_digest IS NOT NULL))) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF301', MESSAGE = 'anchor_missing_or_mismatched';
    END IF;
    SELECT COALESCE(pg_catalog.array_agg((ROW(emr4_context_fabric.context_recovery_anchor.practice_id, emr4_context_fabric.context_recovery_anchor.source_contract_id, emr4_context_fabric.context_recovery_anchor.stream_id, emr4_context_fabric.context_recovery_anchor.stream_epoch, emr4_context_fabric.context_recovery_anchor.observer_id, emr4_context_fabric.context_recovery_anchor.observer_generation, emr4_context_fabric.context_recovery_anchor.lifecycle_revision, emr4_context_fabric.context_recovery_anchor.checkpoint_state, emr4_context_fabric.context_recovery_anchor.last_contiguous_position, emr4_context_fabric.context_recovery_anchor.last_observation_digest, emr4_context_fabric.context_recovery_anchor.policy_digest, emr4_context_fabric.context_recovery_anchor.principal_digest, emr4_context_fabric.context_recovery_anchor.binding_digest, emr4_context_fabric.context_recovery_anchor.source_digest, emr4_context_fabric.context_recovery_anchor.registry_digest, emr4_context_fabric.context_recovery_anchor.impact_digest, emr4_context_fabric.context_recovery_anchor.key_schedule_digest, emr4_context_fabric.context_recovery_anchor.checkpoint_integrity_digest, emr4_context_fabric.context_recovery_anchor.anchor_digest, emr4_context_fabric.context_recovery_anchor.created_at))::emr4_context_fabric.context_recovery_anchor ORDER BY emr4_context_fabric.context_recovery_anchor.practice_id ASC, emr4_context_fabric.context_recovery_anchor.source_contract_id ASC, emr4_context_fabric.context_recovery_anchor.stream_id ASC, emr4_context_fabric.context_recovery_anchor.stream_epoch ASC, emr4_context_fabric.context_recovery_anchor.observer_id ASC, emr4_context_fabric.context_recovery_anchor.observer_generation ASC, emr4_context_fabric.context_recovery_anchor.lifecycle_revision ASC), ARRAY[]::emr4_context_fabric.context_recovery_anchor[])
                INTO baseline_anchor_set
            FROM emr4_context_fabric.context_recovery_anchor WHERE ((emr4_context_fabric.context_recovery_anchor.practice_id = (generation_locator).practice_id) AND (emr4_context_fabric.context_recovery_anchor.source_contract_id = (generation_locator).source_contract_id) AND (emr4_context_fabric.context_recovery_anchor.stream_id = (generation_locator).stream_id) AND (emr4_context_fabric.context_recovery_anchor.stream_epoch = (generation_locator).stream_epoch) AND (emr4_context_fabric.context_recovery_anchor.observer_id = (generation_locator).observer_id) AND (emr4_context_fabric.context_recovery_anchor.observer_generation = (generation_locator).observer_generation) AND (emr4_context_fabric.context_recovery_anchor.lifecycle_revision = 0::pg_catalog.int8));
    IF NOT (((pg_catalog.coalesce(pg_catalog.array_length(baseline_anchor_set, 1), 0)::pg_catalog.int8) = 1::pg_catalog.int8)) THEN
        RAISE EXCEPTION USING ERRCODE = 'CF301', MESSAGE = 'anchor_missing_or_mismatched';
