y_digest)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || ((registration).registry_digest)::pg_catalog.text) END) || pg_catalog.chr(31) || (CASE WHEN ((registration).impact_digest IS NULL) THEN (33 || ':' || 'emr4_context_fabric.digest_sha256' || ':' || '-1') ELSE (33 || ':' || 'emr4_context_fabric.digest_sha256' || ':' || pg_catalog.octet_length(pg_catalog.convert_to(((registration).impact_digest)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || ((registration).impact_digest)::pg_catalog.text) END) || pg_catalog.chr(31) || (CASE WHEN ((registration).key_schedule_digest IS NULL) THEN (33 || ':' || 'emr4_context_fabric.digest_sha256' || ':' || '-1') ELSE (33 || ':' || 'emr4_context_fabric.digest_sha256' || ':' || pg_catalog.octet_length(pg_catalog.convert_to(((registration).key_schedule_digest)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || ((registration).key_schedule_digest)::pg_catalog.text) END) || pg_catalog.chr(31) || (CASE WHEN (head.last_position IS NULL) THEN (17 || ':' || 'pg_catalog.bigint' || ':' || '-1') ELSE (17 || ':' || 'pg_catalog.bigint' || ':' || pg_catalog.octet_length(pg_catalog.convert_to((head.last_position)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || (head.last_position)::pg_catalog.text) END) || pg_catalog.chr(31) || (CASE WHEN (((registration).initial_key_interval).interval_start IS NULL) THEN (17 || ':' || 'pg_catalog.bigint' || ':' || '-1') ELSE (17 || ':' || 'pg_catalog.bigint' || ':' || pg_catalog.octet_length(pg_catalog.convert_to((((registration).initial_key_interval).interval_start)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || (((registration).initial_key_interval).interval_start)::pg_catalog.text) END) || pg_catalog.chr(31) || (CASE WHEN (((registration).initial_key_interval).interval_end IS NULL) THEN (17 || ':' || 'pg_catalog.bigint' || ':' || '-1') ELSE (17 || ':' || 'pg_catalog.bigint' || ':' || pg_catalog.octet_length(pg_catalog.convert_to((((registration).initial_key_interval).interval_end)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || (((registration).initial_key_interval).interval_end)::pg_catalog.text) END) || pg_catalog.chr(31) || (CASE WHEN (((registration).initial_key_interval).key_id IS NULL) THEN (26 || ':' || 'emr4_context_fabric.key_id' || ':' || '-1') ELSE (26 || ':' || 'emr4_context_fabric.key_id' || ':' || pg_catalog.octet_length(pg_catalog.convert_to((((registration).initial_key_interval).key_id)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || (((registration).initial_key_interval).key_id)::pg_catalog.text) END) || pg_catalog.chr(31) || (CASE WHEN (((registration).initial_key_interval).availability_attestation_digest IS NULL) THEN (33 || ':' || 'emr4_context_fabric.digest_sha256' || ':' || '-1') ELSE (33 || ':' || 'emr4_context_fabric.digest_sha256' || ':' || pg_catalog.octet_length(pg_catalog.convert_to((((registration).initial_key_interval).availability_attestation_digest)::pg_catalog.text, 'UTF8'::pg_catalog.name))::pg_catalog.text || ':' || (((registration).initial_key_interval).availability_attestation_digest)::pg_catalog.text) END), 'UTF8'::pg_catalog.name)), 'hex'))::emr4_context_fabric.digest_sha256) AND (emr4_context_fabric.context_recovery_anchor.created_at = pg_catalog.transaction_timestamp()));
                    EXCEPTION
                        WHEN NO_DATA_FOUND THEN
                            RAISE EXCEPTION USING ERRCODE = 'CF004', MESSAGE = 'required_row_missing_or_ambiguous';
                        WHEN TOO_MANY_ROWS THEN
