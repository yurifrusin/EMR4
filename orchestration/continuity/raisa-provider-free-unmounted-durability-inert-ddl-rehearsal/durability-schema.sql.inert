    WITH selected_keys AS (
        SELECT emr4_context_fabric.diary_context_observation_outbox_v1.practice_id, emr4_context_fabric.diary_context_observation_outbox_v1.source_contract_id, emr4_context_fabric.diary_context_observation_outbox_v1.stream_id, emr4_context_fabric.diary_context_observation_outbox_v1.transaction_position FROM emr4_context_fabric.diary_context_observation_outbox_v1
        WHERE (((emr4_context_fabric.diary_context_observation_outbox_v1.practice_id = (practice_source_stream).practice_id) AND (emr4_context_fabric.diary_context_observation_outbox_v1.source_contract_id = (practice_source_stream).source_contract_id) AND (emr4_context_fabric.diary_context_observation_outbox_v1.stream_id = (practice_source_stream).stream_id)) AND (emr4_context_fabric.diary_context_observation_outbox_v1.transaction_position <= through_position))
        ORDER BY emr4_context_fabric.diary_context_observation_outbox_v1.practice_id, emr4_context_fabric.diary_context_observation_outbox_v1.source_contract_id, emr4_context_fabric.diary_context_observation_outbox_v1.stream_id, emr4_context_fabric.diary_context_observation_outbox_v1.transaction_position
        LIMIT 1000
    ), deleted AS (
        DELETE FROM emr4_context_fabric.diary_context_observation_outbox_v1 AS d USING selected_keys AS s
        WHERE d.practice_id = s.practice_id AND d.source_contract_id = s.source_contract_id AND d.stream_id = s.stream_id AND d.transaction_position = s.transaction_position
        RETURNING d.practice_id
    )
    SELECT pg_catalog.count(*) INTO purged_row_count FROM deleted;
    purge_result := (ROW(purged_row_count, through_position, census_digest))::emr4_context_fabric.context_source_purge_result_v1;
    RETURN purge_result;
END;
$durability_inert$
LANGUAGE plpgsql VOLATILE SECURITY DEFINER STRICT PARALLEL UNSAFE SET search_path = pg_catalog, emr4_context_fabric;
ALTER FUNCTION emr4_context_fabric.purge_source_rows_v1(practice_source_stream emr4_context_fabric.practice_source_stream_v1, through_position pg_catalog.int8) OWNER TO context_schema_owner;
