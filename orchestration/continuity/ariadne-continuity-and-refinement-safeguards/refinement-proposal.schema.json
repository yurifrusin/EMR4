{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/ariadne-refinement-proposal-v1.json",
  "title": "Ariadne refinement proposal",
  "description": "A quarantined, typed harness-lesson proposal. Only closed non-executable kinds and bounded text/digest fields are representable; executable code, dependencies, commands, credentials and runtime tools are not representable. The proposer cannot promote it.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "proposal_id",
    "kind",
    "scope",
    "title",
    "body",
    "base_state_digest",
    "candidate_digest",
    "source_evidence_digests",
    "source_head",
    "proposer",
    "validation_manifest_digest",
    "status",
    "generation"
  ],
  "properties": {
    "schema_version": {
      "const": "ariadne.refinement_proposal.v1"
    },
    "proposal_id": {
      "$ref": "#/$defs/identifier"
    },
    "kind": {
      "enum": [
        "prompt_note",
        "memory_note",
        "skill_description",
        "subagent_spec",
        "policy_note"
      ]
    },
    "scope": {
      "enum": [
        "local",
        "global"
      ]
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\r\\n\\u0000-\\u001f\\u007f]+$"
    },
    "body": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000,
      "pattern": "^(?!\\s)[^\\r\\u0000-\\u0009\\u000b-\\u001f\\u007f]*\\S$"
    },
    "base_state_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "candidate_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "source_evidence_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256Digest"
      }
    },
    "source_head": {
      "$ref": "#/$defs/gitObjectId"
    },
    "proposer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\r\\n\\u0000-\\u001f\\u007f]+$"
    },
    "validation_manifest_digest": {
      "$ref": "#/$defs/sha256Digest"
    },
    "status": {
      "const": "quarantined"
    },
    "generation": {
      "type": "integer",
      "minimum": 1
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{0,127}$"
    },
    "sha256Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "gitObjectId": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    }
  }
}
