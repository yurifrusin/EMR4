{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/ariadne-refinement-promotion-v1.json",
  "title": "Ariadne refinement promotion decision record",
  "description": "An inert, append-only promotion, rejection or rollback decision bound to one exact quarantined proposal and source. The record edits and executes nothing.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "promotion_id",
    "proposal_id",
    "proposal_digest",
    "decision",
    "generation",
    "scope",
    "candidate_digest",
    "base_state_digest",
    "source_head",
    "source_evidence_digests",
    "validation_manifest_digest",
    "validation_result",
    "proposer",
    "promoter",
    "independent_reviewer",
    "promoted_decision_id",
    "reasons"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.refinement_promotion.v1"},
    "promotion_id": {"$ref": "#/$defs/identifier"},
    "proposal_id": {"$ref": "#/$defs/identifier"},
    "proposal_digest": {"$ref": "#/$defs/sha256Digest"},
    "decision": {"enum": ["promote", "reject", "rollback"]},
    "generation": {"type": "integer", "minimum": 1},
    "scope": {"enum": ["local", "global"]},
    "candidate_digest": {"$ref": "#/$defs/sha256Digest"},
    "base_state_digest": {"$ref": "#/$defs/sha256Digest"},
    "source_head": {"$ref": "#/$defs/gitObjectId"},
    "source_evidence_digests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/sha256Digest"}
    },
    "validation_manifest_digest": {"$ref": "#/$defs/sha256Digest"},
    "validation_result": {"enum": ["pass", "fail"]},
    "proposer": {"$ref": "#/$defs/identity"},
    "promoter": {"$ref": "#/$defs/identity"},
    "independent_reviewer": {
      "anyOf": [{"$ref": "#/$defs/identity"}, {"type": "null"}]
    },
    "promoted_decision_id": {
      "anyOf": [{"$ref": "#/$defs/identifier"}, {"type": "null"}]
    },
    "reasons": {
      "type": "array",
      "maxItems": 64,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reason"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"decision": {"const": "promote"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "validation_result": {"const": "pass"},
          "promoter": {"const": "sol"},
          "promoted_decision_id": {"type": "null"},
          "reasons": {"maxItems": 0}
        }
      }
    },
    {
      "if": {
        "properties": {"decision": {"const": "promote"}, "scope": {"const": "global"}},
        "required": ["decision", "scope"]
      },
      "then": {"properties": {"independent_reviewer": {"$ref": "#/$defs/identity"}}}
    },
    {
      "if": {"properties": {"decision": {"const": "reject"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "promoted_decision_id": {"type": "null"},
          "reasons": {"minItems": 1}
        }
      }
    },
    {
      "if": {"properties": {"decision": {"const": "rollback"}}, "required": ["decision"]},
      "then": {
        "properties": {
          "validation_result": {"const": "pass"},
          "promoter": {"const": "sol"},
          "independent_reviewer": {"type": "null"},
          "promoted_decision_id": {"$ref": "#/$defs/identifier"},
          "reasons": {"maxItems": 0}
        }
      }
    }
  ],
  "$defs": {
    "identifier": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$"},
    "sha256Digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "gitObjectId": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\r\\n\\u0000-\\u001f\\u007f]+$"
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!\\s)(?!.*\\s$)[^\\r\\n\\u0000-\\u001f\\u007f]+$"
    }
  }
}
