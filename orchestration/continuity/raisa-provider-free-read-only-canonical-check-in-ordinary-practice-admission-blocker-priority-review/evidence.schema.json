    "external_facts": {"type": "array", "minItems": 6, "maxItems": 6},
    "human_choices": {"type": "array", "minItems": 5, "maxItems": 5},
    "ranked_groups": {"type": "array", "minItems": 5, "maxItems": 5},
    "next_operation": {"type": "object"},
    "parallelism": {"type": "object"},
    "verification": {"type": "object"},
    "closed_boundaries": {"type": "object"}
  }
}
