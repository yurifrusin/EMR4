  "properties": {
    "schema_version": {"const": "raisa.check_in_admission_blocker_priority_evidence.v1"},
    "operation_id": {"const": "raisa-provider-free-read-only-canonical-check-in-ordinary-practice-admission-blocker-priority-review"},
    "result": {"const": "raisa_provider_free_read_only_canonical_check_in_ordinary_practice_admission_blocker_priority_review_pass"},
    "candidate_source": {"pattern": "^[0-9a-f]{40}$"},
    "source_bindings": {"type": "array", "minItems": 5, "maxItems": 5},
