{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/reception-one-plan-program-v2.json",
  "title": "Reception One shared agent-proofreader PlanProgram",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version_code",
    "operator_note",
    "goal_code",
    "steps"
  ],
  "properties": {
    "version_code": {
      "const": 2
    },
    "operator_note": {
      "type": "string",
      "minLength": 1,
      "maxLength": 320
    },
    "goal_code": {
      "type": "integer",
      "minimum": 0,
      "maximum": 6
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "$defs": {
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operator_code",
        "source_codes"
      ],
      "properties": {
        "operator_code": {
          "type": "integer",
          "minimum": 0,
          "maximum": 13
        },
        "source_codes": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "integer",
            "minimum": -1,
            "maximum": 1187
          }
        }
      }
    }
  }
}
