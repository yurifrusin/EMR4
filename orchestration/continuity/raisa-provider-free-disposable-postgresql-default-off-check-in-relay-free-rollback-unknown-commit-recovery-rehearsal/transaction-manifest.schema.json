{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/check-in-relay-free-rollback-unknown-response-transaction-manifest.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "environment_identifier",
    "practice_scope_reference",
    "practice_id",
    "other_practice_id",
    "logical_role_id",
    "physical_role_identifier",
    "authority_git_object",
    "commands",
    "automatic_retry_count",
    "ordinary_admission_release_count",
    "product_record_count"
  ],
  "properties": {
    "schema_version": {"const": "emr4.check-in-relay-free-rollback-unknown-response-transaction-manifest.v1"},
    "environment_identifier": {"const": "env:authored-synthetic-check-in-relay-free-recovery"},
    "practice_scope_reference": {"const": "practice-ref:authored-synthetic/check-in-relay-free-recovery"},
    "practice_id": {"type": "string", "format": "uuid"},
    "other_practice_id": {"type": "string", "format": "uuid"},
    "logical_role_id": {"const": "appointment_check_in_ordinary_runtime_v1"},
    "physical_role_identifier": {"type": "string", "pattern": "^emr4_checkin_rfr_[0-9a-f]{16}$"},
    "authority_git_object": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "commands": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rollback", "ambiguous_response"],
      "properties": {
        "rollback": {"$ref": "#/$defs/command"},
        "ambiguous_response": {"$ref": "#/$defs/command"}
      }
    },
    "automatic_retry_count": {"const": 0},
    "ordinary_admission_release_count": {"const": 0},
    "product_record_count": {"const": 0}
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command_id", "effect_id", "audit_id", "idempotency_identity", "request_sha256"],
      "properties": {
        "command_id": {"type": "string", "format": "uuid"},
        "effect_id": {"type": "string", "format": "uuid"},
        "audit_id": {"type": "string", "format": "uuid"},
        "idempotency_identity": {"type": "string", "pattern": "^idem:authored-synthetic/[a-z0-9-]{8,80}$"},
        "request_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
