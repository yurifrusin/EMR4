{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/ariadne-deepseek-in-cell-rehearsal-evidence.schema.json",
  "title": "Ariadne DeepSeek In-Cell Rehearsal Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "protocol_id",
    "result",
    "status",
    "reason_codes",
    "evidence_label",
    "source_hashes",
    "image_build_evidence_sha256",
    "topology",
    "model",
    "attempt",
    "broker_events",
    "usage",
    "cost_context",
    "generated_draft_hashes",
    "generated_draft_bodies_committed",
    "raw_prompt_committed",
    "raw_provider_response_committed",
    "chain_of_thought_committed",
    "schema_validation",
    "proofreader",
    "effective_policy",
    "cleanup",
    "product_connections",
    "claim_limits"
  ],
  "properties": {
    "schema_version": {
      "const": "ariadne.deepseek_in_cell_rehearsal_evidence.v1"
    },
    "protocol_id": {
      "const": "ariadne-deepseek-in-cell-generated-draft-rehearsal"
    },
    "result": {
      "enum": [
        "ariadne_deepseek_in_cell_generated_draft_rehearsal_pass",
        "ariadne_deepseek_in_cell_generated_draft_rehearsal_revision_required"
      ]
    },
    "status": {
      "enum": [
        "passed",
        "revision_required"
      ]
    },
    "reason_codes": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "evidence_label": {
      "enum": [
        "live_provider_authored_synthetic_generated_draft_rehearsal",
        "provider_transport_attempt_authored_synthetic_no_provider_call"
      ]
    },
    "evidence_correction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "original_evidence_sha256",
        "executed_host_runner_sha256",
        "corrected_fields",
        "runtime_observations_changed"
      ],
      "properties": {
        "kind": {
          "const": "metadata-only-evidence-labelling-correction"
        },
        "original_evidence_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "executed_host_runner_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "corrected_fields": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime_observations_changed": {
          "const": false
        }
      }
    },
    "source_hashes": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "$ref": "#/$defs/sha256"
      }
    },
    "image_build_evidence_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "topology": {
      "type": "object"
    },
    "model": {
      "type": "object"
    },
    "attempt": {
      "type": "object"
    },
    "broker_events": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "usage": {
      "type": "object"
    },
    "cost_context": {
      "type": "object"
    },
    "generated_draft_hashes": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "generated_draft_bodies_committed": {
      "const": false
    },
    "raw_prompt_committed": {
      "const": false
    },
    "raw_provider_response_committed": {
      "const": false
    },
    "chain_of_thought_committed": {
      "const": false
    },
    "schema_validation": {
      "enum": [
        "not-presented",
        "passed",
        "failed"
      ]
    },
    "proofreader": {
      "type": [
        "object",
        "null"
      ]
    },
    "effective_policy": {
      "type": "object"
    },
    "cleanup": {
      "type": "object",
      "minProperties": 5,
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "product_connections": {
      "type": "object",
      "additionalProperties": {
        "const": false
      }
    },
    "claim_limits": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    }
  }
}
