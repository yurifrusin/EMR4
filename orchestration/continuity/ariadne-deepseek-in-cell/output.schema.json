{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/ariadne-deepseek-in-cell-output.schema.json",
  "title": "Ariadne DeepSeek In-Cell Generated Draft Envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "drafts"
  ],
  "properties": {
    "drafts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "allOf": [
            {
              "$ref": "#/$defs/draft"
            },
            {
              "properties": {
                "id": {
                  "const": "draft-ux-primary"
                },
                "output_port_id": {
                  "const": "port-ux"
                },
                "frame_type": {
                  "const": "booking-ux-projection-candidate.v1"
                },
                "authority_class": {
                  "const": "candidate"
                },
                "source_frame_ids": {
                  "$ref": "#/$defs/bookingSources"
                },
                "payload": {
                  "$ref": "#/$defs/uxPayload"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/draft"
            },
            {
              "properties": {
                "id": {
                  "const": "draft-human-primary"
                },
                "output_port_id": {
                  "const": "port-human-review"
                },
                "frame_type": {
                  "const": "booking-human-review-candidate.v1"
                },
                "authority_class": {
                  "const": "candidate"
                },
                "source_frame_ids": {
                  "$ref": "#/$defs/bookingSources"
                },
                "payload": {
                  "$ref": "#/$defs/humanPayload"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/draft"
            },
            {
              "properties": {
                "id": {
                  "const": "draft-audit-primary"
                },
                "output_port_id": {
                  "const": "port-audit"
                },
                "frame_type": {
                  "const": "work-cell-audit-evidence.v1"
                },
                "authority_class": {
                  "const": "evidence"
                },
                "source_frame_ids": {
                  "$ref": "#/$defs/auditSources"
                },
                "payload": {
                  "$ref": "#/$defs/auditPayload"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/draft"
            },
            {
              "properties": {
                "id": {
                  "const": "draft-orchestrator-primary"
                },
                "output_port_id": {
                  "const": "port-orchestrator"
                },
                "frame_type": {
                  "const": "work-cell-outcome.v1"
                },
                "authority_class": {
                  "const": "evidence"
                },
                "source_frame_ids": {
                  "$ref": "#/$defs/auditSources"
                },
                "payload": {
                  "$ref": "#/$defs/orchestratorPayload"
                }
              }
            }
          ]
        },
        {
          "allOf": [
            {
              "$ref": "#/$defs/draft"
            },
            {
              "properties": {
                "id": {
                  "const": "draft-advisory-primary"
                },
                "output_port_id": {
                  "const": "port-advisory"
                },
                "frame_type": {
                  "const": "booking-explanation-advisory.v1"
                },
                "authority_class": {
                  "const": "advisory"
                },
                "source_frame_ids": {
                  "$ref": "#/$defs/advisorySources"
                },
                "payload": {
                  "$ref": "#/$defs/advisoryPayload"
                }
              }
            }
          ]
        }
      ],
      "items": false
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "freshness": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "observed_at",
        "maximum_age_seconds"
      ],
      "properties": {
        "status": {
          "const": "current"
        },
        "observed_at": {
          "const": "2026-07-23T09:00:10+10:00"
        },
        "maximum_age_seconds": {
          "const": 300
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source"
      ],
      "properties": {
        "kind": {
          "const": "model-generated-draft"
        },
        "source": {
          "const": "generated-attempt-001"
        }
      }
    },
    "draft": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "batch_id",
        "attempt_id",
        "output_port_id",
        "frame_type",
        "authority_class",
        "practice_id",
        "principal_id",
        "correlation_id",
        "context_revision",
        "source_frame_ids",
        "payload",
        "provenance",
        "freshness"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "batch_id": {
          "const": "generated-batch-001"
        },
        "attempt_id": {
          "const": "generated-attempt-001"
        },
        "output_port_id": {
          "$ref": "#/$defs/id"
        },
        "frame_type": {
          "type": "string",
          "minLength": 1
        },
        "authority_class": {
          "enum": [
            "evidence",
            "advisory",
            "candidate"
          ]
        },
        "practice_id": {
          "const": "practice-synth-a"
        },
        "principal_id": {
          "const": "principal-reception"
        },
        "correlation_id": {
          "const": "booking-request-001"
        },
        "context_revision": {
          "const": 7
        },
        "source_frame_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "input-request-scope",
              "input-principal-scope",
              "input-patient-candidates",
              "input-practitioner",
              "input-availability",
              "input-policy"
            ]
          }
        },
        "payload": {
          "type": "object"
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        },
        "freshness": {
          "$ref": "#/$defs/freshness"
        }
      }
    },
    "bookingSources": {
      "type": "array",
      "prefixItems": [
        {
          "const": "input-request-scope"
        },
        {
          "const": "input-patient-candidates"
        },
        {
          "const": "input-practitioner"
        },
        {
          "const": "input-availability"
        },
        {
          "const": "input-policy"
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "auditSources": {
      "type": "array",
      "prefixItems": [
        {
          "const": "input-request-scope"
        },
        {
          "const": "input-principal-scope"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "advisorySources": {
      "type": "array",
      "prefixItems": [
        {
          "const": "input-practitioner"
        },
        {
          "const": "input-availability"
        }
      ],
      "items": false,
      "minItems": 2,
      "maxItems": 2
    },
    "candidateSlots": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "uniqueItems": true,
      "items": {
        "enum": [
          "slot-1430",
          "slot-1500",
          "slot-1530"
        ]
      }
    },
    "uxPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patient_candidate_id",
        "practitioner_id",
        "candidate_slot_ids",
        "selected_slot_id",
        "duration_minutes",
        "projection_code",
        "context_revision"
      ],
      "properties": {
        "patient_candidate_id": {
          "enum": [
            "patient-candidate-a",
            "patient-candidate-b"
          ]
        },
        "practitioner_id": {
          "const": "practitioner-a"
        },
        "candidate_slot_ids": {
          "$ref": "#/$defs/candidateSlots"
        },
        "selected_slot_id": {
          "enum": [
            "slot-1430",
            "slot-1500",
            "slot-1530"
          ]
        },
        "duration_minutes": {
          "const": 30
        },
        "projection_code": {
          "const": "show-ranked-slots"
        },
        "context_revision": {
          "const": 7
        }
      }
    },
    "humanPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "patient_candidate_id",
        "practitioner_id",
        "candidate_slot_ids",
        "selected_slot_id",
        "duration_minutes",
        "review_reason_codes",
        "confirmation_required",
        "context_revision"
      ],
      "properties": {
        "patient_candidate_id": {
          "enum": [
            "patient-candidate-a",
            "patient-candidate-b"
          ]
        },
        "practitioner_id": {
          "const": "practitioner-a"
        },
        "candidate_slot_ids": {
          "$ref": "#/$defs/candidateSlots"
        },
        "selected_slot_id": {
          "enum": [
            "slot-1430",
            "slot-1500",
            "slot-1530"
          ]
        },
        "duration_minutes": {
          "const": 30
        },
        "review_reason_codes": {
          "type": "array",
          "prefixItems": [
            {
              "const": "identity-candidate-requires-staff-review"
            },
            {
              "const": "appointment-write-requires-separate-command"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "confirmation_required": {
          "const": true
        },
        "context_revision": {
          "const": 7
        }
      }
    },
    "auditPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "outcome_code",
        "attempt_id",
        "evidence_codes",
        "context_revision"
      ],
      "properties": {
        "outcome_code": {
          "const": "candidate-prepared"
        },
        "attempt_id": {
          "const": "generated-attempt-001"
        },
        "evidence_codes": {
          "type": "array",
          "prefixItems": [
            {
              "const": "grounded-context"
            },
            {
              "const": "human-authority-required"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "context_revision": {
          "const": 7
        }
      }
    },
    "orchestratorPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "completed_port_ids",
        "context_revision"
      ],
      "properties": {
        "status": {
          "const": "candidate-prepared"
        },
        "completed_port_ids": {
          "type": "array",
          "prefixItems": [
            {
              "const": "port-ux"
            },
            {
              "const": "port-human-review"
            },
            {
              "const": "port-audit"
            },
            {
              "const": "port-orchestrator"
            },
            {
              "const": "port-advisory"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        "context_revision": {
          "const": 7
        }
      }
    },
    "advisoryPayload": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "advisory_code",
        "grounding_ids",
        "context_revision"
      ],
      "properties": {
        "advisory_code": {
          "const": "candidate-ranking-explanation-available"
        },
        "grounding_ids": {
          "type": "array",
          "prefixItems": [
            {
              "const": "slot-1430"
            },
            {
              "const": "practitioner-a"
            }
          ],
          "items": false,
          "minItems": 2,
          "maxItems": 2
        },
        "context_revision": {
          "const": 7
        }
      }
    }
  }
}
