{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/ariadne-continuity-graph.schema.json",
  "title": "Ariadne Continuity Graph",
  "description": "Metadata-only EMR4 work lineage, inherited contracts, evidence pointers, and candidate knowledge harvests.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "graph_revision",
    "updated_at",
    "governance",
    "contracts",
    "nodes",
    "harvests"
  ],
  "properties": {
    "schema_version": { "const": "ariadne.continuity_graph.v1" },
    "project_id": { "$ref": "#/$defs/id" },
    "graph_revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "$ref": "#/$defs/timestamp" },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["advisory_only", "closed_boundaries"],
      "properties": {
        "advisory_only": { "const": true },
        "closed_boundaries": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/id" }
        }
      }
    },
    "contracts": {
      "type": "array",
      "items": { "$ref": "#/$defs/contract" }
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" }
    },
    "harvests": {
      "type": "array",
      "items": { "$ref": "#/$defs/harvest" }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "repoPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*://)(?!.*\\\\).+$"
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plans", "acceptances", "receipts", "tests", "closeouts", "findings"],
      "properties": {
        "plans": { "$ref": "#/$defs/repoPaths" },
        "acceptances": { "$ref": "#/$defs/repoPaths" },
        "receipts": { "$ref": "#/$defs/repoPaths" },
        "tests": { "$ref": "#/$defs/repoPaths" },
        "closeouts": { "$ref": "#/$defs/repoPaths" },
        "findings": { "$ref": "#/$defs/repoPaths" },
        "artifacts": { "$ref": "#/$defs/repoPaths" }
      }
    },
    "repoPaths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/repoPath" }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "relation"],
      "properties": {
        "node_id": { "$ref": "#/$defs/id" },
        "relation": {
          "enum": ["builds_on", "implements", "validates", "forked_from", "synthesizes", "supersedes", "protects"]
        }
      }
    },
    "contractEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_id", "status", "evidence"],
      "properties": {
        "contract_id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["satisfied", "waived", "gap"] },
        "evidence": { "$ref": "#/$defs/repoPaths" },
        "waiver_source": { "$ref": "#/$defs/repoPath" },
        "note": { "type": "string", "minLength": 1 }
      }
    },
    "decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "status", "summary", "source"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "status": { "enum": ["candidate", "accepted", "rejected"] },
        "summary": { "type": "string", "minLength": 1 },
        "source": { "$ref": "#/$defs/repoPath" }
      }
    },
    "opening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["boundary", "source"],
      "properties": {
        "boundary": { "$ref": "#/$defs/id" },
        "source": { "$ref": "#/$defs/repoPath" },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id", "title", "kind", "status", "created_at", "updated_at",
        "relationships", "coordinates", "evidence", "authority",
        "contract_evidence", "decisions", "unresolved_gates", "claim_scope"
      ],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "kind": {
          "enum": ["foundation", "concept", "implementation", "integration", "review", "tooling", "exploration", "synthesis", "maintenance"]
        },
        "status": { "enum": ["planned", "active", "accepted", "rejected", "superseded", "closed"] },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "updated_at": { "$ref": "#/$defs/timestamp" },
        "relationships": { "type": "array", "items": { "$ref": "#/$defs/relationship" } },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["thread_id", "git_ref", "source_head", "worktree_role"],
          "properties": {
            "thread_id": { "type": ["string", "null"] },
            "git_ref": { "type": "string", "minLength": 1 },
            "source_head": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
            "worktree_role": { "enum": ["integration", "task", "historical", "none"] }
          }
        },
        "evidence": { "$ref": "#/$defs/evidence" },
        "authority": {
          "type": "object",
          "additionalProperties": false,
          "required": ["authorized_openings", "notes"],
          "properties": {
            "authorized_openings": { "type": "array", "items": { "$ref": "#/$defs/opening" } },
            "notes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
          }
        },
        "contract_evidence": { "type": "array", "items": { "$ref": "#/$defs/contractEvidence" } },
        "decisions": { "type": "array", "items": { "$ref": "#/$defs/decision" } },
        "unresolved_gates": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "claim_scope": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "description", "source_node", "applies_to_kinds", "required_evidence_types", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 },
        "source_node": { "$ref": "#/$defs/id" },
        "applies_to_kinds": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
        "required_evidence_types": { "type": "array", "items": { "enum": ["plans", "acceptances", "receipts", "tests", "closeouts", "findings"] }, "uniqueItems": true },
        "evidence": { "$ref": "#/$defs/repoPaths" }
      }
    },
    "harvest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "source_nodes", "target_node", "created_at", "status", "summary", "decisions", "evidence"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "source_nodes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "target_node": { "$ref": "#/$defs/id" },
        "created_at": { "$ref": "#/$defs/timestamp" },
        "status": { "enum": ["candidate", "promoted", "rejected"] },
        "summary": { "type": "string", "minLength": 1 },
        "decisions": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidence": { "$ref": "#/$defs/repoPaths" }
      }
    }
  }
}
