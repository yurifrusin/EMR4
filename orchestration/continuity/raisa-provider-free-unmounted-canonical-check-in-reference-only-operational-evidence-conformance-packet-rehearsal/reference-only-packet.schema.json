{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.example/schemas/check-in-reference-only-conformance-packet-v1.json",
  "title": "Canonical check-in authored-synthetic reference-only conformance packet",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "classification",
    "operational_fact_status",
    "evaluation_time",
    "manifest",
    "operational_evidence",
    "admission",
    "readiness",
    "external_fact_ids",
    "human_choice_ids"
  ],
  "properties": {
    "schema_version": {"const": "raisa.check_in_reference_only_conformance_packet.v1"},
    "classification": {"const": "authored_synthetic_opaque_reference_only"},
    "operational_fact_status": {"const": "not_established"},
    "evaluation_time": {"const": "2026-08-25T00:00:00Z"},
    "manifest": {"$ref": "#/$defs/manifest"},
    "operational_evidence": {"$ref": "#/$defs/operational_evidence"},
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["snapshot", "request"],
      "properties": {
        "snapshot": {"$ref": "#/$defs/admission_snapshot"},
        "request": {"$ref": "#/$defs/admission_request"}
      }
    },
    "readiness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["satisfied", "blocking_gap", "operational_evidence_gap", "verdict", "repository_prerequisites_remaining_after_pass"],
      "properties": {
        "satisfied": {"const": 11},
        "blocking_gap": {"const": 0},
        "operational_evidence_gap": {"const": 1},
        "verdict": {"const": "not_ready_for_ordinary_practice_admission"},
        "repository_prerequisites_remaining_after_pass": {"const": 0}
      }
    },
    "external_fact_ids": {
      "type": "array",
      "prefixItems": [
        {"const": "live_runtime_role_binding_and_attestation"},
        {"const": "three_current_opaque_secret_bindings"},
        {"const": "three_current_rotation_custody_attestations"},
        {"const": "current_deny_only_break_glass_posture"},
        {"const": "one_current_environment_manifest_instance"},
        {"const": "operational_uniqueness_and_freshness_readback"}
      ],
      "items": false,
      "minItems": 6,
      "maxItems": 6,
      "uniqueItems": true
    },
    "human_choice_ids": {
      "type": "array",
      "prefixItems": [
        {"const": "select_target_environment_and_practice_scope"},
        {"const": "approve_secret_custody_and_operational_owners"},
        {"const": "approve_rotation_policy_and_independent_verifiers"},
        {"const": "authorize_live_role_secret_and_manifest_provisioning"},
        {"const": "confirm_ordinary_activation_separately"}
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true
    }
  },
  "$defs": {
    "full_git_object": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "reference": {"type": "string", "pattern": "^[a-z-]+:[a-z0-9][a-z0-9._/-]{2,127}$"},
    "environment_identifier": {"type": "string", "pattern": "^env:[a-z0-9][a-z0-9._-]{2,95}$"},
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "manifest_id", "environment", "admission_snapshot_generation", "authority_git_object", "practice_scope_reference", "runtime_role", "secret_references", "rotation_evidence", "break_glass", "issued_at", "expires_at"],
      "properties": {
        "schema_version": {"const": "emr4.check-in-ordinary-environment-manifest.v1"},
        "manifest_id": {"type": "string"},
        "environment": {
          "type": "object",
          "additionalProperties": false,
          "required": ["class", "identifier"],
          "properties": {
            "class": {"enum": ["development", "test", "staging", "production"]},
            "identifier": {"$ref": "#/$defs/environment_identifier"}
          }
        },
        "admission_snapshot_generation": {"type": "integer", "minimum": 1},
        "authority_git_object": {"$ref": "#/$defs/full_git_object"},
        "practice_scope_reference": {"$ref": "#/$defs/reference"},
        "runtime_role": {"$ref": "#/$defs/runtime_role"},
        "secret_references": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/secret_reference"}
        },
        "rotation_evidence": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/rotation_evidence"}
        },
        "break_glass": {"$ref": "#/$defs/manifest_break_glass"},
        "issued_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "runtime_role": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_role_id", "database_role_identifier", "credential_secret_slot_id", "non_owner_required", "nobypassrls_required", "product_relation_ownership_allowed", "tenant_attestation_reference"],
      "properties": {
        "logical_role_id": {"const": "appointment_check_in_ordinary_runtime_v1"},
        "database_role_identifier": {"type": "string"},
        "credential_secret_slot_id": {"const": "database_connection_credential"},
        "non_owner_required": {"const": true},
        "nobypassrls_required": {"const": true},
        "product_relation_ownership_allowed": {"const": false},
        "tenant_attestation_reference": {"$ref": "#/$defs/reference"}
      }
    },
    "secret_reference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "provider_namespace", "secret_reference", "key_id", "version", "rotation_policy_reference", "rotation_evidence_reference"],
      "properties": {
        "slot_id": {"enum": ["database_connection_credential", "application_token_signing_key", "admission_snapshot_verification_key"]},
        "provider_namespace": {"type": "string"},
        "secret_reference": {"$ref": "#/$defs/reference"},
        "key_id": {"type": "string"},
        "version": {"type": "string"},
        "rotation_policy_reference": {"$ref": "#/$defs/reference"},
        "rotation_evidence_reference": {"$ref": "#/$defs/reference"}
      }
    },
    "rotation_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slot_id", "evidence_reference", "artifact_sha256", "authority_git_object", "environment_identifier", "admission_snapshot_generation", "key_id", "version", "rotation_sequence", "observed_at", "fresh_until", "independent_verifier_reference"],
      "properties": {
        "slot_id": {"enum": ["database_connection_credential", "application_token_signing_key", "admission_snapshot_verification_key"]},
        "evidence_reference": {"$ref": "#/$defs/reference"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "authority_git_object": {"$ref": "#/$defs/full_git_object"},
        "environment_identifier": {"$ref": "#/$defs/environment_identifier"},
        "admission_snapshot_generation": {"type": "integer", "minimum": 1},
        "key_id": {"type": "string"},
        "version": {"type": "string"},
        "rotation_sequence": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "fresh_until": {"type": "string", "format": "date-time"},
        "independent_verifier_reference": {"$ref": "#/$defs/reference"}
      }
    },
    "manifest_break_glass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "state", "evidence_reference", "bypass_allowed", "secret_injection_allowed", "automatic_clear_allowed"],
      "properties": {
        "mode": {"const": "deny_only"},
        "state": {"enum": ["inactive", "engaged_deny", "retired"]},
        "evidence_reference": {"$ref": "#/$defs/reference"},
        "bypass_allowed": {"const": false},
        "secret_injection_allowed": {"const": false},
        "automatic_clear_allowed": {"const": false}
      }
    },
    "operational_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "role_attestation", "rotation_custody_attestations", "break_glass_evidence"],
      "properties": {
        "schema_version": {"const": "emr4.check-in-operational-evidence-inputs.v1"},
        "role_attestation": {"$ref": "#/$defs/role_attestation"},
        "rotation_custody_attestations": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "items": {"$ref": "#/$defs/rotation_evidence"}
        },
        "break_glass_evidence": {"$ref": "#/$defs/break_glass_evidence"}
      }
    },
    "role_attestation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_reference", "artifact_sha256", "authority_git_object", "environment_identifier", "admission_snapshot_generation", "logical_role_id", "database_role_identifier", "credential_secret_slot_id", "ownership_observation", "rls_bypass_observation", "product_relation_ownership_observation", "cross_tenant_probe_observation", "observed_at", "fresh_until", "independent_verifier_reference"],
      "properties": {
        "evidence_reference": {"$ref": "#/$defs/reference"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "authority_git_object": {"$ref": "#/$defs/full_git_object"},
        "environment_identifier": {"$ref": "#/$defs/environment_identifier"},
        "admission_snapshot_generation": {"type": "integer", "minimum": 1},
        "logical_role_id": {"const": "appointment_check_in_ordinary_runtime_v1"},
        "database_role_identifier": {"type": "string"},
        "credential_secret_slot_id": {"const": "database_connection_credential"},
        "ownership_observation": {"enum": ["non_owner", "owner", "unknown"]},
        "rls_bypass_observation": {"enum": ["nobypassrls", "bypassrls", "unknown"]},
        "product_relation_ownership_observation": {"enum": ["absent", "present", "unknown"]},
        "cross_tenant_probe_observation": {"enum": ["denied", "allowed", "not_observed"]},
        "observed_at": {"type": "string", "format": "date-time"},
        "fresh_until": {"type": "string", "format": "date-time"},
        "independent_verifier_reference": {"$ref": "#/$defs/reference"}
      }
    },
    "break_glass_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "state", "evidence_reference", "artifact_sha256", "authority_git_object", "environment_identifier", "admission_snapshot_generation", "observed_at", "fresh_until", "independent_verifier_reference"],
      "properties": {
        "mode": {"const": "deny_only"},
        "state": {"enum": ["inactive", "engaged_deny", "retired"]},
        "evidence_reference": {"$ref": "#/$defs/reference"},
        "artifact_sha256": {"$ref": "#/$defs/sha256"},
        "authority_git_object": {"$ref": "#/$defs/full_git_object"},
        "environment_identifier": {"$ref": "#/$defs/environment_identifier"},
        "admission_snapshot_generation": {"type": "integer", "minimum": 1},
        "observed_at": {"type": "string", "format": "date-time"},
        "fresh_until": {"type": "string", "format": "date-time"},
        "independent_verifier_reference": {"$ref": "#/$defs/reference"}
      }
    },
    "admission_snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "signature_valid", "authority_git_object", "authority_git_object_resolved", "fresh", "environment", "snapshot_generation", "snapshot_digest", "current_record_count", "kill_switch", "ordinary_record", "environment_evidence_identifier"],
      "properties": {
        "schema_version": {"const": "emr4.check-in-admission-kernel.v1"},
        "signature_valid": {"const": true},
        "authority_git_object": {"$ref": "#/$defs/full_git_object"},
        "authority_git_object_resolved": {"const": true},
        "fresh": {"const": true},
        "environment": {"const": "test"},
        "snapshot_generation": {"const": 7},
        "snapshot_digest": {"$ref": "#/$defs/sha256"},
        "current_record_count": {"const": 1},
        "kill_switch": {"const": "clear"},
        "ordinary_record": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "practice_id", "environment", "operation_family", "record_version", "snapshot_generation", "operational_evidence_valid"],
          "properties": {
            "state": {"const": "active"},
            "practice_id": {"const": "authored-reference-practice"},
            "environment": {"const": "test"},
            "operation_family": {"const": "canonical_check_in"},
            "record_version": {"const": 1},
            "snapshot_generation": {"const": 7},
            "operational_evidence_valid": {"const": true}
          }
        },
        "environment_evidence_identifier": {"const": "env:authored-reference"}
      }
    },
    "admission_request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feature_enabled", "authored_synthetic_admitted", "practice_id", "environment", "operation_family"],
      "properties": {
        "feature_enabled": {"const": true},
        "authored_synthetic_admitted": {"const": false},
        "practice_id": {"const": "authored-reference-practice"},
        "environment": {"const": "test"},
        "operation_family": {"const": "canonical_check_in"}
      }
    }
  }
}
