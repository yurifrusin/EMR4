{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/relay-free-oci-transport-evidence.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "result", "evidence_label", "source_head",
    "decision_transition_source", "contract_sha256", "source_binding_count",
    "hostile_mutations", "containment", "transport", "closed_state",
    "database", "provider_calls", "lifecycle", "cleanup",
    "elapsed_milliseconds"
  ],
  "properties": {
    "schema_version": {"const": "emr4.relay-free-oci-transport-evidence.v1"},
    "result": {"const": "raisa_provider_free_default_off_check_in_relay_free_unknown_response_transport_redesign_pass"},
    "evidence_label": {"const": "authored_synthetic_provider_free_no_database_relay_free_oci_result_transport"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "decision_transition_source": {"const": "44c1c8efa2357d9ebdc9ec895fd31e5758bc66d4"},
    "contract_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_binding_count": {"const": 14},
    "hostile_mutations": {
      "type": "object", "additionalProperties": false,
      "required": ["contract_attempted", "contract_rejected", "state_attempted", "state_rejected", "escapes"],
      "properties": {
        "contract_attempted": {"type": "integer", "minimum": 256},
        "contract_rejected": {"type": "integer", "minimum": 256},
        "state_attempted": {"type": "integer", "minimum": 96},
        "state_rejected": {"type": "integer", "minimum": 96},
        "escapes": {"const": 0}
      }
    },
    "containment": {
      "type": "object", "additionalProperties": false,
      "required": ["image_reference", "image_id_sha256", "pulls", "network_mode", "published_ports", "bind_mounts", "volumes", "tmpfs_count", "log_driver", "read_only_rootfs"],
      "properties": {
        "image_reference": {"const": "postgres:16-bookworm"},
        "image_id_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "pulls": {"const": 0},
        "network_mode": {"const": "none"},
        "published_ports": {"const": false},
        "bind_mounts": {"const": 0},
        "volumes": {"const": 0},
        "tmpfs_count": {"const": 1},
        "log_driver": {"const": "none"},
        "read_only_rootfs": {"const": true}
      }
    },
    "transport": {
      "type": "object", "additionalProperties": false,
      "required": ["credential_input", "attachment_is_outcome_evidence", "outcome_source", "classification", "complete_terminal_response", "success_released", "automatic_retries"],
      "properties": {
        "credential_input": {"const": "attached_stdin_process_memory_only"},
        "attachment_is_outcome_evidence": {"const": false},
        "outcome_source": {"const": "captured_container_oci_state"},
        "classification": {"const": "simulated_connection_lost_without_complete_terminal_response"},
        "complete_terminal_response": {"const": false},
        "success_released": {"const": false},
        "automatic_retries": {"const": 0}
      }
    },
    "closed_state": {
      "type": "object", "additionalProperties": false,
      "required": ["identity_match", "running", "exit_code", "oom_killed", "state_error_empty", "restart_count"],
      "properties": {
        "identity_match": {"const": true},
        "running": {"const": false},
        "exit_code": {"const": 42},
        "oom_killed": {"const": false},
        "state_error_empty": {"const": true},
        "restart_count": {"const": 0}
      }
    },
    "database": {
      "type": "object", "additionalProperties": false,
      "required": ["postgres_process_started", "connections", "transactions", "sql_statements", "product_rows", "ordinary_admission_releases"],
      "properties": {
        "postgres_process_started": {"const": false},
        "connections": {"const": 0},
        "transactions": {"const": 0},
        "sql_statements": {"const": 0},
        "product_rows": {"const": 0},
        "ordinary_admission_releases": {"const": 0}
      }
    },
    "provider_calls": {"const": 0},
    "lifecycle": {"type": "array", "minItems": 8, "items": {"type": "string", "pattern": "^[a-z0-9_]+$"}, "uniqueItems": true},
    "cleanup": {
      "type": "object", "additionalProperties": false,
      "required": ["attachment_absent_before_cleanup", "captured_container_absent", "matching_nonce_resources", "status"],
      "properties": {
        "attachment_absent_before_cleanup": {"const": true},
        "captured_container_absent": {"const": true},
        "matching_nonce_resources": {"const": 0},
        "status": {"const": "cleanup_verified"}
      }
    },
    "elapsed_milliseconds": {"type": "integer", "minimum": 0, "maximum": 60000}
  }
}
