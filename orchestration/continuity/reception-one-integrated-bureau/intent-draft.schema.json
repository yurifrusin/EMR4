{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/reception.one.intent-draft.v1.json",
  "title": "Reception One untrusted typed intent draft",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "context_revision",
    "family",
    "operation",
    "date_relation",
    "target_date",
    "practitioner_ids",
    "time_window",
    "duration_minutes",
    "source_evidence_paths"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "reception.one.intent-draft.v1"},
    "request_id": {"type": "string", "pattern": "^synthetic-request-[a-z0-9-]{1,64}$"},
    "context_revision": {"type": "string", "pattern": "^synthetic-diary-revision-[a-z0-9-]{1,48}$"},
    "family": {
      "enum": [
        "focused_schedule_lane",
        "patient_timeline",
        "availability_slots",
        "aligned_comparison",
        "ordinary_overview",
        "clarification"
      ]
    },
    "operation": {"const": "view"},
    "date_relation": {"enum": ["same_day", "tomorrow", "explicit_date"]},
    "target_date": {"type": "string", "format": "date"},
    "practitioner_ids": {
      "type": "array",
      "maxItems": 8,
      "items": {"type": "string", "pattern": "^synthetic-practitioner-[a-z0-9-]{1,48}$"},
      "uniqueItems": true
    },
    "time_window": {
      "type": "object",
      "required": ["from", "to"],
      "additionalProperties": false,
      "properties": {
        "from": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
        "to": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"}
      }
    },
    "duration_minutes": {
      "type": ["integer", "null"],
      "minimum": 5,
      "maximum": 240
    },
    "source_evidence_paths": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "enum": [
          "$.utterance",
          "$.context.context_revision",
          "$.context.reference_date",
          "$.context.allowed_practitioners",
          "$.context.location_id"
        ]
      },
      "uniqueItems": true
    }
  }
}
