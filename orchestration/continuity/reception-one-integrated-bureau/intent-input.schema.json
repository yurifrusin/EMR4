{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/reception.one.intent-input.v1.json",
  "title": "Reception One authored-synthetic intent input",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "data_class",
    "utterance",
    "context",
    "authority"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "reception.one.intent-input.v1"},
    "request_id": {"type": "string", "pattern": "^synthetic-request-[a-z0-9-]{1,64}$"},
    "data_class": {"const": "authored_synthetic"},
    "utterance": {"type": "string", "minLength": 1, "maxLength": 280},
    "context": {
      "type": "object",
      "required": [
        "context_revision",
        "reference_date",
        "timezone",
        "location_id",
        "observed_at",
        "expires_at",
        "allowed_practitioners"
      ],
      "additionalProperties": false,
      "properties": {
        "context_revision": {"type": "string", "pattern": "^synthetic-diary-revision-[a-z0-9-]{1,48}$"},
        "reference_date": {"type": "string", "format": "date"},
        "timezone": {"const": "Australia/Brisbane"},
        "location_id": {"type": "string", "pattern": "^synthetic-location-[a-z0-9-]{1,48}$"},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "allowed_practitioners": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "type": "object",
            "required": ["id", "display_name", "aliases"],
            "additionalProperties": false,
            "properties": {
              "id": {"type": "string", "pattern": "^synthetic-practitioner-[a-z0-9-]{1,48}$"},
              "display_name": {"type": "string", "minLength": 1, "maxLength": 80},
              "aliases": {
                "type": "array",
                "minItems": 1,
                "maxItems": 8,
                "items": {"type": "string", "minLength": 1, "maxLength": 80},
                "uniqueItems": true
              }
            }
          }
        }
      }
    },
    "authority": {
      "type": "object",
      "required": [
        "read_only",
        "appointment_write_authority",
        "command_authority",
        "product_delivery_enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "read_only": {"const": true},
        "appointment_write_authority": {"const": false},
        "command_authority": {"const": false},
        "product_delivery_enabled": {"const": false}
      }
    }
  }
}
