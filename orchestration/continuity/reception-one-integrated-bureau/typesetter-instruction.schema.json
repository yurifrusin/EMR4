{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/reception.one.typesetter-instruction.v1.json",
  "title": "Reception One admitted deterministic typesetter instruction",
  "type": "object",
  "required": [
    "contract_version",
    "request_id",
    "context_revision",
    "source_draft_sha256",
    "proofreader_sha256",
    "projection_family",
    "diary_target_date",
    "set_diary_date_before_projection",
    "scope",
    "read_action",
    "action_boundary",
    "released_field_paths",
    "evidence_mode"
  ],
  "additionalProperties": false,
  "properties": {
    "contract_version": {"const": "reception.one.typesetter-instruction.v1"},
    "request_id": {"type": "string", "pattern": "^synthetic-request-[a-z0-9-]{1,64}$"},
    "context_revision": {"type": "string", "pattern": "^synthetic-diary-revision-[a-z0-9-]{1,48}$"},
    "source_draft_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "proofreader_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "projection_family": {
      "enum": [
        "focused_schedule_lane",
        "patient_timeline",
        "availability_slots",
        "aligned_comparison",
        "ordinary_overview",
        "clarification"
      ]
    },
    "diary_target_date": {"type": "string", "format": "date"},
    "set_diary_date_before_projection": {"const": true},
    "scope": {
      "type": "object",
      "required": ["practitioner_ids", "time_from", "time_to", "duration_minutes"],
      "additionalProperties": false,
      "properties": {
        "practitioner_ids": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "pattern": "^synthetic-practitioner-[a-z0-9-]{1,48}$"},
          "uniqueItems": true
        },
        "time_from": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
        "time_to": {"type": "string", "pattern": "^([01]\\d|2[0-3]):[0-5]\\d$"},
        "duration_minutes": {"type": ["integer", "null"], "minimum": 5, "maximum": 240}
      }
    },
    "read_action": {"const": "authorised_diary_read"},
    "action_boundary": {
      "type": "object",
      "required": [
        "appointment_write_authority",
        "command_authority",
        "product_delivery_enabled"
      ],
      "additionalProperties": false,
      "properties": {
        "appointment_write_authority": {"const": false},
        "command_authority": {"const": false},
        "product_delivery_enabled": {"const": false}
      }
    },
    "released_field_paths": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "pattern": "^\\$\\.[a-z_]+(?:\\.[a-z_]+)?$"},
      "uniqueItems": true
    },
    "evidence_mode": {"const": "provider_blocked_repository_contract"}
  }
}
