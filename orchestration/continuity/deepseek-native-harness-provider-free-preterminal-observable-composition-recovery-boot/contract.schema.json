{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "planning_source",
    "frozen_plan_source",
    "accepted_sources",
    "predecessor_bytes",
    "implementation_bytes",
    "immutable_predecessor_attempt",
    "attempt",
    "package",
    "required_installed_packages",
    "preset",
    "launch",
    "readiness",
    "activation",
    "terminal",
    "required_zero_counts"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.deepseek_native_harness_preterminal_observable_composition_recovery_boot_contract.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-preterminal-observable-composition-recovery-boot"},
    "planning_source": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "frozen_plan_source": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "accepted_sources": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
    },
    "predecessor_bytes": {
      "type": "object",
      "minProperties": 12,
      "additionalProperties": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
    },
    "implementation_bytes": {
      "type": "object",
      "required": ["controller_sha256", "focused_test_sha256"],
      "properties": {
        "controller_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "focused_test_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      },
      "additionalProperties": false
    },
    "immutable_predecessor_attempt": {
      "type": "object",
      "required": ["attempt_id", "causal_classification", "retry_permitted", "reclassification_permitted"],
      "properties": {
        "attempt_id": {"const": "native-composition-attempt-001"},
        "causal_classification": {"const": "indeterminate_preterminal_failure"},
        "retry_permitted": {"const": false},
        "reclassification_permitted": {"const": false}
      },
      "additionalProperties": false
    },
    "attempt": {
      "type": "object",
      "required": ["attempt_id", "native_process_count", "automatic_retry", "manual_retry", "resume"],
      "properties": {
        "attempt_id": {"const": "preterminal-observable-composition-recovery-boot-attempt-001"},
        "native_process_count": {"const": 1},
        "automatic_retry": {"const": false},
        "manual_retry": {"const": false},
        "resume": {"const": false}
      },
      "additionalProperties": false
    },
    "package": {"type": "object"},
    "required_installed_packages": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "preset": {"type": "object"},
    "launch": {"type": "object"},
    "readiness": {"type": "object"},
    "activation": {"type": "object"},
    "terminal": {"type": "object"},
    "required_zero_counts": {"type": "array", "minItems": 9, "uniqueItems": true, "items": {"type": "string"}}
  }
}
