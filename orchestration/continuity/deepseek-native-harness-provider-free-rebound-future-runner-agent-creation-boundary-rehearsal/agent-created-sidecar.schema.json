{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.example/schemas/native-harness-agent-creation-boundary-sidecar.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "operation_id", "execution_attempt_id", "candidate_source", "coordinate",
    "agent_create_invocation_count", "private_agent_preparation_count", "private_session_preparation_count",
    "setup_entered", "commit_entered", "veto_exact", "veto_rejected", "publication_stop",
    "fixed_identity_sha256", "cwd_absolute", "preset_id", "preset_trust", "preset_bytes", "preset_sha256",
    "preset_mounted", "effective_tool_names", "effective_tool_count", "effective_tool_guard_sha256",
    "provider", "model", "reasoning_effort", "max_tokens", "model_selection_configured", "runner_sha256",
    "live_agent_count", "live_session_count", "session_created_event_count", "agent_created_event_count",
    "agent_session_start_event_count", "turn_count", "request_count", "broker_process_count", "broker_request_count",
    "occupied_worker_count", "model_request_count", "provider_request_count", "database_invocation_count",
    "docker_invocation_count", "target_path_sha256", "target_created", "target_used", "raw_error_retained", "app_exit_count"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.native_harness_agent_creation_boundary_sidecar.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-rebound-future-runner-agent-creation-boundary-rehearsal"},
    "execution_attempt_id": {"const": "rebound-agent-creation-boundary-attempt-001"},
    "candidate_source": {"$ref": "#/$defs/oid"},
    "coordinate": {"const": "agent_create_prepublication_veto_passed"},
    "agent_create_invocation_count": {"const": 1},
    "private_agent_preparation_count": {"const": 1},
    "private_session_preparation_count": {"const": 1},
    "setup_entered": {"const": true},
    "commit_entered": {"const": true},
    "veto_exact": {"const": true},
    "veto_rejected": {"const": true},
    "publication_stop": {"const": "EMR4_AGENT_PUBLICATION_STOP"},
    "fixed_identity_sha256": {"$ref": "#/$defs/digest"},
    "cwd_absolute": {"const": true},
    "preset_id": {"const": "emr4-bounded-worker"},
    "preset_trust": {"const": "user"},
    "preset_bytes": {"const": 158},
    "preset_sha256": {"const": "3de182eb702e6f2b397941c73393b87f65acb9b401565f966059d2bd46f649d1"},
    "preset_mounted": {"const": true},
    "effective_tool_names": {"const": ["edit", "glob", "read"]},
    "effective_tool_count": {"const": 3},
    "effective_tool_guard_sha256": {"$ref": "#/$defs/digest"},
    "provider": {"const": "deepseek-official"},
    "model": {"const": "deepseek-v4-flash"},
    "reasoning_effort": {"const": "high"},
    "max_tokens": {"const": 4096},
    "model_selection_configured": {"const": true},
    "runner_sha256": {"$ref": "#/$defs/digest"},
    "live_agent_count": {"const": 0},
    "live_session_count": {"const": 0},
    "session_created_event_count": {"const": 0},
    "agent_created_event_count": {"const": 0},
    "agent_session_start_event_count": {"const": 0},
    "turn_count": {"const": 0},
    "request_count": {"const": 0},
    "broker_process_count": {"const": 0},
    "broker_request_count": {"const": 0},
    "occupied_worker_count": {"const": 0},
    "model_request_count": {"const": 0},
    "provider_request_count": {"const": 0},
    "database_invocation_count": {"const": 0},
    "docker_invocation_count": {"const": 0},
    "target_path_sha256": {"$ref": "#/$defs/digest"},
    "target_created": {"const": false},
    "target_used": {"const": false},
    "raw_error_retained": {"const": false},
    "app_exit_count": {"const": 1}
  },
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
