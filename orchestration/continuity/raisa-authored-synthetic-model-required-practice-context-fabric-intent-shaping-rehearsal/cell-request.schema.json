{
  "$id": "https://emr4.invalid/schemas/raisa-intent-shaping-cell-request.v1.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "attempt_number": {
            "const": 1
          }
        }
      },
      "then": {
        "properties": {
          "correction_of": {
            "const": null
          },
          "correction_reason_code": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "attempt_number": {
            "const": 2
          }
        }
      },
      "then": {
        "properties": {
          "correction_of": {
            "minLength": 1,
            "type": "string"
          },
          "correction_reason_code": {
            "enum": [
              "provider_body_schema_invalid",
              "intent_not_grounded"
            ]
          }
        }
      }
    }
  ],
  "properties": {
    "attempt_id": {
      "pattern": "^raisa-intent-shaping-(primary|correction)-[0-9]{3}$",
      "type": "string"
    },
    "attempt_number": {
      "enum": [
        1,
        2
      ]
    },
    "context_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "correction_of": {
      "type": [
        "string",
        "null"
      ]
    },
    "correction_reason_code": {
      "enum": [
        null,
        "provider_body_schema_invalid",
        "intent_not_grounded"
      ]
    },
    "lane": {
      "const": "rayleen_context_fabric_intent_shaping"
    },
    "ledger_id": {
      "pattern": "^ledger-raisa-intent-shaping-(primary|correction)-[0-9]{3}$",
      "type": "string"
    },
    "policy_id": {
      "const": "raisa-context-fabric-model-required-intent-shaping-sydney-v1"
    },
    "provider_request_hash": {
      "pattern": "^sha256:[0-9a-f]{64}$",
      "type": "string"
    },
    "schema_version": {
      "const": "emr4.raisa_intent_shaping.cell_request.v1"
    }
  },
  "required": [
    "schema_version",
    "lane",
    "attempt_id",
    "ledger_id",
    "policy_id",
    "context_hash",
    "provider_request_hash",
    "attempt_number",
    "correction_of",
    "correction_reason_code"
  ],
  "title": "Raisa intent-shaping cell request",
  "type": "object"
}
