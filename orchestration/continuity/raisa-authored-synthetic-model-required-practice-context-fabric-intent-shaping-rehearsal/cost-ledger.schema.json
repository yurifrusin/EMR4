    },
    "provider_calls_consumed": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "provider_calls_reserved": {
      "maximum": 2,
      "minimum": 0,
      "type": "integer"
    },
    "reserved_cost_usd": {
      "maximum": 0.5,
      "minimum": 0,
      "multipleOf": 0.25,
