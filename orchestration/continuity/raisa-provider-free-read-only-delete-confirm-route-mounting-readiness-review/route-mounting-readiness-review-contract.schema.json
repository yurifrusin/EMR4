{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/delete-confirm-route-mounting-readiness-review-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "source_head",
    "input_hash_mode",
    "inputs",
    "classifications",
    "verdict_rules",
    "dimensions",
    "acceptance",
    "forbidden_surfaces"
  ],
  "properties": {
    "schema_version": {"const": "raisa.delete_confirm_route_mounting_readiness_review_contract.v1"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "input_hash_mode": {"const": "strict_utf8_canonical_lf_reject_bare_cr_sha256"},
    "inputs": {
      "type": "array",
      "minItems": 23,
      "maxItems": 23,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    },
    "classifications": {"const": ["satisfied", "route_transition_gap", "blocking_gap"]},
    "verdict_rules": {"type": "object"},
    "dimensions": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["order", "id", "expected_classification", "question"],
        "properties": {
          "order": {"type": "integer", "minimum": 1, "maximum": 12},
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]+$"},
          "expected_classification": {"enum": ["satisfied", "route_transition_gap", "blocking_gap"]},
          "question": {"type": "string", "minLength": 1}
        }
      }
    },
    "acceptance": {"type": "object"},
    "forbidden_surfaces": {"type": "array", "items": {"type": "string"}, "minItems": 1}
  }
}
