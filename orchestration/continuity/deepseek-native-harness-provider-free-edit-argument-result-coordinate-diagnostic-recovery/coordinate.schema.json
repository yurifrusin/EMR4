    "success_class": {"type": ["string", "null"], "enum": [null, "unique_match", "replace_all"]},
    "target_changed": {"type": "boolean"},
    "coordinate": {"enum": ["edit_success_unique_match", "edit_success_replace_all", "edit_error_invalid_args", "edit_error_untyped_argument_constraint", "edit_error_fs_stale_version", "edit_error_fs_edit_not_found", "edit_error_fs_ambiguous_edit"]}
