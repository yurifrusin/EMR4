    "current_posture": {
      "$ref": "#/$defs/currentPosture"
    },
    "manifest_profile": {
      "$ref": "#/$defs/manifestProfile"
    },
    "runtime_role_profile": {
      "$ref": "#/$defs/runtimeRoleProfile"
    },
    "secret_reference_profile": {
      "$ref": "#/$defs/secretReferenceProfile"
    },
    "rotation_evidence_profile": {
      "$ref": "#/$defs/rotationEvidenceProfile"
    },
    "break_glass_profile": {
      "$ref": "#/$defs/breakGlassProfile"
    },
