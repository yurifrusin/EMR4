      "$ref": "#/$defs/evidenceGateEvaluator"
    },
    "operational_evidence_boundary": {
      "$ref": "#/$defs/operationalEvidenceBoundary"
    },
    "clockwork_boundary": {
      "$ref": "#/$defs/clockworkBoundary"
    },
    "closed_boundaries": {
      "$ref": "#/$defs/closedBoundaries"
    },
    "successor": {
