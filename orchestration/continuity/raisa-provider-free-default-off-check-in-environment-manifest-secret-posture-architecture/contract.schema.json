    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "currentPosture": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "feature_setting",
        "feature_default",
        "synthetic_allowlist_setting",
        "synthetic_allowlist_default",
        "ordinary_admission_records_present",
        "environment_manifest_instances_present",
        "selected_practice_bindings_present",
        "ordinary_runtime_role_bindings_present",
        "secret_reference_bindings_present",
