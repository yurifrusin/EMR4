        "may_supply_secret": {"type": "boolean"},
        "may_skip_rotation": {"type": "boolean"},
        "may_attest_role": {"type": "boolean"},
        "may_activate_practice": {"type": "boolean"},
        "may_clear_global_kill_switch": {"type": "boolean"},
