{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schema/check-in-ordinary-environment-manifest-v1.json",
  "title": "EMR4 ordinary check-in environment manifest normalized reading",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "manifest_id",
    "environment",
    "admission_snapshot_generation",
    "authority_git_object",
    "practice_scope_reference",
    "runtime_role",
    "secret_references",
    "rotation_evidence",
    "break_glass",
    "issued_at",
    "expires_at"
  ],
  "properties": {
    "schema_version": {
      "const": "emr4.check-in-ordinary-environment-manifest.v1"
    },
    "manifest_id": {
      "type": "string",
      "pattern": "^check-in-env-manifest:[a-z0-9][a-z0-9._-]{2,95}$"
    },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "identifier"],
      "properties": {
        "class": {
          "enum": ["development", "test", "staging", "production"]
        },
        "identifier": {
          "type": "string",
          "pattern": "^env:[a-z0-9][a-z0-9._-]{2,95}$"
        }
      }
    },
    "admission_snapshot_generation": {
      "type": "integer",
      "minimum": 1
    },
    "authority_git_object": {
      "$ref": "#/$defs/fullGitObject"
    },
    "practice_scope_reference": {
      "type": "string",
      "pattern": "^practice-ref:[a-z0-9][a-z0-9._/-]{2,127}$"
    },
    "runtime_role": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "logical_role_id",
        "database_role_identifier",
        "credential_secret_slot_id",
        "non_owner_required",
        "nobypassrls_required",
        "product_relation_ownership_allowed",
        "tenant_attestation_reference"
      ],
      "properties": {
        "logical_role_id": {
          "const": "appointment_check_in_ordinary_runtime_v1"
        },
        "database_role_identifier": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{2,62}$"
        },
        "credential_secret_slot_id": {
          "const": "database_connection_credential"
        },
        "non_owner_required": {
          "const": true
        },
        "nobypassrls_required": {
          "const": true
        },
        "product_relation_ownership_allowed": {
          "const": false
        },
        "tenant_attestation_reference": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "secret_references": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/databaseCredentialReference"
        },
        {
          "$ref": "#/$defs/applicationSigningReference"
        },
        {
          "$ref": "#/$defs/admissionVerificationReference"
        }
      ],
      "items": false
    },
    "rotation_evidence": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        {
          "$ref": "#/$defs/databaseCredentialRotation"
        },
        {
          "$ref": "#/$defs/applicationSigningRotation"
        },
        {
          "$ref": "#/$defs/admissionVerificationRotation"
        }
      ],
      "items": false
    },
    "break_glass": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "state",
        "evidence_reference",
        "bypass_allowed",
        "secret_injection_allowed",
        "automatic_clear_allowed"
      ],
      "properties": {
        "mode": {
          "const": "deny_only"
        },
        "state": {
          "enum": ["inactive", "engaged_deny", "retired"]
        },
        "evidence_reference": {
          "$ref": "#/$defs/evidenceReference"
        },
        "bypass_allowed": {
          "const": false
        },
        "secret_injection_allowed": {
          "const": false
        },
        "automatic_clear_allowed": {
          "const": false
        }
      }
    },
    "issued_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "$defs": {
    "fullGitObject": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "secretReference": {
      "type": "string",
      "pattern": "^secret-ref:[a-z0-9][a-z0-9._/-]{2,127}$"
    },
    "evidenceReference": {
      "type": "string",
      "pattern": "^evidence-ref:[a-z0-9][a-z0-9._/-]{2,127}$"
    },
    "policyReference": {
      "type": "string",
      "pattern": "^policy-ref:[a-z0-9][a-z0-9._/-]{2,127}$"
    },
    "secretBindingBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "provider_namespace",
        "secret_reference",
        "key_id",
        "version",
        "rotation_policy_reference",
        "rotation_evidence_reference"
      ],
      "properties": {
        "slot_id": {
          "type": "string"
        },
        "provider_namespace": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9._-]{2,63}$"
        },
        "secret_reference": {
          "$ref": "#/$defs/secretReference"
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "rotation_policy_reference": {
          "$ref": "#/$defs/policyReference"
        },
        "rotation_evidence_reference": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "databaseCredentialReference": {
      "allOf": [
        {
          "$ref": "#/$defs/secretBindingBase"
        },
        {
          "properties": {
            "slot_id": {
              "const": "database_connection_credential"
            }
          }
        }
      ]
    },
    "applicationSigningReference": {
      "allOf": [
        {
          "$ref": "#/$defs/secretBindingBase"
        },
        {
          "properties": {
            "slot_id": {
              "const": "application_token_signing_key"
            }
          }
        }
      ]
    },
    "admissionVerificationReference": {
      "allOf": [
        {
          "$ref": "#/$defs/secretBindingBase"
        },
        {
          "properties": {
            "slot_id": {
              "const": "admission_snapshot_verification_key"
            }
          }
        }
      ]
    },
    "rotationEvidenceBase": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "slot_id",
        "evidence_reference",
        "artifact_sha256",
        "authority_git_object",
        "environment_identifier",
        "admission_snapshot_generation",
        "key_id",
        "version",
        "rotation_sequence",
        "observed_at",
        "fresh_until",
        "independent_verifier_reference"
      ],
      "properties": {
        "slot_id": {
          "type": "string"
        },
        "evidence_reference": {
          "$ref": "#/$defs/evidenceReference"
        },
        "artifact_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "authority_git_object": {
          "$ref": "#/$defs/fullGitObject"
        },
        "environment_identifier": {
          "type": "string",
          "pattern": "^env:[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "admission_snapshot_generation": {
          "type": "integer",
          "minimum": 1
        },
        "key_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,95}$"
        },
        "version": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
        },
        "rotation_sequence": {
          "type": "integer",
          "minimum": 1
        },
        "observed_at": {
          "type": "string",
          "format": "date-time"
        },
        "fresh_until": {
          "type": "string",
          "format": "date-time"
        },
        "independent_verifier_reference": {
          "$ref": "#/$defs/evidenceReference"
        }
      }
    },
    "databaseCredentialRotation": {
      "allOf": [
        {
          "$ref": "#/$defs/rotationEvidenceBase"
        },
        {
          "properties": {
            "slot_id": {
              "const": "database_connection_credential"
            }
          }
        }
      ]
    },
    "applicationSigningRotation": {
      "allOf": [
        {
          "$ref": "#/$defs/rotationEvidenceBase"
        },
        {
          "properties": {
            "slot_id": {
              "const": "application_token_signing_key"
            }
          }
        }
      ]
    },
    "admissionVerificationRotation": {
      "allOf": [
        {
          "$ref": "#/$defs/rotationEvidenceBase"
        },
        {
          "properties": {
            "slot_id": {
              "const": "admission_snapshot_verification_key"
            }
          }
        }
      ]
    }
  }
}
