{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/reception-one-bureau-plan-draft-dispatch.v1.json",
  "title": "Closed legacy and model-first untrusted plan contracts",
  "oneOf": [
    {
      "$ref": "#/$defs/legacyPlan"
    },
    {
      "$ref": "#/$defs/modelFirstPlan"
    },
    {
      "$ref": "#/$defs/pointModelPlan"
    }
  ],
  "$defs": {
    "syntheticRef": {
      "type": "string",
      "pattern": "^synthetic-[a-z0-9][a-z0-9-]{2,95}$"
    },
    "stepId": {
      "type": "string",
      "pattern": "^step-[a-z0-9][a-z0-9-]{0,47}$"
    },
    "semanticBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "semantic_ref"
        },
        "field": {
          "enum": [
            "appointment_date",
            "earliest_time",
            "latest_time",
            "duration_minutes",
            "intended_action"
          ]
        }
      }
    },
    "utteranceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "entity_type",
        "utterance_index",
        "start",
        "end",
        "text"
      ],
      "properties": {
        "kind": {
          "const": "utterance_ref"
        },
        "entity_type": {
          "enum": [
            "patient",
            "practitioner",
            "status"
          ]
        },
        "utterance_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "contextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "context_ref"
        },
        "field": {
          "enum": [
            "selected_appointment",
            "squeeze_policy",
            "default_duration_minutes"
          ]
        }
      }
    },
    "stepBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "step_id",
        "output"
      ],
      "properties": {
        "kind": {
          "const": "step_output"
        },
        "step_id": {
          "$ref": "#/$defs/stepId"
        },
        "output": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      }
    },
    "binding": {
      "oneOf": [
        {
          "$ref": "#/$defs/semanticBinding"
        },
        {
          "$ref": "#/$defs/utteranceBinding"
        },
        {
          "$ref": "#/$defs/contextBinding"
        },
        {
          "$ref": "#/$defs/stepBinding"
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "args"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "operator": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "args": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/binding"
          }
        }
      }
    },
    "modelEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "utterance_index",
        "start",
        "end",
        "text"
      ],
      "properties": {
        "utterance_index": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3
        },
        "start": {
          "type": "integer",
          "minimum": 0,
          "maximum": 511
        },
        "end": {
          "type": "integer",
          "minimum": 1,
          "maximum": 512
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "modelCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "field",
        "value",
        "evidence",
        "supersedes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
        },
        "field": {
          "enum": [
            "intended_action",
            "appointment_date",
            "earliest_time",
            "latest_time",
            "duration_minutes"
          ]
        },
        "value": {},
        "evidence": {
          "$ref": "#/$defs/modelEvidence"
        },
        "supersedes": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "field": {
                "const": "intended_action"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "create",
                  "move",
                  "resize",
                  "cancel",
                  "status_change",
                  "squeeze_in_assessment",
                  "clarification"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "appointment_date"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "earliest_time"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "latest_time"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "duration_minutes"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 5,
                "maximum": 180
              }
            }
          }
        }
      ]
    },
    "modelInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_sha256",
        "context_revision",
        "reference_date",
        "candidates",
        "selected"
      ],
      "properties": {
        "frame_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_revision": {
          "type": "integer",
          "minimum": 1
        },
        "reference_date": {
          "type": "string",
          "format": "date"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/modelCandidate"
          }
        },
        "selected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intended_action"
          ],
          "properties": {
            "intended_action": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            },
            "appointment_date": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            },
            "earliest_time": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            },
            "latest_time": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            },
            "duration_minutes": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            }
          }
        }
      }
    },
    "modelContextBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "context_ref"
        },
        "field": {
          "enum": [
            "selected_appointment",
            "squeeze_policy",
            "default_duration_minutes",
            "selected_appointment.patient_ref"
          ]
        }
      }
    },
    "modelBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/semanticBinding"
        },
        {
          "$ref": "#/$defs/utteranceBinding"
        },
        {
          "$ref": "#/$defs/modelContextBinding"
        },
        {
          "$ref": "#/$defs/stepBinding"
        }
      ]
    },
    "modelStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "args"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "operator": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "args": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/modelBinding"
          }
        }
      }
    },
    "legacyPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "catalog_version",
        "request_id",
        "practice_ref",
        "correlation_id",
        "context_revision",
        "attempt",
        "revision_limit",
        "planner_class",
        "goal",
        "effect_ceiling",
        "steps"
      ],
      "properties": {
        "contract_version": {
          "const": "reception.one.bureau.plan-draft.v1"
        },
        "catalog_version": {
          "enum": [
            "reception-one-bureau-catalog-1",
            "reception-one-bureau-catalog-point-2"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/syntheticRef"
        },
        "practice_ref": {
          "$ref": "#/$defs/syntheticRef"
        },
        "correlation_id": {
          "$ref": "#/$defs/syntheticRef"
        },
        "context_revision": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "revision_limit": {
          "const": 2
        },
        "planner_class": {
          "enum": [
            "deterministic_semantic_adapter",
            "untrusted_model_candidate"
          ]
        },
        "goal": {
          "enum": [
            "create",
            "move",
            "resize",
            "cancel",
            "status_change",
            "squeeze_in_assessment",
            "clarification"
          ]
        },
        "effect_ceiling": {
          "const": "proposal_only"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "modelFirstPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "catalog_version",
        "request_id",
        "practice_ref",
        "correlation_id",
        "context_revision",
        "attempt",
        "revision_limit",
        "planner_class",
        "goal",
        "effect_ceiling",
        "steps",
        "interpretation"
      ],
      "properties": {
        "contract_version": {
          "const": "reception.one.bureau.plan-draft.model-first.v1"
        },
        "catalog_version": {
          "enum": [
            "reception-one-bureau-catalog-1",
            "reception-one-bureau-catalog-point-2"
          ]
        },
        "request_id": {
          "$ref": "#/$defs/syntheticRef"
        },
        "practice_ref": {
          "$ref": "#/$defs/syntheticRef"
        },
        "correlation_id": {
          "$ref": "#/$defs/syntheticRef"
        },
        "context_revision": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "revision_limit": {
          "const": 2
        },
        "planner_class": {
          "const": "untrusted_model_candidate"
        },
        "goal": {
          "enum": [
            "create",
            "move",
            "resize",
            "cancel",
            "status_change",
            "squeeze_in_assessment",
            "clarification"
          ]
        },
        "effect_ceiling": {
          "const": "proposal_only"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/modelStep"
          }
        },
        "interpretation": {
          "$ref": "#/$defs/modelInterpretation"
        }
      }
    },
    "packetAppointmentTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "context_ref"
        },
        "field": {
          "const": "selected_appointment"
        }
      }
    },
    "packetPatientTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "context_ref"
        },
        "field": {
          "const": "selected_appointment.patient_ref"
        }
      }
    },
    "semanticPacket": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_schema",
        "case_id",
        "interpretation",
        "target_bindings"
      ],
      "properties": {
        "packet_schema": {
          "const": "emr4.bureau_model_semantic_packet.v2"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "$ref": "#/$defs/modelInterpretation"
        },
        "target_bindings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "appointment": {
              "$ref": "#/$defs/packetAppointmentTarget"
            },
            "patient_for_selected_appointment": {
              "$ref": "#/$defs/packetPatientTarget"
            }
          }
        },
        "untrusted_text": {
          "type": "string"
        }
      }
    },
    "pointModelCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "field",
        "value",
        "evidence",
        "supersedes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
        },
        "field": {
          "enum": [
            "intended_action",
            "appointment_date",
            "earliest_time",
            "latest_time",
            "duration_minutes",
            "target_start_local"
          ]
        },
        "value": {},
        "evidence": {
          "$ref": "#/$defs/modelEvidence"
        },
        "supersedes": {
          "type": "array",
          "maxItems": 11,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "field": {
                "const": "intended_action"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "enum": [
                  "create",
                  "move",
                  "resize",
                  "cancel",
                  "status_change",
                  "squeeze_in_assessment",
                  "clarification"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "appointment_date"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
                "format": "date"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "earliest_time"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "latest_time"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^([01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "duration_minutes"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "integer",
                "minimum": 5,
                "maximum": 180
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "field": {
                "const": "target_start_local"
              }
            }
          },
          "then": {
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
              }
            }
          }
        }
      ]
    },
    "pointModelInterpretation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frame_sha256",
        "context_revision",
        "reference_date",
        "candidates",
        "selected"
      ],
      "properties": {
        "frame_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "context_revision": {
          "type": "integer",
          "minimum": 1
        },
        "reference_date": {
          "type": "string",
          "format": "date"
        },
        "candidates": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/pointModelCandidate"
          }
        },
        "selected": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "intended_action"
          ],
          "properties": {
            "intended_action": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            },
            "appointment_date": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            },
            "earliest_time": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            },
            "latest_time": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            },
            "duration_minutes": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            },
            "target_start_local": {
              "type": "string",
              "pattern": "^candidate-[a-z0-9][a-z0-9-]{0,39}$"
            }
          }
        }
      }
    },
    "pointSemanticBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "field"
      ],
      "properties": {
        "kind": {
          "const": "semantic_ref"
        },
        "field": {
          "enum": [
            "appointment_date",
            "earliest_time",
            "latest_time",
            "duration_minutes",
            "intended_action",
            "target_start_local"
          ]
        }
      }
    },
    "pointModelBinding": {
      "oneOf": [
        {
          "$ref": "#/$defs/pointSemanticBinding"
        },
        {
          "$ref": "#/$defs/utteranceBinding"
        },
        {
          "$ref": "#/$defs/modelContextBinding"
        },
        {
          "$ref": "#/$defs/stepBinding"
        }
      ]
    },
    "pointModelStep": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "operator",
        "args"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/stepId"
        },
        "operator": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "args": {
          "type": "object",
          "maxProperties": 8,
          "propertyNames": {
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/pointModelBinding"
          }
        }
      }
    },
    "pointModelPlan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contract_version",
        "catalog_version",
        "request_id",
        "practice_ref",
        "correlation_id",
        "context_revision",
        "attempt",
        "revision_limit",
        "planner_class",
        "goal",
        "effect_ceiling",
        "steps",
        "interpretation"
      ],
      "properties": {
        "contract_version": {
          "const": "reception.one.bureau.plan-draft.model-first.point.v2"
        },
        "catalog_version": {
          "const": "reception-one-bureau-catalog-point-2"
        },
        "request_id": {
          "$ref": "#/$defs/syntheticRef"
        },
        "practice_ref": {
          "$ref": "#/$defs/syntheticRef"
        },
        "correlation_id": {
          "$ref": "#/$defs/syntheticRef"
        },
        "context_revision": {
          "type": "integer",
          "minimum": 1
        },
        "attempt": {
          "type": "integer",
          "minimum": 1,
          "maximum": 2
        },
        "revision_limit": {
          "const": 2
        },
        "planner_class": {
          "const": "untrusted_model_candidate"
        },
        "goal": {
          "enum": [
            "create",
            "move",
            "resize",
            "cancel",
            "status_change",
            "squeeze_in_assessment",
            "clarification"
          ]
        },
        "effect_ceiling": {
          "const": "proposal_only"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "$ref": "#/$defs/pointModelStep"
          }
        },
        "interpretation": {
          "$ref": "#/$defs/pointModelInterpretation"
        }
      }
    },
    "semanticPacketV3": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "packet_schema",
        "case_id",
        "interpretation",
        "target_bindings"
      ],
      "properties": {
        "packet_schema": {
          "const": "emr4.bureau_model_semantic_packet.v3"
        },
        "case_id": {
          "type": "string",
          "minLength": 1
        },
        "interpretation": {
          "$ref": "#/$defs/pointModelInterpretation"
        },
        "target_bindings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "appointment": {
              "$ref": "#/$defs/packetAppointmentTarget"
            },
            "patient_for_selected_appointment": {
              "$ref": "#/$defs/packetPatientTarget"
            }
          }
        },
        "untrusted_text": {
          "type": "string"
        }
      }
    }
  }
}
