{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/reception-one-bureau-operator-catalog.v1.json",
  "title": "Reception One Bureau typed operator catalogue",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "catalog_version",
    "effect_classes",
    "operators"
  ],
  "properties": {
    "schema_version": {
      "const": "reception.one.bureau.operator-catalog.v1"
    },
    "catalog_version": {
      "const": "reception-one-bureau-catalog-1"
    },
    "effect_classes": {
      "type": "array",
      "const": [
        "pure",
        "authorised_read",
        "proposal_only"
      ]
    },
    "operators": {
      "type": "array",
      "minItems": 14,
      "maxItems": 14,
      "items": {
        "$ref": "#/$defs/operator"
      }
    }
  },
  "$defs": {
    "typedField": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "type",
        "required"
      ],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "type": {
          "type": "string",
          "enum": [
            "patient_mention",
            "practitioner_mention",
            "status_mention",
            "date",
            "time",
            "integer",
            "patient_ref",
            "practitioner_ref",
            "appointment_ref",
            "appointment_set",
            "schedule_ref",
            "candidate_slot_set",
            "squeeze_policy_ref",
            "proposal_candidate",
            "clarification"
          ]
        },
        "required": {
          "type": "boolean"
        }
      }
    },
    "operator": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "effect",
        "inputs",
        "outputs",
        "api_spine_operation_id",
        "human_confirmation_required"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "effect": {
          "enum": [
            "pure",
            "authorised_read",
            "proposal_only"
          ]
        },
        "inputs": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/typedField"
          }
        },
        "outputs": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/typedField"
          }
        },
        "api_spine_operation_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^[A-Za-z][A-Za-z0-9]{0,63}$"
        },
        "human_confirmation_required": {
          "type": "boolean"
        }
      }
    }
  }
}
