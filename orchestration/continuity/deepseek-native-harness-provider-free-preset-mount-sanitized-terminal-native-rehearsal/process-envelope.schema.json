{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/native-harness-preset-mount-sanitized-terminal-process-envelope.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "execution_attempt_id",
    "candidate_source",
    "sidecar_file_seen",
    "sidecar_bytes",
    "sidecar_sha256",
    "numeric_exit_code_observed",
    "numeric_exit_code",
    "stdout_retained",
    "stderr_retained",
    "raw_stream_read",
    "stream_content_retained",
    "sidecar_semantics_interpreted",
    "raw_runtime_detail_retained",
    "native_process_count",
    "retry_count",
    "resume_count",
    "further_process_authorized"
  ],
  "properties": {
    "schema_version": {"const": "ariadne.native_harness_preset_mount_sanitized_terminal_process_envelope.v1"},
    "operation_id": {"const": "deepseek-native-harness-provider-free-preset-mount-sanitized-terminal-native-rehearsal"},
    "execution_attempt_id": {"const": "preset-mount-sanitized-terminal-native-attempt-001"},
    "candidate_source": {"$ref": "#/$defs/oid"},
    "sidecar_file_seen": {"type": "boolean"},
    "sidecar_bytes": {"type": "integer", "minimum": 0, "maximum": 8192},
    "sidecar_sha256": {"anyOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
    "numeric_exit_code_observed": {"const": false},
    "numeric_exit_code": {"type": "null"},
    "stdout_retained": {"const": false},
    "stderr_retained": {"const": false},
    "raw_stream_read": {"const": false},
    "stream_content_retained": {"const": false},
    "sidecar_semantics_interpreted": {"const": false},
    "raw_runtime_detail_retained": {"const": false},
    "native_process_count": {"const": 1},
    "retry_count": {"const": 0},
    "resume_count": {"const": 0},
    "further_process_authorized": {"const": false}
  },
  "allOf": [
    {
      "if": {"properties": {"sidecar_file_seen": {"const": true}}},
      "then": {
        "properties": {
          "sidecar_bytes": {"type": "integer", "minimum": 1, "maximum": 8192},
          "sidecar_sha256": {"$ref": "#/$defs/digest"}
        }
      },
      "else": {
        "properties": {
          "sidecar_bytes": {"const": 0},
          "sidecar_sha256": {"type": "null"}
        }
      }
    }
  ],
  "$defs": {
    "oid": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
