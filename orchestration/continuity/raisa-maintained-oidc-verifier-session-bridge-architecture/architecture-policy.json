{
  "schema_version": "emr4.oidc-session-bridge-architecture-policy.v1",
  "status": "architecture_only_not_wired",
  "authority_owner": "emr4_backend",
  "library_boundary": {
    "selected_library": "msal_python",
    "reviewed_baseline": "1.37.0",
    "client_type": "confidential_client",
    "flow_apis": [
      "ConfidentialClientApplication.initiate_auth_code_flow",
      "ConfidentialClientApplication.acquire_token_by_auth_code_flow"
    ],
    "custom_jwt_verifier": false,
    "dependency_added": false
  },
  "protocol": {
    "authority": "one_tenant_specific_v2_authority",
    "flow": "authorization_code_oidc",
    "scopes": ["openid", "profile"],
    "pkce": "S256",
    "attempt_ttl_seconds": 300,
    "attempt_consumption": "atomic_before_single_provider_exchange",
    "required_verified_facts": [
      "signature",
      "algorithm",
      "issuer",
      "audience",
      "tenant_id",
      "object_id",
      "subject",
      "nonce",
      "issued_at",
      "not_before",
      "expires_at",
      "trusted_signing_key"
    ],
    "forbidden_authorities": ["common", "organizations", "consumers", "personal_microsoft_account", "arbitrary_discovery_url"],
    "forbidden_scopes": ["email", "offline_access", "microsoft_graph", "resource_api"]
  },
  "database_bootstrap": {
    "login_role": "LOGIN_NOINHERIT_no_table_grants",
    "bootstrap_role": "NOLOGIN_NOBYPASSRLS_execute_exact_resolver_only",
    "routine_owner": "NOLOGIN_non_table_owner_minimum_select_insert",
    "function_security": "SECURITY_DEFINER_fixed_signature_no_dynamic_sql",
    "search_path": "pg_catalog_only_schema_qualified_application_objects",
    "public_execute": false,
    "direct_table_grants": false,
    "rls": "forced_exact_transaction_local_hmac_context",
    "input": "fixed_length_versioned_hmac_references_only",
    "output": ["binding_ref", "user_ref", "practice_ref", "binding_version"],
    "audit_before_return": true
  },
  "admission_grant": {
    "entropy_bits": 256,
    "ttl_seconds": 60,
    "stored_form": "digest_only",
    "bound_to": ["binding_version", "surface", "origin", "audience", "return_target", "policy_version"],
    "callback_sets_session_cookie": false,
    "transport": "exact_origin_message_body_not_url",
    "browser_storage": false
  },
  "redemption": {
    "csrf": "host_cookie_plus_x_emr4_csrf_header",
    "repeat_binding_resolution": true,
    "fresh_internal_load": ["user", "practice", "role", "practitioner_relationship"],
    "atomic_commit": ["grant_consumption", "parent_session", "surface_session", "required_audit"],
    "cookie_after_commit": true,
    "concurrent_success_maximum": 1,
    "product_reads": 0
  },
  "cookie_contract": {
    "session_cookie": "__Host-emr4-application-session",
    "csrf_cookie": "__Host-emr4-application-csrf",
    "secure": true,
    "http_only": true,
    "path": "/",
    "domain": "absent",
    "same_site": "None",
    "partitioned": true,
    "raw_parent_in_client": false
  },
  "privacy": {
    "persistent_external_identity": "versioned_keyed_hmac_only",
    "forbidden_persistence": ["authorization_code", "id_token", "access_token", "refresh_token", "state", "nonce", "pkce_verifier", "tenant_id", "object_id", "subject", "email", "name", "admission_grant", "session_bearer", "csrf_bearer"],
    "external_errors": ["authentication_failed", "authentication_temporarily_unavailable"],
    "return_targets": ["clinician_one", "reception_one", "diary"]
  },
  "non_wiring": {
    "provider_calls": 0,
    "real_identities": 0,
    "database_migrations": 0,
    "database_roles_created": 0,
    "routes_mounted": 0,
    "product_reads": 0,
    "sessions_created": 0,
    "deployments": 0,
    "protected_ref_movements": 0
  }
}
