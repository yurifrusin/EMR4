{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.local/schemas/deepseek-native-harness-emr4-bounded-worker-preset-contract-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "operation_id",
    "planning_source",
    "accepted_sources",
    "predecessor_files",
    "predecessor_package_names",
    "packages",
    "preset",
    "required_zero_counts",
    "implementation_bytes"
  ],
  "properties": {
    "schema_version": {
      "const": "ariadne.deepseek_native_harness_emr4_bounded_worker_preset_contract.v1"
    },
    "operation_id": {
      "const": "deepseek-native-harness-provider-free-emr4-bounded-worker-preset-materialisation-recovery"
    },
    "planning_source": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "accepted_sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["required_service_recovery", "effective_tool_guard"],
      "properties": {
        "required_service_recovery": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "effective_tool_guard": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "predecessor_files": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/fileBinding"}
    },
    "predecessor_package_names": {
      "const": [
        "@deepseek-ai/dsh-base",
        "@deepseek-ai/dsh-headless",
        "@deepseek-ai/dsh-agent-presets",
        "@deepseek-ai/dsh-tools"
      ]
    },
    "packages": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/package"}
    },
    "preset": {
      "const": {
        "id": "emr4-bounded-worker",
        "install_relative_path": ".agent-presets/emr4-bounded-worker/agent.cordis.yml",
        "materialised_repository_path": "orchestration/continuity/deepseek-native-harness-provider-free-emr4-bounded-worker-preset-materialisation-recovery/materialised-home/.agent-presets/emr4-bounded-worker/agent.cordis.yml",
        "rows": [
          {"id": "tool-fs", "name": "@deepseek-ai/dsh-tool-fs"},
          {
            "id": "tool-fs-search",
            "name": "@deepseek-ai/dsh-tool-fs-search",
            "config": {"sampleOverCapGlobResults": false}
          }
        ],
        "selected_tools": ["edit", "glob", "read"],
        "unconditional_inherited_tools": ["edit", "glob", "grep", "read", "write"],
        "conditional_inherited_tools": ["read_image"]
      }
    },
    "required_zero_counts": {
      "const": [
        "agent_sessions",
        "broker_requests",
        "database_invocations",
        "docker_invocations",
        "model_requests",
        "native_harness_processes",
        "network_attempts",
        "node_processes",
        "occupied_workers",
        "provider_requests",
        "turns"
      ]
    },
    "implementation_bytes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["controller_sha256", "focused_test_sha256", "plan_sha256"],
      "properties": {
        "controller_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "focused_test_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "plan_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  },
  "$defs": {
    "fileBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "registry_shasum", "registry_integrity", "tar_sha256", "members"],
      "properties": {
        "name": {"enum": ["@deepseek-ai/dsh-tool-fs", "@deepseek-ai/dsh-tool-fs-search"]},
        "version": {"const": "0.1.0-rc.7"},
        "registry_shasum": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "registry_integrity": {"type": "string", "pattern": "^sha512-[A-Za-z0-9+/]+={0,2}$"},
        "tar_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "members": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "bytes", "sha256"],
            "properties": {
              "path": {"enum": ["package.json", "lib/index.js"]},
              "bytes": {"type": "integer", "minimum": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            }
          }
        }
      }
    }
  }
}
