{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/model-required-bureau-a3-b3-occupied-preflight-blocked.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "recorded_at",
    "result",
    "gate",
    "reason_code",
    "source_head",
    "source_review_head",
    "cost_ledger_path",
    "cost_ledger_sha256",
    "cost_reservation",
    "provider_call_count",
    "model_inference_called",
    "provider_prompt_transmitted",
    "credential_reconfiguration_attempted",
    "interactive_login_attempted",
    "fallback_attempted",
    "external_state_changed",
    "occupied_attempt_ledgers_opened",
    "occupied_cells_started",
    "runtime_residue_absent",
    "source_review_transport_nonzero",
    "authority_disposition",
    "required_intervention",
    "resume_authority",
    "resume_condition",
    "sensitive_exclusions"
  ],
  "properties": {
    "schema_version": {"const": "emr4.model_required_bureau_a3_b3.occupied_preflight_blocked.v1"},
    "recorded_at": {"type": "string", "format": "date-time"},
    "result": {"const": "model_required_bureau_a3_b3_adc_preflight_blocked"},
    "gate": {"const": "existing_bernie_impersonated_adc_noninteractive_refresh"},
    "reason_code": {"const": "impersonated_adc_refresh_failed"},
    "source_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "source_review_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "cost_ledger_path": {"const": "orchestration/continuity/model-required-bureau-a3-b3/occupied-rehearsal-cost-ledger.json"},
    "cost_ledger_sha256": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "cost_reservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "provider_calls_reserved", "provider_calls_consumed", "reserved_cost_usd", "lane_calls"],
      "properties": {
        "status": {"const": "open"},
        "provider_calls_reserved": {"const": 1},
        "provider_calls_consumed": {"const": 0},
        "reserved_cost_usd": {"const": 0.25},
        "lane_calls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["rayleen_a3", "davida_b3"],
          "properties": {
            "rayleen_a3": {"const": 1},
            "davida_b3": {"const": 0}
          }
        }
      }
    },
    "provider_call_count": {"const": 0},
    "model_inference_called": {"const": false},
    "provider_prompt_transmitted": {"const": false},
    "credential_reconfiguration_attempted": {"const": false},
    "interactive_login_attempted": {"const": false},
    "fallback_attempted": {"const": false},
    "external_state_changed": {"const": false},
    "occupied_attempt_ledgers_opened": {"const": 0},
    "occupied_cells_started": {"const": 0},
    "runtime_residue_absent": {"const": true},
    "source_review_transport_nonzero": {"const": true},
    "authority_disposition": {"const": "yuri_intervention_required"},
    "required_intervention": {"const": "restore_the_existing_bernie_keyless_impersonated_adc_outside_the_occupied_runtime_then_request_a_fresh_read_only_preflight"},
    "resume_authority": {"const": "same_tranche_same_reservation_only"},
    "resume_condition": {"const": "exact_blocked_evidence_and_cost_ledger_hash_match_after_adc_restoration_and_fresh_source_veto"},
    "sensitive_exclusions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["credential_or_token_recorded", "raw_authentication_response_recorded", "human_account_identifier_recorded", "api_key_information_recorded"],
      "properties": {
        "credential_or_token_recorded": {"const": false},
        "raw_authentication_response_recorded": {"const": false},
        "human_account_identifier_recorded": {"const": false},
        "api_key_information_recorded": {"const": false}
      }
    }
  }
}
