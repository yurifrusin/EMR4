{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.invalid/schemas/rayleen-a3-release.v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "lane", "case_id", "evidence_mode", "status", "candidate_provenance", "context_binding", "projection", "authority_ceiling"],
  "properties": {
    "schema_version": {"const": "emr4.rayleen.a3.release.v1"},
    "lane": {"const": "rayleen_a3"},
    "case_id": {"const": "rayleen-a3-synthetic-001"},
    "evidence_mode": {"const": "authored_synthetic_occupied_provider_advisory_rehearsal"},
    "status": {"const": "advisory_only"},
    "candidate_provenance": {"const": "untrusted_model"},
    "context_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["frame_id", "practice_id", "location_id", "context_revision", "evaluation_time", "evaluation_mode", "expires_at"],
      "properties": {
        "frame_id": {"type": "string", "format": "uuid"},
        "practice_id": {"type": "string", "format": "uuid"},
        "location_id": {"type": "string", "format": "uuid"},
        "context_revision": {"type": "integer", "minimum": 1},
        "evaluation_time": {"type": "string", "format": "date-time"},
        "evaluation_mode": {"const": "authored_synthetic_fixed_clock"},
        "expires_at": {"type": "string", "format": "date-time"}
      }
    },
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["intent", "projection_kind", "secondary_projection", "practitioner_id", "focus_appointment_id", "evidence_appointment_ids", "response_code"],
      "properties": {
        "intent": {"const": "filter"},
        "projection_kind": {"const": "practitioner_group"},
        "secondary_projection": {"const": "longest_wait"},
        "practitioner_id": {"type": "string", "format": "uuid"},
        "focus_appointment_id": {"type": "string", "format": "uuid"},
        "evidence_appointment_ids": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "format": "uuid"}},
        "response_code": {"const": "FILTERED_PRACTITIONER_LONGEST_WAIT"}
      }
    },
    "authority_ceiling": {"$ref": "#/$defs/deniedAuthority"}
  },
  "$defs": {
    "deniedAuthority": {
      "type": "object", "additionalProperties": false,
      "required": ["confirmation", "apply", "write", "database", "product_read", "command", "actuator", "success"],
      "properties": {
        "confirmation": {"const": false}, "apply": {"const": false}, "write": {"const": false},
        "database": {"const": false}, "product_read": {"const": false}, "command": {"const": false},
        "actuator": {"const": false}, "success": {"const": false}
      }
    }
  }
}
