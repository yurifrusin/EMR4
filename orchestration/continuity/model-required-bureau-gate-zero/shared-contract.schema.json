      ],
      "properties": {
        "shared_schema_primitives": {"const": true},
        "shared_proofreader_primitives": {"const": true},
        "cross_domain_context": {"const": false},
        "cross_domain_memory": {"const": false},
        "cross_domain_policy": {"const": false},
        "cross_domain_credentials": {"const": false},
        "cross_domain_commands": {"const": false}
      }
