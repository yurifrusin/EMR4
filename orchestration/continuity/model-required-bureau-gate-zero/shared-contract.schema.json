        "model_required_for_agentic_claim": {"const": true},
        "gate_zero_provider_call_authorized": {"const": false},
        "no_silent_provider_fallback": {"const": true},
        "no_silent_model_fallback": {"const": true},
        "no_equivalent_heuristic_fallback": {"const": true},
        "outage_receipt_code": {"const": "PROVIDER_REQUIRED_UNAVAILABLE"},
        "outage_release": {"const": "no_candidate_no_agentic_completion_claim"},
        "independent_deterministic_safety_continues_under_own_authority": {"const": true},
        "ordinary_manual_pms_workflows_continue_under_own_authority": {"const": true}
      }
    },
    "label_algebra": {"$ref": "#/$defs/label_algebra"},
    "source_registry": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/source"}
    },
    "sink_registry": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {"$ref": "#/$defs/sink"}
    },
    "envelope_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "labeled_context_frame",
        "typed_candidate",
        "typed_denial_receipt",
        "one_attempt_cell_manifest",
        "teardown_residue_receipt"
      ],
      "properties": {
        "labeled_context_frame": {"const": "labeled-context-frame.schema.json"},
        "typed_candidate": {"const": "typed-candidate.schema.json"},
        "typed_denial_receipt": {"const": "typed-denial-receipt.schema.json"},
        "one_attempt_cell_manifest": {"const": "one-attempt-cell-manifest.schema.json"},
        "teardown_residue_receipt": {"const": "teardown-residue-receipt.schema.json"}
      }
    },
    "cell_contract": {"$ref": "#/$defs/cell_contract"},
    "human_authority_policy": {"$ref": "#/$defs/human_authority_policy"},
    "api_spine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["read_context", "mutation", "event", "manifest", "context_frames_non_authoritative", "provider_candidate_non_authoritative"],
      "properties": {
        "read_context": {"const": "graphql_named_scoped_read_only"},
        "mutation": {"const": "rest_openapi_single_purpose_backend_owned_command"},
        "event": {"const": "committed_hint_requires_fresh_authorized_read"},
        "manifest": {"const": "declarative_input_runtime_enforced"},
        "context_frames_non_authoritative": {"const": true},
        "provider_candidate_non_authoritative": {"const": true}
      }
    },
    "future_command_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_gate", "transport", "owner", "required_fields", "backend_reauthorization_before_write", "backend_revalidation_before_write", "model_cell_broker_or_proofreader_may_construct"],
      "properties": {
        "current_gate": {"const": "closed"},
        "transport": {"const": "rest_openapi_single_purpose"},
        "owner": {"const": "trusted_backend_code"},
        "required_fields": {"const": ["command_type", "practice_scope", "actor_id", "correlation_id", "idempotency_key", "target_id", "expected_revision_or_etag", "context_hash", "freshness_id", "expires_at", "warnings", "blocks", "required_risk_tier", "confirmation_or_dual_review_evidence", "audit_contract", "readback_contract"]},
        "backend_reauthorization_before_write": {"const": true},
        "backend_revalidation_before_write": {"const": true},
        "model_cell_broker_or_proofreader_may_construct": {"const": false}
      }
    },
    "provider_invocation_boundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["current_gate", "transport", "required_bindings", "graphql_invocation", "raw_prompt_graphql_field", "raw_response_graphql_field", "raw_prompt_persistence", "raw_response_persistence"],
      "properties": {
        "current_gate": {"const": "closed"},
        "transport": {"const": "rest_access_ai_command_only"},
        "required_bindings": {"const": ["capability", "method", "actor_id", "practice_scope", "entitlement_decision", "context_hash", "data_class", "provider", "model", "region", "cost_budget", "correlation_id", "audit_policy"]},
        "graphql_invocation": {"const": false},
        "raw_prompt_graphql_field": {"const": false},
        "raw_response_graphql_field": {"const": false},
        "raw_prompt_persistence": {"const": false},
        "raw_response_persistence": {"const": false}
      }
    },
    "evidence_classes": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8,
      "items": {"$ref": "#/$defs/evidence_class"}
    },
    "blocked_boundaries": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "uniqueItems": true,
      "items": {
        "enum": [
          "provider_or_model_product_runtime",
          "external_product_data_transmission",
          "patient_or_clinical_data",
          "live_product_read",
          "command_or_write",
          "actuator_shell_sql_cloud_or_iam",
          "migration_or_external_update_activation",
          "deployment",
          "production",
          "release",
          "pages_rebuild",
          "protected_ref_movement",
          "protected_evidence"
        ]
      }
