{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.dev/schemas/model-required-bureau/teardown-residue-receipt.v1.json",
  "title": "EMR4 one-attempt cell teardown and residue receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "attempt_id",
    "cell_generation_id",
    "status",
    "closed_at",
    "broker_token_revoked",
    "input_channel_closed",
    "output_channel_closed",
    "live_process_count",
    "live_listener_count",
    "live_mount_count",
    "live_credential_count",
    "owned_ephemeral_artifact_count",
    "provider_call_count",
    "candidate_output_sha256",
    "raw_provider_bytes_persisted",
    "provider_response_persisted",
    "product_access_occurred",
    "command_attempted"
  ],
  "properties": {
    "schema_version": {"const": "emr4.bureau.teardown_residue_receipt.v1"},
    "attempt_id": {"type": "string", "pattern": "^attempt_[a-z0-9_-]{8,64}$"},
    "cell_generation_id": {"type": "string", "pattern": "^cell_[a-z0-9_-]{8,64}$"},
    "status": {"const": "closed_zero_residue"},
    "closed_at": {"type": "string", "format": "date-time"},
    "broker_token_revoked": {"const": true},
    "input_channel_closed": {"const": true},
    "output_channel_closed": {"const": true},
    "live_process_count": {"const": 0},
    "live_listener_count": {"const": 0},
    "live_mount_count": {"const": 0},
    "live_credential_count": {"const": 0},
    "owned_ephemeral_artifact_count": {"const": 0},
    "provider_call_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "candidate_output_sha256": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "raw_provider_bytes_persisted": {"const": false},
    "provider_response_persisted": {"const": false},
    "product_access_occurred": {"const": false},
    "command_attempted": {"const": false}
  }
}
