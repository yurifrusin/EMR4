{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://emr4.dev/schemas/model-required-bureau/labeled-context-frame.v1.json",
  "title": "EMR4 labelled Bureau context frame",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "frame_id",
    "domain",
    "practice_scope",
    "authorization_decision_id",
    "issued_at",
    "observed_at",
    "expires_at",
    "minimization_profile",
    "content_hash",
    "fields"
  ],
  "properties": {
    "schema_version": {"const": "emr4.bureau.labeled_context_frame.v1"},
    "frame_id": {"type": "string", "pattern": "^ctx_[a-z0-9_-]{8,64}$"},
    "domain": {"$ref": "#/$defs/domain"},
    "practice_scope": {"type": "string", "pattern": "^practice_[a-z0-9_-]{4,64}$"},
    "authorization_decision_id": {"type": "string", "pattern": "^authz_[a-z0-9_-]{8,64}$"},
    "issued_at": {"type": "string", "format": "date-time"},
    "observed_at": {"type": "string", "format": "date-time"},
    "expires_at": {"type": "string", "format": "date-time"},
    "minimization_profile": {"type": "string", "pattern": "^[a-z][a-z0-9_.-]{2,80}$"},
    "content_hash": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
    "fields": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]{0,63}$"},
      "additionalProperties": {"$ref": "#/$defs/labeled_value"}
    }
  },
  "$defs": {
    "domain": {"enum": ["bernie", "rayleen", "davida", "controlled_recovery_update"]},
    "json_scalar": {"type": ["string", "number", "integer", "boolean", "null"]},
    "labeled_value": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "label"],
      "properties": {
        "value": {"$ref": "#/$defs/json_scalar"},
        "label": {"$ref": "#/$defs/label"}
      }
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_ids", "transformation_trace", "integrity_principals", "confidentiality_readers", "observed_at", "expires_at", "freshness_state", "authority_ceiling"],
      "properties": {
        "source_ids": {"type": "array", "minItems": 1, "maxItems": 16, "uniqueItems": true, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,100}$"}},
        "transformation_trace": {"type": "array", "minItems": 1, "maxItems": 16, "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.:-]{2,100}$"}},
        "integrity_principals": {"type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true, "items": {"enum": ["backend_truth", "event_hint_only", "authored_synthetic"]}},
        "confidentiality_readers": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"enum": ["admitted_provider_request", "deterministic_proofreader", "authorized_surface", "authorized_operator", "backend_authority_service", "single_purpose_command_handler", "deterministic_readback"]}},
        "observed_at": {"type": "string", "format": "date-time"},
        "expires_at": {"type": "string", "format": "date-time"},
        "freshness_state": {"enum": ["fresh", "stale"]},
        "authority_ceiling": {"const": "data_only"}
      }
    }
  }
}
